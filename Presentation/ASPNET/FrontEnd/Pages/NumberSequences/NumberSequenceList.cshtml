@page "/NumberSequences/NumberSequenceList"
@{
    ViewData["Title"] = "Number sequences";
}

<div id="app" v-cloak>
    <div class="row mb-3">
        <div class="col-12">
            <h1 class="h4 mb-1">Number sequences</h1>
            <p class="text-muted small mb-0">Document numbering prefixes used by the platform.</p>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="grid-container">
                <div ref="mainGridRef"></div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/NumberSequences/NumberSequenceList.cshtml.js"></script>
}
