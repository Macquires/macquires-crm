                        </div>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="takeOverApprovalModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
                <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
                    <div class="modal-content border-0 shadow">
                        <div class="modal-header border-0">
                            <h5 class="modal-title fw-bold text-success">
                                <i class="fas fa-user-shield me-2"></i>{{ secureApprovalModalTitle }} — {{ takeOverApproval.number }}
                            </h5>
                            <button type="button" class="btn-close" :aria-label="t('telecom.takeOverModal.close')" @@click="closeTakeOverApproval"></button>
                        </div>
                        <div class="modal-body pt-0">
                            <div v-if="takeOverApproval.busy" class="text-center py-4 text-muted">
                                <span class="spinner-border text-success"></span>
                            </div>
                            <template v-else-if="takeOverApproval.detail">
                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <p class="small text-muted mb-1">{{ t('telecom.takeOverModal.line') }}</p>
                                        <p class="fw-semibold font-monospace mb-0" dir="ltr">{{ takeOverApproval.detail.msisdn || t('telecom.ops.dash') }}</p>
                                    </div>
                                    <div class="col-md-6">
                                        <p class="small text-muted mb-1">{{ t('telecom.takeOverModal.status') }}</p>
                                        <p class="mb-0">{{ takeOverApproval.detail.statusLabelAr }}</p>
                                    </div>
                                    <div class="col-md-6">
                                        <p class="small text-muted mb-1">{{ t('telecom.takeOverModal.currentOwner') }}</p>
                                        <p class="mb-0">{{ takeOverApproval.detail.currentOwnerName || t('telecom.ops.dash') }}</p>
                                    </div>
                                    <div class="col-md-6" v-if="takeOverApproval.kind === 2">
                                        <p class="small text-muted mb-1">{{ t('telecom.takeOverModal.newOwner') }}</p>
                                        <p class="mb-0 fw-semibold text-success">{{ takeOverApproval.detail.newOwnerName || t('telecom.ops.dash') }}</p>
                                    </div>
                                    <template v-if="takeOverApproval.kind === 7">
                                        <div class="col-md-6" v-if="takeOverApproval.detail.terminationType">
                                            <p class="small text-muted mb-1">{{ t('telecom.terminationModal.type') }}</p>
                                            <p class="mb-0">{{ takeOverApproval.detail.terminationType }}</p>
                                        </div>
                                        <div class="col-md-6" v-if="takeOverApproval.detail.terminationReason">
                                            <p class="small text-muted mb-1">{{ t('telecom.terminationModal.reason') }}</p>
                                            <p class="mb-0">{{ takeOverApproval.detail.terminationReason }}</p>
                                        </div>
                                        <div class="col-md-6" v-if="takeOverApproval.detail.finalBillAmount">
                                            <p class="small text-muted mb-1">{{ t('telecom.terminationModal.finalBill') }}</p>
                                            <p class="mb-0">{{ takeOverApproval.detail.finalBillAmount }}</p>
                                        </div>
                                    </template>
                                    <template v-if="takeOverApproval.kind === 5">
                                        <div class="col-md-6" v-if="takeOverApproval.detail.priorMsisdn">
                                            <p class="small text-muted mb-1">{{ t('telecom.changeNumberModal.priorMsisdn') }}</p>
                                            <p class="mb-0 font-monospace" dir="ltr">{{ takeOverApproval.detail.priorMsisdn }}</p>
                                        </div>
                                        <div class="col-md-6" v-if="takeOverApproval.detail.targetMsisdn">
                                            <p class="small text-muted mb-1">{{ t('telecom.changeNumberModal.targetMsisdn') }}</p>
                                            <p class="mb-0 font-monospace text-success" dir="ltr">{{ takeOverApproval.detail.targetMsisdn }}</p>
                                        </div>
                                        <div class="col-md-6" v-if="takeOverApproval.detail.numberChangeReason">
                                            <p class="small text-muted mb-1">{{ t('telecom.changeNumber.changeReason') }}</p>
                                            <p class="mb-0">{{ takeOverApproval.detail.numberChangeReason }}</p>
                                        </div>
                                        <div class="col-md-6" v-if="takeOverApproval.detail.premiumFeeAmount">
                                            <p class="small text-muted mb-1">{{ t('telecom.changeNumberModal.premiumFee') }}</p>
                                            <p class="mb-0">{{ takeOverApproval.detail.premiumFeeAmount }}</p>
                                        </div>
                                    </template>
                                    <template v-if="takeOverApproval.kind === 3">
                                        <div class="col-md-6" v-if="takeOverApproval.detail.replacementReason">
                                            <p class="small text-muted mb-1">{{ t('telecom.simSwap.replacementReason') }}</p>
                                            <p class="mb-0">{{ takeOverApproval.detail.replacementReason }}</p>
                                        </div>
                                        <div class="col-md-6" v-if="takeOverApproval.detail.priorSimIccid">
                                            <p class="small text-muted mb-1">{{ t('telecom.simSwapModal.priorIccid') }}</p>
                                            <p class="mb-0 font-monospace" dir="ltr">{{ takeOverApproval.detail.priorSimIccid }}</p>
                                        </div>
                                        <div class="col-md-6" v-if="takeOverApproval.detail.newSimIccid">
                                            <p class="small text-muted mb-1">{{ t('telecom.simSwapModal.newIccid') }}</p>
                                            <p class="mb-0 font-monospace text-success" dir="ltr">{{ takeOverApproval.detail.newSimIccid }}</p>
                                        </div>
                                    </template>
                                    <div class="col-md-6" v-if="takeOverApproval.kind === 2 && takeOverApproval.detail.transferReason">
                                        <p class="small text-muted mb-1">{{ t('telecom.takeOver.transferReason') }}</p>
                                        <p class="mb-0">{{ takeOverApproval.detail.transferReason }}</p>
                                    </div>
                                    <div class="col-md-6" v-if="takeOverApproval.detail.depositTransferPolicyLabelAr">
                                        <p class="small text-muted mb-1">{{ t('telecom.takeOver.depositPolicy') }}</p>
                                        <p class="mb-0">{{ takeOverApproval.detail.depositTransferPolicyLabelAr }}</p>
                                    </div>
                                </div>
                                <div class="border rounded p-2 mb-3 bg-light" style="min-height: 220px;">
                                    <p class="small fw-semibold mb-2">{{ t('telecom.takeOverModal.document') }}</p>
                                    <iframe v-if="takeOverApproval.documentUrl" :src="takeOverApproval.documentUrl"
                                            class="w-100 rounded border-0" style="min-height: 200px;" :title="t('telecom.takeOverModal.document')"></iframe>
                                    <p v-else class="small text-muted mb-0 py-4 text-center">{{ t('telecom.takeOverModal.noDocument') }}</p>
                                </div>
                                <p v-if="takeOverApproval.detail.notes" class="small text-muted">{{ takeOverApproval.detail.notes }}</p>
                            </template>
                        </div>
                        <div class="modal-footer border-0">
                            <button type="button" class="btn btn-outline-secondary" @@click="closeTakeOverApproval" :disabled="takeOverApproval.approveBusy">{{ t('telecom.takeOverModal.cancel') }}</button>
                            <button type="button" class="btn btn-success" @@click="approveSecureOpOnNetwork"
                                    :disabled="takeOverApproval.approveBusy || !takeOverApproval.operationId || !canApproveSecureOp">
                                <span v-if="takeOverApproval.approveBusy" class="spinner-border spinner-border-sm me-1"></span>
                                {{ secureApprovalApproveLabel }}
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <nav class="d-flex flex-wrap gap-2 pb-4" aria-label="Shortcuts">
                <a v-if="hubPermissions.canSeeBillingLog" class="btn btn-outline-secondary" href="/Telecom/BillingIntegration">{{ t('telecom.shortcuts.billing') }}</a>
                <a v-if="hubPermissions.showRetailShortcuts" class="btn btn-outline-secondary" href="/SalesOrders/SalesOrderList">{{ t('telecom.shortcuts.sales') }}</a>
                <a class="btn btn-outline-secondary" href="/ProgramManagers/ProgramManagerList">{{ t('telecom.shortcuts.kanban') }}</a>
                <a class="btn btn-outline-secondary" href="/Customers/CustomerList">{{ t('telecom.shortcuts.customers') }}</a>
            </nav>
        </div>
    </div>
</div>

@section styles {
    <style>
        .telecom-hub-root { max-width: 1400px; margin-inline: auto; }
        .telecom-hero { background: linear-gradient(180deg, var(--sys-card-bg) 0%, var(--sys-bg) 100%); }
        .telecom-search-group .form-control:focus { box-shadow: none; border-color: var(--sys-border); }
        .telecom-search-group:focus-within { box-shadow: 0 0 0 0.2rem var(--sys-brand-red-ring); border-radius: var(--sys-radius); }
        .big-tile { border: none; border-radius: var(--sys-radius); min-height: 118px; transition: transform 0.15s ease, box-shadow 0.15s ease; color: var(--sys-card-bg); }
        .big-tile:hover { transform: translateY(-2px); box-shadow: var(--sys-shadow-card-hover) !important; }
        .big-tile:focus-visible { outline: 3px solid color-mix(in srgb, var(--sys-card-bg) 85%, transparent); outline-offset: 3px; }
        .tile-icon { font-size: 1.35rem; opacity: 0.95; }
        .map-mock { overflow: hidden; }
        .telecom-kpi-value { font-size: clamp(1.5rem, 4vw, 2.25rem); line-height: 1.2; }
        .telecom-step { border: 1px solid var(--sys-border); }
        .telecom-step-active { background: var(--sys-brand-red); color: var(--sys-card-bg); border-color: var(--sys-brand-red); font-weight: 600; }
        .telecom-step-muted { background: var(--sys-bg); color: var(--sys-text-muted); }
        .telecom-table thead th { white-space: nowrap; font-weight: 600; font-size: 0.8125rem; }
        .tile-refund { background: linear-gradient(145deg, #0f766e 0%, #059669 100%); }
    </style>
}

@section scripts {
    <script>
        window.__TELECOM_I18N_URLS = {
            ar: '@Url.Content("~/locales/telecom.ar.json")',
            en: '@Url.Content("~/locales/telecom.en.json")'
        };
    </script>
    <script src="~/lib/vue-i18n/vue-i18n.global.prod.js"></script>
    <script src="~/FrontEnd/Pages/Telecom/TelecomHub.cshtml.js" asp-append-version="true"></script>
}
