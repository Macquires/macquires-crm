                                {{ t('telecom.wizard.msisdnPicker.truncated', { shown: activateMsisdnPoolDisplayLimit, total: filteredActivateMsisdnPool.length }) }}
                            </p>
                            <p v-else-if="activateMsisdnPoolDisplay.length" class="small text-muted mt-2 mb-0">
                                {{ t('telecom.wizard.msisdnPicker.total') }}: <strong>{{ filteredActivateMsisdnPool.length }}</strong>
                            </p>
                        </div>
                        <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn btn-outline-secondary btn-sm" @@click="loadActivateMsisdnPool" :disabled="wizard.activateMsisdnPoolBusy"
                                    :aria-label="t('telecom.wizard.msisdnPicker.refresh')">
                                <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>{{ t('telecom.wizard.msisdnPicker.refresh') }}
                            </button>
                            <button type="button" class="btn btn-secondary btn-sm" @@click="closeActivateMsisdnModal"
                                    :aria-label="t('telecom.wizard.msisdnPicker.closeAria')">{{ t('telecom.wizard.msisdnPicker.closeBtn') }}</button>
                        </div>
                    </div>
                </div>
            </div>
            <div v-if="hubRouteReady && wizard.activateMsisdnModalOpen" class="modal-backdrop fade show"></div>
            </teleport>

            <nav class="d-flex flex-wrap gap-2 pb-4" aria-label="Shortcuts">
                <a v-if="hubPermissions.canSeeBillingLog" class="btn btn-outline-secondary" href="/Telecom/BillingIntegration">{{ t('telecom.shortcuts.billing') }}</a>
                <a v-if="hubPermissions.showRetailShortcuts" class="btn btn-outline-secondary" href="/SalesOrders/SalesOrderList">{{ t('telecom.shortcuts.sales') }}</a>
                <a class="btn btn-outline-secondary" href="/ProgramManagers/ProgramManagerList">{{ t('telecom.shortcuts.kanban') }}</a>
                <a class="btn btn-outline-secondary" href="/Customers/CustomerList">{{ t('telecom.shortcuts.customers') }}</a>
            </nav>
        </div>
@await Html.PartialAsync("~/FrontEnd/Pages/Shared/AdminTemplate/_PortalPageShellEnd.cshtml")

