@page
@inject IHtmlLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["Page_TelecomHubTitle"].Value;
}

@{ ViewData["PortalPageVcloak"] = true; ViewData["PortalPageInner"] = false; ViewData["PortalPageAttrs"] = ":dir=\"contentDir\" :lang=\"contentLang\""; }
@await Html.PartialAsync("~/FrontEnd/Pages/Shared/AdminTemplate/_PortalPageShell.cshtml")

        <div class="container-fluid py-3 px-3 px-lg-4 telecom-hub-root">

            <div v-if="loadError" class="alert alert-warning d-flex align-items-center gap-2 mb-3" role="alert">
                <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
                <span>{{ loadError }}</span>
                <button type="button" class="btn btn-sm btn-outline-dark ms-auto" @@click="refreshAll">{{ t('telecom.loadError.retry') }}</button>
            </div>

            <header class="telecom-hero telecom-premium-hero card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="row g-3 align-items-start">
                        <div class="col-12 col-xl-7">
                            <p class="small text-muted mb-1">{{ t('telecom.hero.badge') }}</p>
                            <h1 class="h4 mb-2 fw-semibold">
                                {{ t('telecom.hero.title') }}
                                <span class="text-muted fw-normal fs-6">OSS/BSS</span>
                            </h1>
                            <p class="text-muted mb-0 small lh-lg">{{ t('telecom.hero.subtitle') }}</p>
                        </div>
                        <div class="col-12 col-xl-5">
                            <label class="form-label small text-muted mb-1" for="telecomSearchInput">{{ t('telecom.search.label') }}</label>
                            <div class="input-group input-group-lg telecom-search-group">
                                <span class="input-group-text bg-white"><i class="fas fa-search text-muted" aria-hidden="true"></i></span>
                                <input id="telecomSearchInput" type="search" class="form-control" v-model="searchTerm"
                                       :placeholder="t('telecom.search.placeholder')" autocomplete="off"
                                       @@keyup.enter="runSearch" aria-describedby="telecomSearchHint" />
                                <button class="btn btn-telecom-primary px-3" type="button" @@click="runSearch" :disabled="searchBusy">
                                    <span v-if="searchBusy" class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span v-else>{{ t('telecom.search.search') }}</span>
                                </button>
                            </div>
                            <p id="telecomSearchHint" class="form-text small text-muted mb-0 mt-1">
                                {{ t('telecom.search.hint') }}
                                <a :href="searchTerm.trim().length >= 2 ? '/Telecom/UnifiedSearch?q=' + encodeURIComponent(searchTerm.trim()) : '/Telecom/UnifiedSearch'" class="link-danger">{{ t('telecom.search.unifiedSearchLink') }}</a>
                            </p>
                        </div>
                    </div>
                </div>
            </header>

            <section class="mb-4 telecom-hub-tiles-section" :aria-label="t('telecom.quickPathsAria')">
                <div class="row g-3 telecom-hub-tiles-row">
                    <div class="col-6 col-sm-4 col-md-3 col-lg-3 col-xl-2" v-if="hubPermissions.canHubFrontline">
                        <button type="button" class="btn w-100 py-3 text-white big-tile tile-new-customer shadow-sm"
                                :class="{ 'opacity-50 pe-none': !hubPermissions.canOpenSubscriberRegistry }"
                                :disabled="!hubPermissions.canOpenSubscriberRegistry"
                                @@click="openCustomerWizard" :aria-label="t('telecom.tiles.newCustomer.aria')">
                            <span class="tile-icon d-block mb-1" aria-hidden="true"><i class="fas fa-user-plus"></i></span>
                            <span class="fs-6 fw-semibold d-block">{{ t('telecom.tiles.newCustomer.title') }}</span>
                            <small class="opacity-75">{{ t('telecom.tiles.newCustomer.sub') }}</small>
                        </button>
                    </div>
                    <div class="col-6 col-sm-4 col-md-3 col-lg-3 col-xl-2" v-if="hubPermissions.canHubFrontline">
                        <button type="button" class="btn w-100 py-3 text-white big-tile tile-activate shadow-sm"
                                @@click="openWizard('activate')" data-testid="hub-wizard-tile-activate" :aria-label="t('telecom.tiles.activate.aria')">
                            <span class="tile-icon d-block mb-1" aria-hidden="true"><i class="fas fa-sim-card"></i></span>
                            <span class="fs-6 fw-semibold d-block">{{ t('telecom.tiles.activate.title') }}</span>
                            <small class="opacity-75">{{ t('telecom.tiles.activate.sub') }}</small>
                        </button>
                    </div>
                    <div class="col-6 col-sm-4 col-md-3 col-lg-3 col-xl-2" v-if="hubPermissions.canHubFrontline">
                        <button type="button" class="btn w-100 py-3 text-white big-tile tile-migrate shadow-sm"
                                @@click="openWizard('migrate')" data-testid="hub-wizard-tile-migrate" :aria-label="t('telecom.tiles.migrate.aria')">
                            <span class="tile-icon d-block mb-1" aria-hidden="true"><i class="fas fa-exchange-alt"></i></span>
                            <span class="fs-6 fw-semibold d-block">{{ t('telecom.tiles.migrate.title') }}</span>
                            <small class="opacity-75">{{ t('telecom.tiles.migrate.sub') }}</small>
                        </button>
                    </div>
                    <div class="col-6 col-sm-4 col-md-3 col-lg-3 col-xl-2" v-if="hubPermissions.canHubBackOffice">
                        <button type="button" class="btn w-100 py-3 text-white big-tile tile-changeGsm shadow-sm"
                                @@click="openWizard('changeGsm')" data-testid="hub-wizard-tile-changeGsm" :aria-label="t('telecom.tiles.changeGsm.aria')">
                            <span class="tile-icon d-block mb-1" aria-hidden="true"><i class="fas fa-random"></i></span>
                            <span class="fs-6 fw-semibold d-block">{{ t('telecom.tiles.changeGsm.title') }}</span>
                            <small class="opacity-75">{{ t('telecom.tiles.changeGsm.sub') }}</small>
                        </button>
                    </div>
                    <div class="col-6 col-sm-4 col-md-3 col-lg-3 col-xl-2" v-if="hubPermissions.canHubBackOffice">
                        <button type="button" class="btn w-100 py-3 text-white big-tile tile-takeover shadow-sm"
                                @@click="openWizard('takeover')" data-testid="hub-wizard-tile-takeover" :aria-label="t('telecom.tiles.takeover.aria')">
                            <span class="tile-icon d-block mb-1" aria-hidden="true"><i class="fas fa-user-friends"></i></span>
                            <span class="fs-6 fw-semibold d-block">{{ t('telecom.tiles.takeover.title') }}</span>
                            <small class="opacity-75">{{ t('telecom.tiles.takeover.sub') }}</small>
                        </button>
                    </div>
                    <div class="col-6 col-sm-4 col-md-3 col-lg-3 col-xl-2" v-if="hubPermissions.canHubFrontline">
                        <button type="button" class="btn w-100 py-3 text-white big-tile tile-simswap shadow-sm"
                                @@click="openWizard('simswap')" data-testid="hub-wizard-tile-simswap" :aria-label="t('telecom.tiles.simswap.aria')">
                            <span class="tile-icon d-block mb-1" aria-hidden="true"><i class="fas fa-random"></i></span>
                            <span class="fs-6 fw-semibold d-block">{{ t('telecom.tiles.simswap.title') }}</span>
                            <small class="opacity-75">{{ t('telecom.tiles.simswap.sub') }}</small>
                        </button>
                    </div>
                    <div class="col-6 col-sm-4 col-md-3 col-lg-3 col-xl-2" v-if="hubPermissions.canHubFrontline">
                        <button type="button" class="btn w-100 py-3 text-white big-tile tile-changenumber shadow-sm"
                                @@click="openWizard('changeNumber')" data-testid="hub-wizard-tile-changeNumber" :aria-label="t('telecom.tiles.changeNumber.aria')">
                            <span class="tile-icon d-block mb-1" aria-hidden="true"><i class="fas fa-phone-alt"></i></span>
                            <span class="fs-6 fw-semibold d-block">{{ t('telecom.tiles.changeNumber.title') }}</span>
                            <small class="opacity-75">{{ t('telecom.tiles.changeNumber.sub') }}</small>
                        </button>
                    </div>
                    <div class="col-6 col-sm-4 col-md-3 col-lg-3 col-xl-2" v-if="hubPermissions.canHubBackOffice">
                        <button type="button" class="btn w-100 py-3 text-white big-tile tile-termination shadow-sm"
                                @@click="openWizard('termination')" data-testid="hub-wizard-tile-termination" :aria-label="t('telecom.tiles.termination.aria')">
                            <span class="tile-icon d-block mb-1" aria-hidden="true"><i class="fas fa-phone-slash"></i></span>
                            <span class="fs-6 fw-semibold d-block">{{ t('telecom.tiles.termination.title') }}</span>
                            <small class="opacity-75">{{ t('telecom.tiles.termination.sub') }}</small>
                        </button>
                    </div>
                    <div class="col-6 col-sm-4 col-md-3 col-lg-3 col-xl-2" v-if="hubPermissions.canHubBackOffice">
                        <button type="button" class="btn w-100 py-3 text-white big-tile tile-suspension shadow-sm"
                                @@click="openWizard('suspension')" data-testid="hub-wizard-tile-suspension" :aria-label="t('telecom.tiles.suspension.aria')">
                            <span class="tile-icon d-block mb-1" aria-hidden="true"><i class="fas fa-ban"></i></span>
                            <span class="fs-6 fw-semibold d-block">{{ t('telecom.tiles.suspension.title') }}</span>
                            <small class="opacity-75">{{ t('telecom.tiles.suspension.sub') }}</small>
                        </button>
                    </div>
                    <div class="col-6 col-sm-4 col-md-3 col-lg-3 col-xl-2" v-if="hubPermissions.canHubSupervisor">
                        <button type="button" class="btn w-100 py-3 text-white big-tile tile-reconnect shadow-sm"
                                @@click="openWizard('reconnect')" data-testid="hub-wizard-tile-reconnect" :aria-label="t('telecom.tiles.reconnect.aria')">
                            <span class="tile-icon d-block mb-1" aria-hidden="true"><i class="fas fa-signal"></i></span>
                            <span class="fs-6 fw-semibold d-block">{{ t('telecom.tiles.reconnect.title') }}</span>
                            <small class="opacity-75">{{ t('telecom.tiles.reconnect.sub') }}</small>
                        </button>
                    </div>
                    <div class="col-6 col-sm-4 col-md-3 col-lg-3 col-xl-2" v-if="hubPermissions.canHubSupervisor">
                        <button type="button" class="btn w-100 py-3 text-white big-tile tile-refund shadow-sm"
                                @@click="openWizard('refund')" data-testid="hub-wizard-tile-refund" :aria-label="t('telecom.tiles.refund.aria')">
                            <span class="tile-icon d-block mb-1" aria-hidden="true"><i class="fas fa-hand-holding-usd"></i></span>
                            <span class="fs-6 fw-semibold d-block">{{ t('telecom.tiles.refund.title') }}</span>
                            <small class="opacity-75">{{ t('telecom.tiles.refund.sub') }}</small>
                        </button>
                    </div>
                    <div class="col-6 col-sm-4 col-md-3 col-lg-3 col-xl-2" v-if="hubPermissions.canHubBackOffice">
                        <button type="button" class="btn w-100 py-3 text-white big-tile tile-bad-debt shadow-sm"
                                @@click="openWizard('badDebt')" data-testid="hub-wizard-tile-badDebt" :aria-label="t('telecom.tiles.badDebt.aria')">
                            <span class="tile-icon d-block mb-1" aria-hidden="true"><i class="fas fa-coins"></i></span>
                            <span class="fs-6 fw-semibold d-block">{{ t('telecom.tiles.badDebt.title') }}</span>
                            <small class="opacity-75">{{ t('telecom.tiles.badDebt.sub') }}</small>
                        </button>
                    </div>
                    <div class="col-6 col-sm-4 col-md-3 col-lg-3 col-xl-2" v-if="hubPermissions.canHubSupervisor">
                        <button type="button" class="btn w-100 py-3 text-white big-tile tile-device-sale shadow-sm"
                                @@click="openWizard('deviceSale')" data-testid="hub-wizard-tile-deviceSale" :aria-label="t('telecom.tiles.deviceSale.aria')">
                            <span class="tile-icon d-block mb-1" aria-hidden="true"><i class="fas fa-mobile-alt"></i></span>
                            <span class="fs-6 fw-semibold d-block">{{ t('telecom.tiles.deviceSale.title') }}</span>
                            <small class="opacity-75">{{ t('telecom.tiles.deviceSale.sub') }}</small>
                        </button>
                    </div>
                    <div class="col-6 col-sm-4 col-md-3 col-lg-3 col-xl-2" v-if="hubPermissions.canHubSupervisor">
                        <button type="button" class="btn w-100 py-3 text-white big-tile tile-package shadow-sm"
                                @@click="openWizard('addpackage')" data-testid="hub-wizard-tile-addpackage" :aria-label="t('telecom.tiles.addpackage.aria')">
                            <span class="tile-icon d-block mb-1" aria-hidden="true"><i class="fas fa-box-open"></i></span>
                            <span class="fs-6 fw-semibold d-block">{{ t('telecom.tiles.addpackage.title') }}</span>
                            <small class="opacity-75">{{ t('telecom.tiles.addpackage.sub') }}</small>
                        </button>
                    </div>
                    <div class="col-6 col-sm-4 col-md-3 col-lg-3 col-xl-2" v-if="hubPermissions.canHubFrontline">
                        <button type="button" class="btn w-100 py-3 text-white big-tile tile-recharge shadow-sm"
                                :class="{ 'opacity-50 pe-none': !hubPermissions.canRecharge }"
                                :disabled="!hubPermissions.canRecharge || rechargeBusy"
                                @@click="openHubRecharge" :aria-label="t('telecom.tiles.recharge.aria')">
                            <span class="tile-icon d-block mb-1" aria-hidden="true"><i class="fas fa-bolt"></i></span>
                            <span class="fs-6 fw-semibold d-block">{{ t('telecom.tiles.recharge.title') }}</span>
                            <small class="opacity-75">{{ t('telecom.tiles.recharge.sub') }}</small>
                        </button>
                    </div>
                    <div class="col-6 col-sm-4 col-md-3 col-lg-3 col-xl-2" v-if="hubPermissions.canHubSupervisor">
                        <button type="button" class="btn w-100 py-3 text-white big-tile tile-support shadow-sm"
                                @@click="openWizard('support')" data-testid="hub-wizard-tile-support" :aria-label="t('telecom.tiles.support.aria')">
                            <span class="tile-icon d-block mb-1" aria-hidden="true"><i class="fas fa-headset"></i></span>
                            <span class="fs-6 fw-semibold d-block">{{ t('telecom.tiles.support.title') }}</span>
                            <small class="opacity-75">{{ t('telecom.tiles.support.sub') }}</small>
                        </button>
                    </div>
                </div>
            </section>

            <section v-if="hubRouteReady && customerWizard.visible" id="telecomCustomerWizardPanel" class="mb-4 telecom-hub-wizard-anchor" aria-labelledby="customerWizardHeading">
                <div class="card border-success shadow-sm telecom-wizard-card telecom-customer-wizard-card">
                    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2 py-3">
                        <h2 id="customerWizardHeading" class="h6 mb-0 fw-semibold text-white">{{ t('telecom.customerWizard.heading') }}</h2>
                        <button type="button" class="btn-close btn-close-white" :aria-label="t('telecom.wizard.closeAria')" @@click="closeCustomerWizard"></button>
                    </div>
                    <div class="card-body">
                        <div class="telecom-stepper d-flex gap-2 mb-4 flex-wrap" role="list">
                            <span v-for="s in 3" :key="'cw'+s" class="telecom-step flex-grow-1 text-center small py-2 rounded"
                                  :class="customerWizard.step >= s ? 'telecom-step-active-customer' : 'telecom-step-muted'"
                                  role="listitem">
                                {{ s === 1 ? t('telecom.customerWizard.steps.verify') : s === 2 ? t('telecom.customerWizard.steps.data') : t('telecom.customerWizard.steps.done') }}
                            </span>
                        </div>

                        <div v-show="customerWizard.step === 1" class="telecom-wizard-step">
                            <p class="small text-muted mb-2">{{ t('telecom.customerWizard.step1Help') }}</p>
                            <div class="alert alert-light border small py-2 mb-3" role="note">
                                <i class="fas fa-info-circle text-success me-1" aria-hidden="true"></i>
                                <span class="d-block">{{ t('telecom.customerWizard.identitySearchHint1') }}</span>
                                <span class="d-block mt-1">{{ t('telecom.customerWizard.identitySearchHint2') }}</span>
                            </div>
                            <div class="row g-2 align-items-end">
                                <div class="col-12 col-sm-6 col-md-4">
                                    <label class="form-label small">{{ t('telecom.customerWizard.identitySearch') }}</label>
                                    <input type="text" class="form-control form-control-sm" v-model="customerWizard.searchNationalId" maxlength="32" autocomplete="off" :placeholder="t('telecom.customerWizard.identitySearchPh')" @@keyup.enter="runCustomerWizardSearch" />
                                </div>
                                <div class="col-12 col-sm-6 col-md-4">
                                    <label class="form-label small">{{ t('telecom.customerWizard.phone') }}</label>
                                    <input type="text" class="form-control form-control-sm" v-model="customerWizard.searchPhone" maxlength="16" autocomplete="off" dir="ltr" :placeholder="t('telecom.customerWizard.phonePh')" @@keyup.enter="runCustomerWizardSearch" />
                                </div>
                                <div class="col-12 col-md-4 d-flex flex-wrap gap-2">
                                    <button type="button" class="btn btn-success btn-sm" :disabled="customerWizard.searchBusy" @@click="runCustomerWizardSearch">
                                        <span v-if="customerWizard.searchBusy" class="spinner-border spinner-border-sm me-1"></span>{{ t('telecom.customerWizard.searchBtn') }}
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" :disabled="customerWizard.searchBusy" @@click="proceedCustomerWizardNew">{{ t('telecom.customerWizard.newBtn') }}</button>
                                </div>
                            </div>
                            <p v-if="customerWizard.searchAttempted && !customerWizard.searchBusy && (!customerWizard.searchResults || customerWizard.searchResults.length === 0)" class="small text-muted mt-3 mb-0">{{ t('telecom.customerWizard.noResults') }}</p>
                            <ul v-if="customerWizard.searchResults && customerWizard.searchResults.length" class="list-group list-group-flush mt-3 border rounded">
                                <li v-for="c in customerWizard.searchResults" :key="c.id" class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2 py-2">
                                    <div>
                                        <div class="fw-semibold">{{ c.name || '—' }}</div>
                                        <div class="small text-muted">{{ c.phoneNumber || '—' }} · {{ c.city || '' }}</div>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-primary" :disabled="customerWizard.handoffBusy" @@click="handoffExistingCustomerToActivate(c)">
                                        <span v-if="customerWizard.handoffBusy" class="spinner-border spinner-border-sm me-1"></span>{{ t('telecom.customerWizard.activateExisting') }}
                                    </button>
                                </li>
                            </ul>
                        </div>

                        <div v-show="customerWizard.step === 2" class="telecom-wizard-step">
                            <button type="button" class="btn btn-link btn-sm p-0 mb-2" @@click="goBackCustomerWizardSearch">← {{ t('telecom.customerWizard.backToSearch') }}</button>
                            <p class="small text-muted mb-3">{{ t('telecom.customerWizard.step2Help') }}</p>
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label small fw-semibold">{{ t('telecom.customerWizard.subscriberType') }}</label>
                                    <div class="d-flex flex-wrap gap-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" id="cwSubInd" :value="0" v-model.number="customerWizard.subscriberType" @@change="onCustomerWizardSubscriberTypeChange" />
                                            <label class="form-check-label small" for="cwSubInd">{{ t('telecom.customerWizard.individual') }}</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" id="cwSubCorp" :value="1" v-model.number="customerWizard.subscriberType" @@change="onCustomerWizardSubscriberTypeChange" />
                                            <label class="form-check-label small" for="cwSubCorp">{{ t('telecom.customerWizard.corporate') }}</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small">{{ customerWizard.subscriberType === 1 ? t('telecom.customerWizard.companyName') : t('telecom.customerWizard.subscriberName') }} <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control form-control-sm" v-model="customerWizard.name" maxlength="256" />
                                    <div class="text-danger small" v-if="customerWizard.errors.name">{{ customerWizard.errors.name }}</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small">{{ t('telecom.customerWizard.customerGroup') }} <span class="text-danger">*</span></label>
                                    <select class="form-select form-select-sm" v-model="customerWizard.customerGroupId">
                                        <option value="">{{ t('telecom.customerWizard.selectGroup') }}</option>
                                        <option v-for="g in customerWizard.groupOptions" :key="g.id" :value="g.id">{{ g.name }}</option>
                                    </select>
                                    <div class="text-danger small" v-if="customerWizard.errors.customerGroupId">{{ customerWizard.errors.customerGroupId }}</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small">{{ t('telecom.customerWizard.customerCategory') }} <span class="text-danger">*</span></label>
                                    <select class="form-select form-select-sm" v-model="customerWizard.customerCategoryId">
                                        <option value="">{{ t('telecom.customerWizard.selectCategory') }}</option>
                                        <option v-for="c in customerWizard.categoryOptions" :key="c.id" :value="c.id">{{ c.name }}</option>
                                    </select>
                                    <div class="text-danger small" v-if="customerWizard.errors.customerCategoryId">{{ customerWizard.errors.customerCategoryId }}</div>
                                </div>
                                <div class="col-md-6" v-if="customerWizard.subscriberType === 0">
                                    <label class="form-label small">{{ t('telecom.customerWizard.nationalId') }} <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control form-control-sm" v-model="customerWizard.nationalId" maxlength="10" dir="ltr" />
                                    <div class="text-danger small" v-if="customerWizard.errors.nationalId">{{ customerWizard.errors.nationalId }}</div>
                                </div>
                                <div class="col-md-6" v-if="customerWizard.subscriberType === 0">
                                    <label class="form-label small">{{ t('telecom.customerWizard.dateOfBirth') }}</label>
                                    <input type="date" class="form-control form-control-sm" v-model="customerWizard.dateOfBirth" />
                                </div>
                                <template v-if="customerWizard.subscriberType === 1">
                                    <div class="col-md-4">
                                        <label class="form-label small">{{ t('telecom.customerWizard.commercialReg') }} <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control form-control-sm" v-model="customerWizard.commercialRegistration" maxlength="64" />
                                        <div class="text-danger small" v-if="customerWizard.errors.commercialRegistration">{{ customerWizard.errors.commercialRegistration }}</div>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small">{{ t('telecom.customerWizard.taxNumber') }}</label>
                                        <input type="text" class="form-control form-control-sm" v-model="customerWizard.taxNumber" maxlength="32" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small">{{ t('telecom.customerWizard.authorizedSignatory') }}</label>
                                        <input type="text" class="form-control form-control-sm" v-model="customerWizard.authorizedSignatory" maxlength="128" />
                                    </div>
                                </template>
                                <div class="col-12">
                                    <label class="form-label small">{{ t('telecom.customerWizard.description') }}</label>
                                    <textarea class="form-control form-control-sm" v-model="customerWizard.description" rows="2" maxlength="512"></textarea>
                                </div>
                                <div class="col-12">
