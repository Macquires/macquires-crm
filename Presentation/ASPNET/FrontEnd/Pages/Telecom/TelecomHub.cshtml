@page
@inject IHtmlLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["Page_TelecomHubTitle"].Value;
}

<div id="app" v-cloak>
    <div class="form-card" id="formcard" :dir="contentDir" :lang="contentLang">
        <div class="container-fluid py-3 px-3 px-lg-4 telecom-hub-root telecom-premium-page">

            <div v-if="loadError" class="alert alert-warning d-flex align-items-center gap-2 mb-3" role="alert">
                <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
                <span>{{ loadError }}</span>
                <button type="button" class="btn btn-sm btn-outline-dark ms-auto" @@click="refreshAll">{{ t('telecom.loadError.retry') }}</button>
            </div>

            <header class="telecom-hero telecom-premium-hero card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="row g-3 align-items-start">
                        <div class="col-12 col-xl-7">
                            <p class="small text-muted mb-1">{{ t('telecom.hero.badge') }}</p>
                            <h1 class="h4 mb-2 fw-semibold">
                                {{ t('telecom.hero.title') }}
                                <span class="text-muted fw-normal fs-6">OSS/BSS</span>
                            </h1>
                            <p class="text-muted mb-0 small lh-lg">{{ t('telecom.hero.subtitle') }}</p>
                        </div>
                        <div class="col-12 col-xl-5">
                            <label class="form-label small text-muted mb-1" for="telecomSearchInput">{{ t('telecom.search.label') }}</label>
                            <div class="input-group input-group-lg telecom-search-group">
                                <span class="input-group-text bg-white"><i class="fas fa-search text-muted" aria-hidden="true"></i></span>
                                <input id="telecomSearchInput" type="search" class="form-control" v-model="searchTerm"
                                       :placeholder="t('telecom.search.placeholder')" autocomplete="off"
                                       @@keyup.enter="runSearch" aria-describedby="telecomSearchHint" />
                                <button class="btn btn-telecom-primary px-3" type="button" @@click="runSearch" :disabled="searchBusy">
                                    <span v-if="searchBusy" class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span v-else>{{ t('telecom.search.search') }}</span>
                                </button>
                            </div>
                            <p id="telecomSearchHint" class="form-text small text-muted mb-0 mt-1">
                                {{ t('telecom.search.hint') }}
                                <a :href="searchTerm.trim().length >= 2 ? '/Telecom/UnifiedSearch?q=' + encodeURIComponent(searchTerm.trim()) : '/Telecom/UnifiedSearch'" class="link-danger">{{ t('telecom.search.unifiedSearchLink') }}</a>
                            </p>
                        </div>
                    </div>
                </div>
            </header>

            <section class="mb-4" :aria-label="t('telecom.quickPathsAria')">
                <div class="row g-3">
                    <div class="col-6 col-md-4 col-lg-2">
                        <button type="button" class="btn w-100 py-4 text-white big-tile tile-activate shadow-sm"
                                :class="{ 'opacity-50 pe-none': !hubPermissions.canCreateOps }"
                                :disabled="!hubPermissions.canCreateOps"
                                @@click="openWizard('activate')" :aria-label="t('telecom.tiles.activate.aria')">
                            <span class="tile-icon d-block mb-1" aria-hidden="true"><i class="fas fa-sim-card"></i></span>
                            <span class="fs-6 fw-semibold d-block">{{ t('telecom.tiles.activate.title') }}</span>
                            <small class="opacity-75">{{ t('telecom.tiles.activate.sub') }}</small>
                        </button>
                    </div>
                    <div class="col-6 col-md-4 col-lg-2">
                        <button type="button" class="btn w-100 py-4 text-white big-tile tile-migrate shadow-sm"
                                :class="{ 'opacity-50 pe-none': !hubPermissions.canCreateOps }"
                                :disabled="!hubPermissions.canCreateOps"
                                @@click="openWizard('migrate')" :aria-label="t('telecom.tiles.migrate.aria')">
                            <span class="tile-icon d-block mb-1" aria-hidden="true"><i class="fas fa-exchange-alt"></i></span>
                            <span class="fs-6 fw-semibold d-block">{{ t('telecom.tiles.migrate.title') }}</span>
                            <small class="opacity-75">{{ t('telecom.tiles.migrate.sub') }}</small>
                        </button>
                    </div>
                    <div class="col-6 col-md-4 col-lg-2">
                        <button type="button" class="btn w-100 py-4 text-white big-tile tile-migrate shadow-sm"
                                :class="{ 'opacity-50 pe-none': !hubPermissions.canCreateOps }"
                                :disabled="!hubPermissions.canCreateOps"
                                @@click="openWizard('changeGsm')" :aria-label="t('telecom.tiles.changeGsm.aria')">
                            <span class="tile-icon d-block mb-1" aria-hidden="true"><i class="fas fa-random"></i></span>
                            <span class="fs-6 fw-semibold d-block">{{ t('telecom.tiles.changeGsm.title') }}</span>
                            <small class="opacity-75">{{ t('telecom.tiles.changeGsm.sub') }}</small>
                        </button>
                    </div>
                    <div class="col-6 col-md-4 col-lg-2">
                        <button type="button" class="btn w-100 py-4 text-white big-tile tile-takeover shadow-sm"
                                :class="{ 'opacity-50 pe-none': !hubPermissions.canCreateOps }"
                                :disabled="!hubPermissions.canCreateOps"
                                @@click="openWizard('takeover')" :aria-label="t('telecom.tiles.takeover.aria')">
                            <span class="tile-icon d-block mb-1" aria-hidden="true"><i class="fas fa-user-friends"></i></span>
                            <span class="fs-6 fw-semibold d-block">{{ t('telecom.tiles.takeover.title') }}</span>
                            <small class="opacity-75">{{ t('telecom.tiles.takeover.sub') }}</small>
                        </button>
                    </div>
                    <div class="col-6 col-md-4 col-lg-2">
                        <button type="button" class="btn w-100 py-4 text-white big-tile tile-simswap shadow-sm"
                                :class="{ 'opacity-50 pe-none': !hubPermissions.canCreateOps }"
                                :disabled="!hubPermissions.canCreateOps"
                                @@click="openWizard('simswap')" :aria-label="t('telecom.tiles.simswap.aria')">
                            <span class="tile-icon d-block mb-1" aria-hidden="true"><i class="fas fa-random"></i></span>
                            <span class="fs-6 fw-semibold d-block">{{ t('telecom.tiles.simswap.title') }}</span>
                            <small class="opacity-75">{{ t('telecom.tiles.simswap.sub') }}</small>
                        </button>
                    </div>
                    <div class="col-6 col-md-4 col-lg-2">
                        <button type="button" class="btn w-100 py-4 text-white big-tile tile-changenumber shadow-sm"
                                :class="{ 'opacity-50 pe-none': !hubPermissions.canCreateOps }"
                                :disabled="!hubPermissions.canCreateOps"
                                @@click="openWizard('changeNumber')" :aria-label="t('telecom.tiles.changeNumber.aria')">
                            <span class="tile-icon d-block mb-1" aria-hidden="true"><i class="fas fa-phone-alt"></i></span>
                            <span class="fs-6 fw-semibold d-block">{{ t('telecom.tiles.changeNumber.title') }}</span>
                            <small class="opacity-75">{{ t('telecom.tiles.changeNumber.sub') }}</small>
                        </button>
                    </div>
                    <div class="col-6 col-md-4 col-lg-2">
                        <button type="button" class="btn w-100 py-4 text-white big-tile tile-termination shadow-sm"
                                :class="{ 'opacity-50 pe-none': !hubPermissions.canCreateOps }"
                                :disabled="!hubPermissions.canCreateOps"
                                @@click="openWizard('termination')" :aria-label="t('telecom.tiles.termination.aria')">
                            <span class="tile-icon d-block mb-1" aria-hidden="true"><i class="fas fa-phone-slash"></i></span>
                            <span class="fs-6 fw-semibold d-block">{{ t('telecom.tiles.termination.title') }}</span>
                            <small class="opacity-75">{{ t('telecom.tiles.termination.sub') }}</small>
                        </button>
                    </div>
                    <div class="col-6 col-md-4 col-lg-2">
                        <button type="button" class="btn w-100 py-4 text-white big-tile tile-suspension shadow-sm"
                                :class="{ 'opacity-50 pe-none': !hubPermissions.canCreateOps }"
                                :disabled="!hubPermissions.canCreateOps"
                                @@click="openWizard('suspension')" :aria-label="t('telecom.tiles.suspension.aria')">
                            <span class="tile-icon d-block mb-1" aria-hidden="true"><i class="fas fa-ban"></i></span>
                            <span class="fs-6 fw-semibold d-block">{{ t('telecom.tiles.suspension.title') }}</span>
                            <small class="opacity-75">{{ t('telecom.tiles.suspension.sub') }}</small>
                        </button>
                    </div>
                    <div class="col-6 col-md-4 col-lg-2">
                        <button type="button" class="btn w-100 py-4 text-white big-tile tile-reconnect shadow-sm"
                                :class="{ 'opacity-50 pe-none': !hubPermissions.canCreateOps }"
                                :disabled="!hubPermissions.canCreateOps"
                                @@click="openWizard('reconnect')" :aria-label="t('telecom.tiles.reconnect.aria')">
                            <span class="tile-icon d-block mb-1" aria-hidden="true"><i class="fas fa-signal"></i></span>
                            <span class="fs-6 fw-semibold d-block">{{ t('telecom.tiles.reconnect.title') }}</span>
                            <small class="opacity-75">{{ t('telecom.tiles.reconnect.sub') }}</small>
                        </button>
                    </div>
                    <div class="col-6 col-md-4 col-lg-2">
                        <button type="button" class="btn w-100 py-4 text-white big-tile tile-refund shadow-sm"
                                :class="{ 'opacity-50 pe-none': !hubPermissions.canCreateOps }"
                                :disabled="!hubPermissions.canCreateOps"
                                @@click="openWizard('refund')" :aria-label="t('telecom.tiles.refund.aria')">
                            <span class="tile-icon d-block mb-1" aria-hidden="true"><i class="fas fa-hand-holding-usd"></i></span>
                            <span class="fs-6 fw-semibold d-block">{{ t('telecom.tiles.refund.title') }}</span>
                            <small class="opacity-75">{{ t('telecom.tiles.refund.sub') }}</small>
                        </button>
                    </div>
                    <div class="col-6 col-md-4 col-lg-2">
                        <button type="button" class="btn w-100 py-4 text-white big-tile tile-device-sale shadow-sm"
                                :class="{ 'opacity-50 pe-none': !hubPermissions.canCreateOps }"
                                :disabled="!hubPermissions.canCreateOps"
                                @@click="openWizard('deviceSale')" aria-label="بيع جهاز DEV">
                            <span class="tile-icon d-block mb-1" aria-hidden="true"><i class="fas fa-mobile-alt"></i></span>
                            <span class="fs-6 fw-semibold d-block">بيع جهاز / راوتر</span>
                            <small class="opacity-75">DEV- · كاش أو تقسيط</small>
                        </button>
                    </div>
                    <div class="col-6 col-md-4 col-lg-2">
                        <button type="button" class="btn w-100 py-4 text-white big-tile tile-package shadow-sm"
                                :class="{ 'opacity-50 pe-none': !hubPermissions.canCreateOps }"
                                :disabled="!hubPermissions.canCreateOps"
                                @@click="openWizard('addpackage')" :aria-label="t('telecom.tiles.addpackage.aria')">
                            <span class="tile-icon d-block mb-1" aria-hidden="true"><i class="fas fa-box-open"></i></span>
                            <span class="fs-6 fw-semibold d-block">{{ t('telecom.tiles.addpackage.title') }}</span>
                            <small class="opacity-75">{{ t('telecom.tiles.addpackage.sub') }}</small>
                        </button>
                    </div>
                    <div class="col-6 col-md-4 col-lg-2">
                        <button type="button" class="btn w-100 py-4 text-white big-tile tile-support shadow-sm"
                                :class="{ 'opacity-50 pe-none': !hubPermissions.canCreateOps }"
                                :disabled="!hubPermissions.canCreateOps"
                                @@click="openWizard('support')" :aria-label="t('telecom.tiles.support.aria')">
                            <span class="tile-icon d-block mb-1" aria-hidden="true"><i class="fas fa-headset"></i></span>
                            <span class="fs-6 fw-semibold d-block">{{ t('telecom.tiles.support.title') }}</span>
                            <small class="opacity-75">{{ t('telecom.tiles.support.sub') }}</small>
                        </button>
                    </div>
                </div>
            </section>

            <section v-if="wizard.visible" class="mb-4" aria-labelledby="wizardHeading">
                <div class="card border-primary shadow-sm">
                    <div class="card-header bg-primary bg-opacity-10 d-flex justify-content-between align-items-center flex-wrap gap-2 py-3">
                        <h2 id="wizardHeading" class="h6 mb-0 fw-semibold">{{ t('telecom.wizard.heading', { title: wizardTitle }) }}</h2>
                        <button type="button" class="btn-close" :aria-label="t('telecom.wizard.closeAria')" @@click="closeWizard"></button>
                    </div>
                    <div class="card-body">
                        <div class="telecom-stepper d-flex gap-2 mb-4 flex-wrap" role="list">
                            <span v-for="s in 3" :key="s" class="telecom-step flex-grow-1 text-center small py-2 rounded"
                                  :class="wizard.step >= s ? 'telecom-step-active' : 'telecom-step-muted'"
                                  role="listitem">
                                {{ s === 1 ? t('telecom.wizard.steps.data') : s === 2 ? t('telecom.wizard.steps.reg') : t('telecom.wizard.steps.done') }}
                            </span>
                        </div>

                        <div v-show="wizard.step === 1" class="telecom-wizard-step">
                            <p class="small text-muted mb-3">{{ t('telecom.wizard.step1Help') }}</p>
                            <div class="row g-3">
                                <div class="col-12 col-lg-6">
                                    <label class="form-label fw-semibold small">{{ t('telecom.wizard.primaryLabel') }}</label>
                                    <div class="input-group input-group-sm mb-2">
                                        <input type="search" class="form-control" v-model="wizard.primarySearchTerm" :placeholder="t('telecom.wizard.searchPh')" @@keyup.enter="runWizardPrimarySearch" />
                                        <button class="btn btn-outline-primary" type="button" :disabled="wizard.primaryBusy" @@click="runWizardPrimarySearch">{{ t('telecom.wizard.searchBtn') }}</button>
                                    </div>
                                    <ul class="list-group list-group-flush border rounded small" style="max-height: 200px; overflow-y: auto;">
                                        <li v-for="r in wizard.primaryResults" :key="'p'+r.id+r.resultType"
                                            class="list-group-item list-group-item-action py-2"
                                            :class="{ active: wizard.primaryRowKey === rowKey(r) }"
                                            @@click="selectWizardPrimary(r)">
                                            <span class="badge bg-secondary me-1">{{ r.resultType }}</span>
                                            <strong>{{ r.title }}</strong>
                                            <span class="text-muted d-block small">{{ r.subtitle }}</span>
                                        </li>
                                        <li v-if="!wizard.primaryBusy && wizard.primaryResults.length === 0" class="list-group-item text-muted small">{{ t('telecom.wizard.noResults') }}</li>
                                    </ul>
                                    <div v-if="wizard.primaryLabel" class="alert alert-light border small py-2 mt-2 mb-0">
                                        {{ t('telecom.wizard.selected') }} <strong>{{ wizard.primaryLabel }}</strong>
                                        <button type="button" class="btn btn-link btn-sm p-0 ms-2" @@click="clearWizardPrimary">{{ t('telecom.wizard.cancel') }}</button>
                                    </div>
                                </div>
                                <div v-if="needsSecondaryParty" class="col-12 col-lg-6">
                                    <label class="form-label fw-semibold small">
                                        {{ t('telecom.wizard.secondaryLabel') }}
                                        <span v-if="secondaryRequired" class="text-danger">{{ t('telecom.wizard.requiredStar') }}</span>
                                        <span v-else class="text-muted fw-normal">{{ t('telecom.wizard.optional') }}</span>
                                    </label>
                                    <div class="input-group input-group-sm mb-2">
                                        <input type="search" class="form-control" v-model="wizard.secondarySearchTerm" :placeholder="t('telecom.wizard.searchPh')" @@keyup.enter="runWizardSecondarySearch" />
                                        <button class="btn btn-outline-primary" type="button" :disabled="wizard.secondaryBusy" @@click="runWizardSecondarySearch">{{ t('telecom.wizard.searchBtn') }}</button>
                                    </div>
                                    <ul class="list-group list-group-flush border rounded small" style="max-height: 200px; overflow-y: auto;">
                                        <li v-for="r in wizard.secondaryResults" :key="'s'+r.id+r.resultType"
                                            class="list-group-item list-group-item-action py-2"
                                            @@click="selectWizardSecondary(r)">
                                            <span class="badge bg-secondary me-1">{{ r.resultType }}</span>
                                            <strong>{{ r.title }}</strong>
                                            <span class="text-muted d-block small">{{ r.subtitle }}</span>
                                        </li>
                                        <li v-if="!wizard.secondaryBusy && wizard.secondaryResults.length === 0" class="list-group-item text-muted small">{{ t('telecom.wizard.noResults2') }}</li>
                                    </ul>
                                    <div v-if="wizard.secondaryLabel" class="alert alert-light border small py-2 mt-2 mb-0">
                                        {{ t('telecom.wizard.selected') }} <strong>{{ wizard.secondaryLabel }}</strong>
                                        <button type="button" class="btn btn-link btn-sm p-0 ms-2" @@click="clearWizardSecondary">{{ t('telecom.wizard.cancel') }}</button>
                                    </div>
                                </div>
                                <div class="col-12" v-if="wizard.kind === 'migrate'">
                                    <label class="form-label small" for="wizTargetOffer">{{ t('telecom.wizard.targetOffer') }}</label>
                                    <input id="wizTargetOffer" type="text" class="form-control form-control-sm" v-model="wizard.targetOfferName"
                                           :placeholder="t('telecom.wizard.targetOfferPh')" maxlength="200" />
                                </div>
                                <div class="col-12" v-if="wizard.kind === 'addpackage'">
                                    <label class="form-label small">{{ t('telecom.tiles.addpackage.title') }}</label>
                                    <div v-if="wizard.vasCatalogBusy" class="placeholder-glow"><span class="placeholder col-12" style="height:2.5rem;"></span></div>
                                    <select v-else class="form-select form-select-sm" v-model="wizard.selectedVasCode">
                                        <option value="">— VAS —</option>
                                        <option v-for="v in wizard.vasCatalog" :key="v.serviceCode" :value="v.serviceCode">{{ v.nameAr }} ({{ v.serviceCode }})</option>
                                    </select>
                                    <p class="small text-muted mt-1 mb-0">{{ t('telecom.offerSubscription.incompatibleLine') }}</p>
                                </div>
                                <div class="col-12" v-if="wizard.kind === 'simswap'">
                                    <label class="form-label small">{{ t('telecom.simSwap.replacementReason') }} *</label>
                                    <select class="form-select form-select-sm mb-2" v-model="wizard.simReplacementReason">
                                        <option value="">—</option>
                                        <option value="Damaged">{{ t('telecom.simSwap.reasonDamaged') }}</option>
                                        <option value="Upgrade5G">{{ t('telecom.simSwap.reasonUpgrade') }}</option>
                                        <option value="Other">{{ t('telecom.simSwap.reasonOther') }}</option>
                                    </select>
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" id="hubSimLost" v-model="wizard.simLostOrStolen" />
                                        <label class="form-check-label small" for="hubSimLost">{{ t('telecom.simSwap.lostOrStolen') }}</label>
                                    </div>
                                    <p v-if="wizard.simLostOrStolen" class="small text-warning">{{ t('telecom.simSwap.lostOrStolenHint') }}</p>
                                    <label class="form-label small">ICCID *</label>
                                    <input type="text" class="form-control form-control-sm font-monospace" dir="ltr" maxlength="19" v-model="wizard.simIccid" />
                                </div>
                                <div class="col-12" v-if="wizard.kind === 'takeover'">
                                    <label class="form-label small">{{ t('telecom.takeOver.transferReason') }} *</label>
                                    <input type="text" class="form-control form-control-sm mb-2" v-model="wizard.tkoTransferReason" maxlength="256" :placeholder="t('telecom.takeOver.transferReasonPh')" />
                                    <label class="form-label small">{{ t('telecom.takeOver.depositPolicy') }}</label>
                                    <select class="form-select form-select-sm" v-model.number="wizard.tkoDepositPolicy">
                                        <option :value="1">{{ t('telecom.takeOver.depositTransfer') }}</option>
                                        <option :value="0">{{ t('telecom.takeOver.depositRetain') }}</option>
                                        <option :value="2">{{ t('telecom.takeOver.depositForfeit') }}</option>
                                        <option :value="3">{{ t('telecom.takeOver.depositRefund') }}</option>
                                    </select>
                                </div>
                                <div class="col-12" v-if="wizard.kind === 'deviceSale'">
                                    <label class="form-label small">جهاز (IMEI) *</label>
                                    <select class="form-select form-select-sm mb-2" v-model="wizard.devInventoryId" @@change="onDevicePicked">
                                        <option value="">— اختر —</option>
                                        <option v-for="d in wizard.devDevices" :key="d.id" :value="d.id">{{ d.imei }} — {{ d.model }} ({{ d.listPrice }})</option>
                                    </select>
                                    <label class="form-label small">نوع البيع *</label>
                                    <select class="form-select form-select-sm mb-2" v-model="wizard.devSaleType">
                                        <option value="Cash">نقدي</option>
                                        <option value="Installment">تقسيط</option>
                                    </select>
                                    <div v-if="wizard.devSaleType === 'Installment'">
                                        <label class="form-label small">خطة التقسيط *</label>
                                        <select class="form-select form-select-sm mb-2" v-model="wizard.devInstallmentPlanId">
                                            <option value="">— اختر —</option>
                                            <option v-for="p in wizard.devPlans" :key="p.id" :value="p.id">{{ p.nameAr }} ({{ p.months }} شهر)</option>
                                        </select>
                                    </div>
                                    <div v-if="wizard.devFinancingPreview" class="alert alert-info py-2 small">{{ wizard.devFinancingPreview }}</div>
                                    <div v-if="wizard.devRequiresFinance" class="alert alert-warning py-2 small">يتطلب اعتماد فايننس قبل التأكيد.</div>
                                </div>
                                <div class="col-12" v-if="wizard.kind === 'deviceSale' && wizard.createdOperationId">
                                    <label class="form-label small">الدفعة / مرجع الدفع (VAL-14-03)</label>
                                    <input type="number" class="form-control form-control-sm mb-2" v-model="wizard.devDownPayment" />
                                    <input type="text" class="form-control form-control-sm mb-2" v-model="wizard.devPaymentReference" placeholder="مرجع الدفع" />
                                    <button type="button" class="btn btn-sm btn-outline-primary" @@click="recordDeviceDownPayment">تسجيل الدفع</button>
                                </div>
                                <div class="col-12" v-if="wizard.kind === 'termination'">
                                    <p class="small text-muted mb-2">
                                        {{ t('telecom.termination.currentMsisdn') }}: <strong class="font-monospace" dir="ltr">{{ wizard.primaryLabel }}</strong>
                                    </p>
                                    <label class="form-label small">{{ t('telecom.termination.terminationType') }} *</label>
                                    <select class="form-select form-select-sm mb-2" v-model="wizard.trmTerminationType" @@change="onTerminationTypeChange">
                                        <option value="Voluntary">{{ t('telecom.termination.typeVoluntary') }}</option>
                                        <option value="Collections">{{ t('telecom.termination.typeCollections') }}</option>
                                        <option value="Regulatory">{{ t('telecom.termination.typeRegulatory') }}</option>
                                        <option value="Fraud">{{ t('telecom.termination.typeFraud') }}</option>
                                    </select>
                                    <label class="form-label small">{{ t('telecom.termination.terminationReason') }} *</label>
                                    <input type="text" class="form-control form-control-sm mb-2" v-model="wizard.trmTerminationReason" :placeholder="t('telecom.termination.reasonPh')" />
                                    <div v-if="wizard.trmTerminationType === 'Voluntary'">
                                        <label class="form-label small">{{ t('telecom.termination.retentionOutcome') }} *</label>
                                        <select class="form-select form-select-sm mb-2" v-model="wizard.trmRetentionOfferOutcome">
                                            <option value="Accepted">{{ t('telecom.termination.retentionAccepted') }}</option>
                                            <option value="Declined">{{ t('telecom.termination.retentionDeclined') }}</option>
