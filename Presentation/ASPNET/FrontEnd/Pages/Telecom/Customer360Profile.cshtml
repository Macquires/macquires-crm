                        <span class="small fw-semibold d-block">ترحيل باقة MGR</span>
                    </button>
                    <button type="button" class="c360-action-card border-0" :class="{ 'is-locked': !can.changeGsm }" :disabled="!can.changeGsm || state.isProvisioningInFlight" @@click="openProvisioningWizard('changeGsm')">
