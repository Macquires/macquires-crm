                                <table class="table table-sm table-hover mb-0">
                                    <thead class="table-light sticky-top"><tr><th>العملية</th><th>النتيجة</th><th>الوقت</th></tr></thead>
                                    <tbody>
                                        <tr v-for="l in (state.profile.billingLogs || []).slice(0,8)" :key="l.id">
                                            <td class="small">{{ l.operationNumber }}</td>
                                            <td><span class="badge" :style="l.success ? 'background:var(--sys-text-main);color:var(--sys-card-bg)' : 'background:var(--sys-border);color:var(--sys-text-main)'">{{ l.success ? 'OK' : 'Retry' }}</span></td>
