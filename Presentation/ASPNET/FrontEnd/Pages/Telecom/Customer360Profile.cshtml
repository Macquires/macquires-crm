                        <span class="small fw-semibold d-block">تحويل نوع الخط CGT</span>
                    </button>
                    <button type="button" class="c360-action-card border-0" :class="{ 'is-locked': !can.changeNumber }" :disabled="!can.changeNumber || state.isProvisioningInFlight" @@click="openProvisioningWizard('changeNumber')">
