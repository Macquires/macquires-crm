                                <div class="col-md-6"><label class="small text-muted">{{ ui.fields.customerKind }}</label><p class="mb-0">{{ customerKindLabel }}</p></div>
                                <div class="col-md-6"><label class="small text-muted">{{ ui.fields.primaryPhone }}</label><p class="mb-0 font-monospace" dir="ltr">{{ state.profile.core?.primaryPhone || '—' }}</p></div>
                                <div class="col-12"><label class="small text-muted">{{ ui.fields.nationalId }} / {{ ui.fields.commercialRegistry }}</label><p class="mb-0 font-monospace" dir="ltr">{{ state.profile.core?.nationalIdMasked || state.profile.core?.commercialRegistry || '—' }}</p></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-7">
                    <div class="telecom-bento-card h-100">
