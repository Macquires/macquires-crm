                        <span class="small fw-semibold d-block">تغيير رقم الخط CNR</span>
                    </button>
                    <button type="button" class="c360-action-card border-0" :class="{ 'is-locked': !can.termination || selectedLineTerminated }" :disabled="!can.termination || selectedLineTerminated || state.isProvisioningInFlight" @@click="openProvisioningWizard('termination')">
