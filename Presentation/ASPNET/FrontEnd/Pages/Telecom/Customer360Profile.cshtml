                        <span class="small fw-semibold d-block">إنهاء خط TRM</span>
                    </button>
                    <button v-if="selectedLineSuspended" type="button" class="c360-action-card border-0" :class="{ 'is-locked': !can.reconnect }" :disabled="!can.reconnect || state.isProvisioningInFlight" @@click="openReconnectHub">
