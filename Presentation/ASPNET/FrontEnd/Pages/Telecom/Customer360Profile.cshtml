            <!-- Tab: Profile & billing -->
            <div v-show="state.activeTab === 'profile'" class="row g-3 mb-4">
                <div class="col-lg-5">
                    <div class="telecom-bento-card h-100">
                        <div class="card-body p-4">
                            <h2 class="h6 fw-bold text-danger mb-3"><i class="bi bi-person-vcard me-2"></i>البيانات الشخصية والقانونية</h2>
                            <div class="row g-3">
                                <div class="col-12"><label class="small text-muted">الاسم</label><p class="fw-semibold mb-0">{{ state.profile.core?.displayName }}</p></div>
                                <div class="col-md-6"><label class="small text-muted">نوع العميل</label><p class="mb-0">{{ customerKindLabel }}</p></div>
                                <div class="col-md-6"><label class="small text-muted">هاتف أساسي</label><p class="mb-0 font-monospace" dir="ltr">{{ state.profile.core?.primaryPhone || '—' }}</p></div>
                                <div class="col-12"><label class="small text-muted">هوية / سجل تجاري</label><p class="mb-0 font-monospace" dir="ltr">{{ state.profile.core?.nationalIdMasked || state.profile.core?.commercialRegistry || '—' }}</p></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-7">
                    <div class="telecom-bento-card h-100">
                        <div class="card-body p-4">
