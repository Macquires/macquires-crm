                            <label class="form-label small fw-semibold">{{ telecomT('deviceSale.saleType', 'Sale') }} *</label>
                            <select class="form-select form-select-sm mb-2" v-model="state.wizard.devSaleType">
                                <option value="Cash">{{ telecomT('deviceSale.saleCash', '') }}</option>
                                <option value="Installment">{{ telecomT('deviceSale.saleInstallment', '') }}</option>
                            </select>
                            <div v-if="state.wizard.devSaleType === 'Installment'">
                                <label class="form-label small">{{ telecomT('deviceSale.installmentPlan', 'Plan') }} *</label>
                                <select class="form-select form-select-sm mb-2" v-model="state.wizard.devInstallmentPlanId">
                                    <option value="">—</option>
                                    <option v-for="p in state.wizard.devPlans" :key="p.id || p.Id" :value="p.id || p.Id">{{ p.nameAr || p.NameAr }}</option>
                                </select>
                            </div>
                            <p v-if="state.wizard.devFinancingPreview" class="small text-muted mb-2">{{ state.wizard.devFinancingPreview }}</p>
                        </div>
                        <div v-if="state.wizard.kind === 'simswap'" class="mb-3">
                            <label class="form-label small fw-semibold">{{ telecomT('simSwap.replacementReason', 'Reason') }} <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm mb-2" v-model="state.wizard.simReplacementReason">
                                <option value="">{{ telecomT('common.selectPlaceholder', '—') }}</option>
                                <option value="Damaged">{{ telecomT('simSwap.reasonDamaged', '') }}</option>
                                <option value="Upgrade5G">{{ telecomT('simSwap.reasonUpgrade', '') }}</option>
                                <option value="Other">{{ telecomT('simSwap.reasonOther', '') }}</option>
                            </select>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="wizSimLost" v-model="state.wizard.simLostOrStolen" />
                                <label class="form-check-label small" for="wizSimLost">{{ telecomT('simSwap.lostOrStolen', '') }}</label>
                            </div>
                            <p v-if="state.wizard.simLostOrStolen" class="small text-warning">{{ telecomT('simSwap.lostOrStolenHint', '') }}</p>
                            <div v-if="state.wizard.simLostOrStolen" class="mb-2">
                                <label class="form-label small">{{ telecomT('simSwap.identityRequired', 'ID') }} *</label>
                                <input type="file" class="form-control form-control-sm" accept=".pdf,.jpg,.jpeg,.png,.webp" @@change="onWizardIdentityFileChange" />
                            </div>
                            <label class="form-label small">{{ telecomT('wizard.activateIccid', 'ICCID') }}</label>
                            <input class="form-control font-monospace" v-model="state.wizard.simIccid" dir="ltr" maxlength="19" />
                        </div>
                        <div v-if="state.wizard.kind === 'activate'">
                            <p class="small text-muted">{{ ui.wizardUi.additionalLine }}</p>
                            <div class="mb-2">
                                <label class="form-label small">{{ ui.wizardUi.availableMsisdn }}</label>
                                <select class="form-select form-select-sm" v-model="state.wizard.msisdnAssetId" :disabled="state.wizard.poolBusy" @@change="onActivateMsisdnChanged">
                                    <option value="">{{ telecomT('common.selectPlaceholder', '—') }}</option>
                                    <option v-for="a in state.wizard.poolNumbers" :key="a.id" :value="a.id">{{ a.msisdn || a.id }}</option>
                                </select>
                            </div>
                            <div v-if="state.wizard.selectedPoolImsi" class="mb-2">
                                <label class="form-label small text-muted">{{ ui.wizardUi.imsiFromStock }}</label>
                                <input class="form-control form-control-sm font-monospace bg-light" :value="state.wizard.selectedPoolImsi" dir="ltr" readonly />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small">{{ ui.wizardUi.package }}</label>
                                <select class="form-select form-select-sm" v-model="state.wizard.selectedOfferingId" :disabled="state.wizard.poolBusy">
                                    <option value="">{{ telecomT('common.selectPlaceholder', '—') }}</option>
                                    <option v-for="o in state.wizard.offerings" :key="o.id" :value="o.id">{{ o.name || o.nameEn }}</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small">{{ ui.wizardUi.iccid }}</label>
                                <input class="form-control font-monospace form-control-sm" v-model="state.wizard.simIccid" dir="ltr" maxlength="19" />
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-md-6">
                                    <label class="form-label small">{{ ui.wizardUi.activationChannel }}</label>
                                    <select class="form-select form-select-sm" v-model.number="state.wizard.activationChannel">
                                        <option :value="0">{{ ui.wizardUi.channelShowroom }}</option>
                                        <option :value="1">{{ ui.wizardUi.channelDealer }}</option>
                                        <option :value="2">{{ ui.wizardUi.channelDigital }}</option>
                                    </select>
                                </div>
                                <div class="col-md-6" v-show="state.wizard.activationChannel === 1">
                                    <label class="form-label small">{{ ui.wizardUi.dealerCode }}</label>
                                    <input class="form-control form-control-sm" v-model="state.wizard.dealerCode" maxlength="64" />
                                </div>
                            </div>
                        </div>
                        <div class="mb-0">
                            <label class="form-label small">{{ ui.wizardUi.notes }}</label>
                            <textarea class="form-control form-control-sm" rows="2" v-model="state.wizard.notes" maxlength="500"></textarea>
                        </div>
                    </div>
                    <div v-show="state.wizard.step === 2 && state.wizard.kind !== 'addpackage'">
                        <p class="small text-muted mb-3">{{ ui.wizardUi.step2Help }}</p>
                        <div v-if="!state.wizard.createdOperationId" class="d-grid">
                            <button type="button" class="btn btn-danger" :disabled="state.wizard.submitBusy" @@click="submitWizardCreateDraft">
                                <span v-if="state.wizard.submitBusy" class="spinner-border spinner-border-sm me-1"></span>{{ ui.wizardUi.createDraft }}
                            </button>
                        </div>
                        <div v-else class="border rounded p-3 bg-light">
                            <p class="mb-2 small"><strong>{{ ui.wizardUi.opNumber }}</strong> {{ state.wizard.createdOperationNumber }}</p>
                            <button v-if="!state.wizard.documentMarkedUploaded" type="button" class="btn btn-success btn-sm" :disabled="state.wizard.uploadBusy" @@click="submitWizardMarkDocument">
                                <span v-if="state.wizard.uploadBusy" class="spinner-border spinner-border-sm me-1"></span>{{ ui.wizardUi.markDocument }}
                            </button>
                            <p v-else class="small text-success mb-2"><i class="bi bi-check-circle me-1"></i>{{ ui.wizardUi.documentDone }}</p>
                            <div v-if="state.wizard.kind === 'activate' && state.wizard.documentMarkedUploaded && !state.wizard.paymentRecorded" class="border rounded p-2 mb-2 bg-white">
                                <p class="small fw-semibold mb-2">{{ ui.wizardUi.paymentBlock }}</p>
                                <div class="row g-2">
                                    <div class="col-md-4">
                                        <select class="form-select form-select-sm" v-model.number="state.wizard.paymentChannel">
                                            <option :value="0">{{ telecomT('refund.methodCash', 'Cash') }}</option>
                                            <option :value="1">{{ telecomT('refund.methodWallet', 'Wallet') }}</option>
                                            <option :value="2">{{ telecomT('swal.voucher', 'Voucher') }}</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <input class="form-control form-control-sm" v-model="state.wizard.paymentAmount" type="number" min="1" step="1" :placeholder="ui.wizardUi.amountPh" />
                                    </div>
                                    <div class="col-md-4">
                                        <input class="form-control form-control-sm" v-model="state.wizard.paymentReference" :placeholder="ui.wizardUi.paymentRefPh" />
                                    </div>
                                </div>
                                <button type="button" class="btn btn-outline-danger btn-sm mt-2" :disabled="state.wizard.paymentBusy" @@click="submitWizardRecordPayment">
                                    <span v-if="state.wizard.paymentBusy" class="spinner-border spinner-border-sm me-1"></span>{{ ui.wizardUi.recordPayment }}
                                </button>
                            </div>
                            <p v-if="state.wizard.kind === 'activate' && state.wizard.paymentRecorded" class="small text-success mb-2">{{ ui.wizardUi.paymentDone }}</p>
                            <p v-if="state.wizard.operationCorrelationId" class="small text-muted font-monospace mb-2" dir="ltr">Correlation: {{ state.wizard.operationCorrelationId }}</p>
                            <div v-if="state.wizard.kind === 'deviceSale' && state.wizard.createdOperationId && state.wizard.devSaleType !== 'Cash' && !state.wizard.documentMarkedUploaded" class="border rounded p-2 mb-2 bg-white">
                                <label class="form-label small">{{ telecomT('deviceSale.downPayment', 'Down payment') }}</label>
                                <input type="number" class="form-control form-control-sm mb-1" v-model="state.wizard.devDownPayment" :placeholder="ui.wizardUi.amountPh" />
                                <input type="text" class="form-control form-control-sm mb-2" v-model="state.wizard.devPaymentReference" :placeholder="ui.wizardUi.paymentRefPh" />
                                <button type="button" class="btn btn-outline-danger btn-sm" :disabled="state.wizard.paymentBusy" @@click="recordDeviceDownPaymentC360">{{ telecomT('deviceSale.recordPayment', 'Record') }}</button>
                            </div>
                            <button v-if="state.wizard.documentMarkedUploaded && !state.wizard.confirmed && state.wizard.kind !== 'takeover' && !(state.wizard.kind === 'simswap' && state.wizard.simLostOrStolen) && !(state.wizard.kind === 'changeNumber' && state.wizard.cnRequiresBackOffice) && !(state.wizard.kind === 'termination' && state.wizard.trmRequiresBackOffice) && !(state.wizard.kind === 'suspension' && state.wizard.susRequiresBackOffice) && !(state.wizard.kind === 'reconnect' && state.wizard.rcnRequiresBackOffice) && !(state.wizard.kind === 'refund' && state.wizard.rfdRequiresBackOffice) && !(state.wizard.kind === 'badDebt' && state.wizard.bdrRequiresBackOffice) && !(state.wizard.kind === 'deviceSale' && state.wizard.devRequiresFinance)" type="button" class="btn btn-primary btn-sm" :disabled="state.wizard.confirmBusy || (state.wizard.kind === 'activate' && activateRequiredDeposit > 0 && !state.wizard.paymentRecorded) || (state.wizard.kind === 'deviceSale' && state.wizard.devSaleType === 'Installment' && !state.wizard.documentMarkedUploaded)" @@click="submitWizardConfirmCbs">
                                <span v-if="state.wizard.confirmBusy" class="spinner-border spinner-border-sm me-1"></span>{{ ui.wizardUi.confirmCbs }}
                            </button>
                            <p v-if="(state.wizard.kind === 'takeover' || (state.wizard.kind === 'simswap' && state.wizard.simLostOrStolen) || (state.wizard.kind === 'changeNumber' && state.wizard.cnRequiresBackOffice) || (state.wizard.kind === 'termination' && state.wizard.trmRequiresBackOffice) || (state.wizard.kind === 'suspension' && state.wizard.susRequiresBackOffice) || (state.wizard.kind === 'reconnect' && state.wizard.rcnRequiresBackOffice) || (state.wizard.kind === 'refund' && state.wizard.rfdRequiresBackOffice) || (state.wizard.kind === 'badDebt' && state.wizard.bdrRequiresBackOffice) || (state.wizard.kind === 'deviceSale' && state.wizard.devRequiresFinance)) && state.wizard.documentMarkedUploaded" class="small text-muted mb-0">
                                {{ ui.wizardUi.awaitBo }}
                            </p>
                            <p v-if="state.wizard.confirmed" class="small text-success mb-0">{{ state.wizard.confirmStatusHint || ui.wizardUi.confirmed }}</p>
                        </div>
                    </div>
                    <div v-show="state.wizard.step === 3">
                        <p class="mb-2">{{ ui.wizardUi.doneTitle }} <strong>{{ state.wizard.createdOperationNumber }}</strong>.</p>
                        <p class="small text-muted mb-0">{{ ui.wizardUi.doneHint }}</p>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mt-3 pt-2 border-top">
                        <button type="button" class="btn btn-outline-secondary btn-sm" :disabled="state.wizard.step === 1 || (state.wizard.step === 2 && state.wizard.createdOperationId)" @@click="wizardStepPrev">{{ ui.wizardUi.prev }}</button>
                        <button v-if="state.wizard.step === 1" type="button" class="btn btn-danger btn-sm" :disabled="state.wizard.submitBusy" @@click="wizardStepNext">{{ state.wizard.kind === 'addpackage' ? ui.wizardUi.nextVas : ui.wizardUi.nextReg }}</button>
                        <button v-if="state.wizard.step === 2" type="button" class="btn btn-danger btn-sm" :disabled="!canWizardFinishStep2" @@click="wizardStepNext">{{ ui.wizardUi.nextSummary }}</button>
                        <button v-if="state.wizard.step === 3" type="button" class="btn btn-primary btn-sm" @@click="finishProvisioningWizard">{{ ui.wizardUi.close }}</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/FrontEnd/Pages/Telecom/Customer360Profile.cshtml.js" asp-append-version="true"></script>
}
