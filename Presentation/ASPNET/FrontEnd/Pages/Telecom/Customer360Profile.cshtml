                                                <th>{{ ui.servicesTab.activatedAt }}</th>
                                                <th>{{ ui.servicesTab.deactivatedAt }}</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr v-for="v in group.items" :key="v.id">
                                                <td>
                                                    <div class="c360-vas-service-cell">
                                                        <span class="c360-vas-service-icon"><i class="bi bi-stars"></i></span>
                                                        <div class="min-w-0">
                                                            <div class="c360-vas-service-name">{{ v.serviceNameAr || '—' }}</div>
                                                            <span v-if="v.serviceCode" class="c360-vas-service-code">{{ v.serviceCode }}</span>
                                                        </div>
                                                    </div>
                                                </td>
