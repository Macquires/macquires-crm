                                <div>
                                    <strong class="font-monospace">{{ t.ticketNumber }}</strong>
                                    <span class="badge ms-2" :class="t.statusBadge">{{ t.statusLabel }}</span>
                                    <span class="badge bg-secondary ms-1">{{ t.priorityLabel }}</span>
                                </div>
                                <span class="small text-muted">{{ t.createdDisplay }}</span>
                            </div>
