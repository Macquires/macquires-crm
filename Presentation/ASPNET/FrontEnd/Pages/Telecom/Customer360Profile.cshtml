                                                </td>
                                                <td>
                                                    <span class="c360-vas-dt" :class="{ 'c360-vas-dt-empty': !v.deactivatedAtUtc }">{{ v.deactivatedAtUtc ? formatDt(v.deactivatedAtUtc) : '—' }}</span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </template>
