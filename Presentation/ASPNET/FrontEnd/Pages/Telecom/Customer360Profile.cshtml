@page "/Telecom/Customer360Profile"
@{
    ViewData["Title"] = "Subscriber 360 profile";
}
<link rel="stylesheet" href="~/css/telecom-premium-theme.css" asp-append-version="true" />
<style>
    #c360-page { min-height: 80vh; }
    .c360-hero {
        background: linear-gradient(
            135deg,
            var(--sys-text-main) 0%,
            color-mix(in srgb, var(--sys-text-main) 75%, var(--sys-text-muted)) 100%
        );
        color: var(--sys-card-bg);
        border-radius: var(--sys-radius);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .c360-hero-kpi {
        background: rgba(255, 255, 255, 0.08);
        border-radius: 10px;
        padding: 0.65rem 1rem;
        min-width: 7rem;
    }
    .c360-tab-btn.active {
        background: var(--sys-brand-red) !important;
        color: var(--sys-card-bg) !important;
        border-color: var(--sys-brand-red) !important;
    }
    .btn-purple-glow {
        background: linear-gradient(135deg, var(--sys-brand-red), var(--sys-brand-red-hover));
        border: none;
        color: var(--sys-card-bg);
        box-shadow: 0 4px 14px var(--sys-brand-red-ring);
    }
    .btn-purple-glow:hover { color: var(--sys-card-bg); filter: brightness(1.08); }
    .c360-sub-card {
        border: 1px solid var(--sys-border);
        border-radius: var(--sys-radius);
        transition: box-shadow 0.2s ease, transform 0.2s ease;
    }
    .c360-sub-card:hover { box-shadow: var(--sys-shadow-card-hover); }
    .c360-wallet-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
        gap: 0.5rem;
    }
    .c360-wallet-kpi {
        background: var(--sys-bg);
        border: 1px solid var(--sys-border);
        border-radius: 8px;
        padding: 0.5rem 0.65rem;
    }
    .c360-wallet-kpi .kpi-label { font-size: 0.7rem; color: var(--sys-text-muted); }
    .c360-wallet-kpi .kpi-value { font-size: 0.95rem; font-weight: 700; }
    .c360-quota-bar {
        height: 6px;
        border-radius: 4px;
        background: var(--sys-border);
        overflow: hidden;
        margin-top: 0.35rem;
    }
    .c360-quota-bar > span {
        display: block;
        height: 100%;
        background: linear-gradient(90deg, var(--sys-brand-red), var(--sys-brand-red-hover));
        border-radius: 4px;
    }
    .c360-ticket-row {
        border: 1px solid var(--sys-border);
        border-radius: var(--sys-radius);
        padding: 1rem 1.15rem;
        background: var(--sys-card-bg);
    }
    .c360-skel {
        height: 140px;
        border-radius: var(--sys-radius);
        background: linear-gradient(90deg, var(--sys-border) 25%, var(--sys-bg) 50%, var(--sys-border) 75%);
        background-size: 200% 100%;
        animation: c360-shimmer 1.2s infinite;
    }
    @@keyframes c360-shimmer {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }
    .c360-wiz-step { border: 1px solid var(--sys-border); }
    .c360-wiz-step-active { background: var(--sys-brand-red); color: var(--sys-card-bg); border-color: var(--sys-brand-red); font-weight: 600; }
    .c360-wiz-step-muted { background: var(--sys-bg); color: var(--sys-text-muted); }
    .c360-actions-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(11.5rem, 1fr));
        gap: 0.85rem;
    }
    .c360-action-card {
        border: 1px solid var(--sys-border);
        border-radius: var(--sys-radius);
        background: var(--sys-card-bg);
        padding: 1rem 0.85rem;
        text-align: center;
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
        position: relative;
        min-height: 7.5rem;
    }
    .c360-action-card:not(.is-locked):hover {
        transform: translateY(-2px);
        box-shadow: var(--sys-shadow-card-hover);
        border-color: var(--sys-brand-red);
    }
    .c360-action-card.is-locked {
        opacity: 0.5;
        cursor: not-allowed;
        pointer-events: none;
    }
    .c360-action-card .c360-action-icon {
        font-size: 1.65rem;
        display: block;
        margin-bottom: 0.35rem;
    }
    .c360-actions-lock::after {
        content: '';
        position: absolute;
        inset: 0;
        background: color-mix(in srgb, var(--sys-card-bg) 35%, transparent);
        border-radius: var(--sys-radius);
        pointer-events: none;
        z-index: 2;
    }
    .c360-vas-summary {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }
    .c360-vas-summary-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.35rem 0.75rem;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 600;
        background: var(--sys-bg);
        border: 1px solid var(--sys-border);
        color: var(--sys-text-main);
    }
    .c360-vas-summary-pill strong {
        color: var(--sys-brand-red);
        font-weight: 700;
    }
    .c360-vas-line-block {
        border: 1px solid var(--sys-border);
        border-radius: var(--sys-radius);
        overflow: hidden;
        background: var(--sys-card-bg);
        margin-bottom: 0.85rem;
    }
    .c360-vas-line-block:last-child { margin-bottom: 0; }
    .c360-vas-line-head {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem 0.75rem;
        padding: 0.65rem 1rem;
        background: var(--sys-bg);
        border-bottom: 1px solid var(--sys-border);
    }
    .c360-vas-line-head .line-msisdn {
        font-family: ui-monospace, monospace;
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--sys-text-main);
        direction: ltr;
    }
    .c360-vas-table {
        margin: 0;
        font-size: 0.875rem;
    }
    .c360-vas-table thead th {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--sys-text-muted);
        background: var(--sys-card-bg);
        border-bottom: 1px solid var(--sys-border);
        white-space: nowrap;
        padding: 0.55rem 1rem;
    }
    .c360-vas-table tbody td {
        padding: 0.75rem 1rem;
        vertical-align: middle;
        border-bottom: 1px solid var(--sys-border);
    }
    .c360-vas-table tbody tr:last-child td { border-bottom: none; }
    .c360-vas-table tbody tr:hover td { background: color-mix(in srgb, var(--sys-bg) 65%, var(--sys-card-bg)); }
    .c360-vas-service-cell {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        min-width: 0;
    }
    .c360-vas-service-icon {
        flex-shrink: 0;
        width: 2.1rem;
        height: 2.1rem;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--sys-brand-red-ring);
        color: var(--sys-brand-red);
        font-size: 1rem;
    }
    .c360-vas-service-name {
        font-weight: 600;
        color: var(--sys-text-main);
        line-height: 1.3;
    }
    .c360-vas-service-code {
        font-size: 0.72rem;
        color: var(--sys-text-muted);
        font-family: ui-monospace, monospace;
        direction: ltr;
        display: inline-block;
    }
    .c360-vas-dt {
        font-size: 0.8rem;
        color: var(--sys-text-muted);
        white-space: nowrap;
    }
    .c360-vas-dt-empty { color: var(--sys-border); }
    .c360-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
        gap: 1rem 1.25rem;
    }
    .c360-info-item label {
        display: block;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--sys-text-muted);
        margin-bottom: 0.2rem;
    }
    .c360-info-item p {
        margin: 0;
        font-weight: 500;
        word-break: break-word;
    }
    .c360-info-section-title {
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--sys-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin: 1.25rem 0 0.75rem;
        padding-bottom: 0.35rem;
        border-bottom: 1px dashed var(--sys-border);
    }
    .c360-info-section-title:first-child { margin-top: 0; }
    .c360-sub-table th {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        white-space: nowrap;
    }
    .c360-sub-table td { font-size: 0.85rem; vertical-align: middle; }
    .c360-sub-table .font-monospace { font-size: 0.82rem; }
</style>

<div id="app" v-cloak class="telecom-premium-page">
    <div class="container-fluid py-4" id="c360-page">
        <div v-if="state.loadError" class="alert alert-danger shadow-sm">{{ state.loadError }}</div>
        <div v-if="state.loading" class="c360-skel mb-3"></div>

        <template v-else-if="state.profile">
            <div class="c360-hero p-4 mb-4 shadow">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                    <div>
                        <p class="small text-white-50 mb-1 text-uppercase letter-spacing-1">{{ ui.heroEyebrow }}</p>
                        <h1 class="h3 fw-bold mb-2">{{ state.profile.core?.displayName || '—' }}</h1>
                        <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                            <span class="badge" style="background:var(--sys-brand-red);color:var(--sys-card-bg)">{{ customerStatusLabel }}</span>
                            <span class="badge" style="background:color-mix(in srgb,var(--sys-text-main) 75%,transparent);color:var(--sys-card-bg)">{{ customerKindLabel }}</span>
                            <span v-if="activeLinesCount" class="badge" style="background:var(--sys-text-main);color:var(--sys-card-bg)">{{ activeLinesLabel }}</span>
                        </div>
                        <p class="small mb-0 opacity-75 font-monospace" dir="ltr">{{ state.profile.core?.nationalIdMasked || state.profile.core?.commercialRegistry || '—' }}</p>
                    </div>
                    <div class="d-flex flex-wrap gap-2 align-items-start">
                        <div class="c360-hero-kpi text-center">
                            <div class="small text-white-50 d-block">{{ ui.hero.tickets }}</div>
                            <strong class="fs-5">{{ (state.profile.supportTickets || []).length }}</strong>
                        </div>
                        <div class="c360-hero-kpi text-center">
                            <div class="small text-white-50 d-block">VAS</div>
                            <strong class="fs-5">{{ activeVasCount }}</strong>
                        </div>
                        <button type="button" class="btn btn-purple-glow btn-sm" @@click="openAiWizard">
                            <i class="bi bi-robot me-1"></i> {{ ui.hero.aiAgent }}
                        </button>
                        <a href="/Telecom/UnifiedSearch" class="btn btn-light btn-sm"><i class="bi bi-search me-1"></i>{{ ui.hero.search }}</a>
                        <a :href="'/Customers/CustomerList?customerId=' + encodeURIComponent(state.customerId)" class="btn btn-outline-light btn-sm">{{ ui.hero.crmRegistry }}</a>
                        <a href="/Telecom/TelecomHub" class="btn btn-outline-light btn-sm">{{ ui.hero.opsHub }}</a>
                    </div>
                </div>
            </div>

            <!-- قسم 1: معلومات العميل الكاملة -->
            <div class="telecom-bento-card mb-4">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold text-danger mb-4"><i class="bi bi-person-lines-fill me-2"></i>{{ ui.sections.fullInfo }}</h2>

                    <div class="c360-info-section-title">{{ ui.sections.identity }}</div>
                    <div class="c360-info-grid">
                        <div class="c360-info-item"><label>{{ ui.fields.displayName }}</label><p>{{ coreField('displayName') }}</p></div>
                        <div class="c360-info-item"><label>{{ ui.fields.accountNumber }}</label><p class="font-monospace" dir="ltr">{{ coreField('accountNumber') }}</p></div>
                        <div class="c360-info-item"><label>{{ ui.fields.customerKind }}</label><p>{{ customerKindLabel }}</p></div>
                        <div class="c360-info-item"><label>{{ ui.fields.status }}</label><p><span class="badge" :class="statusBadgeClass">{{ customerStatusLabel }}</span></p></div>
                        <div v-if="coreField('statusReasonCodeLabel')" class="c360-info-item"><label>{{ ui.fields.statusReason }}</label><p>{{ coreField('statusReasonCodeLabel') }}</p></div>
                        <div v-if="coreField('statusReasonNote')" class="c360-info-item"><label>{{ ui.fields.statusNote }}</label><p>{{ coreField('statusReasonNote') }}</p></div>
                        <div class="c360-info-item"><label>{{ ui.fields.group }}</label><p>{{ coreField('customerGroupName') }}</p></div>
                        <div class="c360-info-item"><label>{{ ui.fields.category }}</label><p>{{ coreField('customerCategoryName') }}</p></div>
                        <div v-if="coreField('description')" class="c360-info-item" style="grid-column:1/-1"><label>{{ ui.fields.description }}</label><p>{{ coreField('description') }}</p></div>
                    </div>

                    <div v-if="isIndividual" class="c360-info-section-title">{{ ui.sections.individual }}</div>
                    <div v-if="isIndividual" class="c360-info-grid">
                        <div class="c360-info-item"><label>{{ ui.fields.nationalId }}</label><p class="font-monospace" dir="ltr">{{ coreField('nationalIdMasked') }}</p></div>
                        <div class="c360-info-item"><label>{{ ui.fields.dob }}</label><p>{{ formatDateOnly(coreField('dateOfBirth')) }}</p></div>
                        <div class="c360-info-item"><label>{{ ui.fields.nationality }}</label><p>{{ coreField('nationality') }}</p></div>
                        <div class="c360-info-item"><label>{{ ui.fields.gender }}</label><p>{{ coreField('genderLabel') }}</p></div>
                        <div class="c360-info-item"><label>{{ ui.fields.occupation }}</label><p>{{ coreField('occupation') }}</p></div>
                    </div>

                    <div v-if="isCorporate" class="c360-info-section-title">{{ ui.sections.corporate }}</div>
                    <div v-if="isCorporate" class="c360-info-grid">
                        <div class="c360-info-item"><label>{{ ui.fields.commercialRegistry }}</label><p class="font-monospace" dir="ltr">{{ coreField('commercialRegistry') }}</p></div>
                        <div class="c360-info-item"><label>{{ ui.fields.taxNumber }}</label><p class="font-monospace" dir="ltr">{{ coreField('taxNumber') }}</p></div>
                        <div class="c360-info-item"><label>{{ ui.fields.authorizedSignatory }}</label><p>{{ coreField('authorizedSignatoryName') }}</p></div>
                        <div class="c360-info-item"><label>{{ ui.fields.legalStatus }}</label><p>{{ coreField('legalStatusLabel') }}</p></div>
                        <div class="c360-info-item"><label>{{ ui.fields.billingMode }}</label><p>{{ coreField('billingConsolidationModeLabel') }}</p></div>
                        <div v-if="coreField('parentCustomerDisplayName')" class="c360-info-item"><label>{{ ui.fields.parentCompany }}</label><p>{{ coreField('parentCustomerDisplayName') }}</p></div>
                    </div>

                    <div class="c360-info-section-title">{{ ui.sections.contact }}</div>
                    <div class="c360-info-grid">
                        <div class="c360-info-item"><label>{{ ui.fields.primaryPhone }}</label><p class="font-monospace" dir="ltr">{{ coreField('primaryPhone') }}</p></div>
                        <div class="c360-info-item"><label>{{ ui.fields.email }}</label><p class="font-monospace" dir="ltr">{{ coreField('contactEmail') }}</p></div>
                        <div class="c360-info-item"><label>{{ ui.fields.fax }}</label><p class="font-monospace" dir="ltr">{{ coreField('faxNumber') }}</p></div>
                        <div class="c360-info-item"><label>{{ ui.fields.website }}</label><p><a v-if="coreField('website')" :href="coreField('website')" target="_blank" rel="noopener">{{ coreField('website') }}</a><span v-else>—</span></p></div>
                        <div class="c360-info-item"><label>{{ ui.fields.whatsApp }}</label><p class="font-monospace" dir="ltr">{{ coreField('whatsApp') }}</p></div>
                        <div class="c360-info-item"><label>LinkedIn</label><p>{{ coreField('linkedIn') }}</p></div>
                        <div class="c360-info-item"><label>Facebook</label><p>{{ coreField('facebook') }}</p></div>
                        <div class="c360-info-item"><label>Instagram</label><p>{{ coreField('instagram') }}</p></div>
                        <div class="c360-info-item"><label>X / Twitter</label><p>{{ coreField('twitterX') }}</p></div>
                        <div class="c360-info-item"><label>TikTok</label><p>{{ coreField('tikTok') }}</p></div>
                    </div>

                    <div class="c360-info-section-title">{{ ui.sections.address }}</div>
                    <div class="c360-info-grid">
                        <div class="c360-info-item"><label>{{ ui.fields.street }}</label><p>{{ coreField('street') }}</p></div>
                        <div class="c360-info-item"><label>{{ ui.fields.city }}</label><p>{{ coreField('city') }}</p></div>
                        <div class="c360-info-item"><label>{{ ui.fields.state }}</label><p>{{ coreField('state') }}</p></div>
                        <div class="c360-info-item"><label>{{ ui.fields.zip }}</label><p>{{ coreField('zipCode') }}</p></div>
                        <div class="c360-info-item"><label>{{ ui.fields.country }}</label><p>{{ coreField('country') }}</p></div>
                    </div>

                    <div v-if="(state.profile.core?.contacts || []).length" class="c360-info-section-title">{{ ui.sections.contactsTable }}</div>
                    <div v-if="(state.profile.core?.contacts || []).length" class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light"><tr><th>{{ ui.fields.contactName }}</th><th>{{ ui.fields.contactTitle }}</th><th>{{ ui.fields.contactPhone }}</th><th>{{ ui.fields.contactEmail }}</th><th>{{ ui.fields.contactNotes }}</th></tr></thead>
                            <tbody>
                                <tr v-for="c in (state.profile.core?.contacts || [])" :key="c.id">
                                    <td>{{ c.name || '—' }}</td>
                                    <td>{{ c.jobTitle || '—' }}</td>
                                    <td class="font-monospace" dir="ltr">{{ c.phoneNumber || '—' }}</td>
                                    <td class="font-monospace" dir="ltr">{{ c.emailAddress || '—' }}</td>
                                    <td class="small text-muted">{{ c.description || '—' }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="c360-info-section-title">{{ ui.sections.audit }}</div>
                    <div class="c360-info-grid">
                        <div class="c360-info-item"><label>{{ ui.fields.createdAt }}</label><p>{{ formatDt(coreField('createdAtUtc', true)) }}</p></div>
                        <div class="c360-info-item"><label>{{ ui.fields.updatedAt }}</label><p>{{ formatDt(coreField('updatedAtUtc', true)) }}</p></div>
                        <div class="c360-info-item"><label>{{ ui.fields.customerId }}</label><p class="font-monospace small" dir="ltr">{{ state.customerId }}</p></div>
                    </div>
                </div>
            </div>

            <!-- قسم 2: الاشتراكات الكاملة -->
            <div class="telecom-bento-card mb-4">
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <h2 class="h5 fw-bold text-danger mb-0"><i class="bi bi-reception-4 me-2"></i>{{ ui.sections.allSubscriptions }}</h2>
                        <span class="badge bg-dark">{{ subscriptionBadgeText }}</span>
                    </div>
                    <div v-if="!allSubscriptions.length" class="text-center text-muted py-4">
                        <i class="bi bi-sim display-6 d-block mb-2 opacity-50"></i>
                        {{ telecomT('customerList.c360.noSubscriptions', 'No subscriptions.') }}
                    </div>
                    <div v-else class="table-responsive">
                        <table class="table table-hover align-middle mb-0 c360-sub-table">
                            <thead class="table-light">
                                <tr>
                                    <th>MSISDN</th>
                                    <th>{{ ui.grid.product }}</th>
                                    <th>{{ ui.grid.subscriptionType }}</th>
                                    <th>{{ ui.grid.status }}</th>
                                    <th>{{ ui.grid.lineType }}</th>
                                    <th>ICCID</th>
                                    <th>IMSI</th>
                                    <th>{{ ui.grid.simType }}</th>
                                    <th>{{ ui.grid.simStatus }}</th>
                                    <th>{{ ui.grid.documents }}</th>
                                    <th>{{ ui.grid.balanceLimit }}</th>
                                    <th>{{ ui.grid.loyalty }}</th>
                                    <th>{{ ui.grid.activation }}</th>
                                    <th>HLR</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-for="sub in allSubscriptions" :key="sub.id">
                                    <td>
                                        <span class="font-monospace fw-bold" dir="ltr">{{ sub.msisdn || '—' }}</span>
                                        <span v-if="sub.isPrimaryLine" class="badge ms-1" style="background:var(--sys-brand-red);color:var(--sys-card-bg);font-size:0.65rem">{{ telecomT('lineActions.primaryBadge', 'Primary') }}</span>
                                    </td>
                                    <td>
                                        <strong>{{ sub.productOfferingName || sub.productName || '—' }}</strong>
                                        <br /><span class="small text-muted">{{ sub.productName || '' }}</span>
                                    </td>
                                    <td>{{ sub.subscriptionTypeName || sub.subscriptionTypeCode || '—' }}</td>
                                    <td><span class="badge" :class="operationalBadgeClass(sub.profileOperationalStatus)">{{ operationalStatusLabel(sub.profileOperationalStatus) }}</span></td>
                                    <td>{{ sub.serviceLineTypeLabel || '—' }}</td>
                                    <td class="font-monospace" dir="ltr">{{ sub.iccid || '—' }}</td>
                                    <td class="font-monospace" dir="ltr">{{ sub.imsi || '—' }}</td>
                                    <td>{{ sub.simType || '—' }}</td>
                                    <td>{{ sub.simStatus || '—' }}</td>
                                    <td>{{ sub.documentStatusLabel || '—' }}</td>
                                    <td class="small">
                                        <span v-if="sub.prepaidBalance != null">{{ ui.balancePrefix }} {{ sub.prepaidBalance }}</span>
                                        <span v-if="sub.postpaidCreditLimit != null"><br />{{ ui.limitPrefix }} {{ sub.postpaidCreditLimit }}</span>
                                        <span v-if="sub.prepaidBalance == null && sub.postpaidCreditLimit == null">—</span>
                                    </td>
                                    <td class="small">
                                        <span v-if="sub.loyaltyTier">{{ sub.loyaltyTier }}</span>
                                        <span v-if="sub.loyaltyPoints"> ({{ sub.loyaltyPoints }} {{ ui.loyaltyPoints }})</span>
                                        <span v-if="!sub.loyaltyTier && !sub.loyaltyPoints">—</span>
                                    </td>
                                    <td class="small text-muted">{{ formatDt(sub.activationDateUtc) }}</td>
                                    <td>
                                        <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" :disabled="state.hlrBusy === sub.id" @@click="checkHlr(sub)">
                                            <span v-if="state.hlrBusy === sub.id" class="spinner-border spinner-border-sm"></span>
                                            <span v-else-if="state.hlrBySub[sub.id]">{{ state.hlrBySub[sub.id].hlrSubscriberState }}</span>
                                            <span v-else><i class="bi bi-broadcast"></i></span>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

