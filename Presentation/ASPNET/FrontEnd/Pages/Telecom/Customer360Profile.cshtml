                        <span class="small fw-semibold d-block">تبديل شريحة</span>
                    </button>
                    <button type="button" class="c360-action-card border-0" :class="{ 'is-locked': !can.takeover }" :disabled="!can.takeover || state.isProvisioningInFlight" @@click="openProvisioningWizard('takeover')">
                        <i class="bi bi-arrow-left-right c360-action-icon" style="color:var(--sys-text-muted)"></i>
                        <span class="small fw-semibold d-block">نقل ملكية</span>
                    </button>
                    <button type="button" class="c360-action-card border-0" :class="{ 'is-locked': !can.provisioning }" :disabled="!can.provisioning || state.isProvisioningInFlight" @@click="openProvisioningWizard('migrate')">
