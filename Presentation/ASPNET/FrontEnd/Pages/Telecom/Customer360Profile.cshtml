                                        </tr>
                                        <tr v-if="!(state.profile.billingLogs || []).length"><td colspan="3" class="text-muted text-center small">لا سجلات.</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tab: Services & VAS -->
            <div v-show="state.activeTab === 'services'" class="mb-4">
                <div class="telecom-bento-card mb-3">
                    <div class="card-body p-4">
                        <h2 class="h6 fw-bold text-danger mb-3"><i class="bi bi-reception-4 me-2"></i>الباقات والخطوط المفعّلة</h2>
                        <div v-if="!(state.profile.core?.activeSubscriptions || []).length" class="text-muted small">لا اشتراكات مسجّلة.</div>
                        <div class="row g-3">
                            <div v-for="sub in (state.profile.core?.activeSubscriptions || [])" :key="sub.id" class="col-lg-6">
                                <div class="c360-sub-card p-3 h-100 bg-white">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <strong class="font-monospace fs-5" dir="ltr">{{ sub.msisdn || '—' }}</strong>
                                        <span v-if="sub.isPrimaryLine" class="badge" style="background:var(--sys-brand-red);color:var(--sys-card-bg)">أساسي</span>
                                    </div>
                                    <p class="mb-1 fw-semibold">{{ sub.productOfferingName || sub.productName || '—' }}</p>
                                    <p class="small text-muted mb-2">{{ sub.subscriptionTypeName }} · {{ sub.simType || 'SIM' }}</p>
                                    <div v-if="state.lineWalletsBusy[sub.id]" class="c360-skel my-2" style="height:4.5rem;"></div>
                                    <div v-else-if="lineWallet(sub.id)" class="border rounded p-2 mb-2 bg-light">
                                        <div v-if="lineWallet(sub.id).success" class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                            <div>
                                                <span class="small text-muted d-block">الرصيد الحالي (CBS)</span>
                                                <span class="fw-bold text-success fs-6">{{ formatAmount(lineWallet(sub.id).balance) }} {{ lineWallet(sub.id).currency || 'ل.س' }}</span>
                                            </div>
                                            <button v-if="canRecharge" type="button" class="btn btn-danger btn-sm" :disabled="state.rechargeBusy === sub.id" @@click="openRechargeModal(sub)">
                                                <span v-if="state.rechargeBusy === sub.id" class="spinner-border spinner-border-sm"></span>
                                                <span v-else><i class="bi bi-lightning-charge me-1"></i>شحن رصيد</span>
                                            </button>
                                        </div>
                                        <p v-else class="small text-muted mb-2">{{ lineWallet(sub.id).errorMessage || 'تعذّر تحميل الرصيد' }}</p>
                                        <p class="small fw-semibold text-danger mb-1">حصص الباقة والمتبقي</p>
                                        <div v-if="!(lineWallet(sub.id).buckets || []).length" class="small text-muted">لا تفاصيل حصص لهذه الباقة.</div>
                                        <div v-for="b in (lineWallet(sub.id).buckets || [])" :key="sub.id + '-' + (b.componentType ?? b.ComponentType)" class="mb-2">
                                            <div class="d-flex justify-content-between small">
                                                <span>{{ bucketLabel(b) }}</span>
                                                <span class="fw-semibold" dir="ltr">
                                                    <template v-if="b.isUnlimited || b.IsUnlimited">غير محدود</template>
                                                    <template v-else>{{ formatAmount(b.remaining ?? b.Remaining) }} / {{ formatAmount(b.included ?? b.Included) }} {{ b.unit ?? b.Unit ?? '' }}</template>
                                                </span>
                                            </div>
                                            <div v-if="!(b.isUnlimited || b.IsUnlimited)" class="c360-quota-bar">
                                                <span :style="{ width: (100 - (b.usagePercent ?? b.UsagePercent ?? 0)) + '%' }"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <span class="badge" :class="operationalBadgeClass(sub.profileOperationalStatus)">{{ sub.profileOperationalStatus || '—' }}</span>
                                    <div v-if="state.hlrBySub[sub.id]" class="small border-top mt-2 pt-2">
                                        <span style="color:var(--sys-text-main)">HLR:</span> {{ state.hlrBySub[sub.id].hlrSubscriberState }}
                                        <span v-if="state.hlrBySub[sub.id].differsFromCrm" class="text-warning ms-1">· اختلاف CRM</span>
                                    </div>
                                    <button type="button" class="btn btn-outline-danger btn-sm mt-2" :disabled="state.hlrBusy === sub.id" @@click="checkHlr(sub)">
                                        <span v-if="state.hlrBusy === sub.id" class="spinner-border spinner-border-sm"></span>
                                        <span v-else><i class="bi bi-broadcast me-1"></i>فحص HLR</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="telecom-bento-card">
                    <div class="card-body p-4">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                            <h2 class="h6 fw-bold text-danger mb-0"><i class="bi bi-stars me-2"></i>الخدمات المضافة (VAS)</h2>
                            <button v-if="can.provisioning" type="button" class="btn btn-outline-danger btn-sm" @@click="openProvisioningWizard('addpackage')">
                                <i class="bi bi-plus-circle me-1"></i>تفعيل خدمة
                            </button>
                        </div>
                        <div v-if="!(state.profile.activeVasServices || []).length" class="text-muted small">لا خدمات VAS مفعّلة على خطوط هذا المشترك.</div>
                        <template v-else>
                            <div class="c360-vas-summary">
                                <span class="c360-vas-summary-pill"><i class="bi bi-collection"></i> الإجمالي: <strong>{{ vasSummary.total }}</strong></span>
                                <span class="c360-vas-summary-pill"><i class="bi bi-check-circle"></i> نشطة: <strong>{{ vasSummary.active }}</strong></span>
                                <span v-if="vasSummary.suspended" class="c360-vas-summary-pill"><i class="bi bi-pause-circle"></i> موقوفة: <strong>{{ vasSummary.suspended }}</strong></span>
                                <span class="c360-vas-summary-pill"><i class="bi bi-phone"></i> خطوط: <strong>{{ groupedVasByLine.length }}</strong></span>
                            </div>
                            <div v-for="group in groupedVasByLine" :key="group.msisdn" class="c360-vas-line-block">
                                <div class="c360-vas-line-head">
                                    <i class="bi bi-sim text-muted"></i>
                                    <span class="line-msisdn">{{ group.msisdn }}</span>
                                    <span class="badge" style="background:var(--sys-text-muted);color:var(--sys-card-bg)">{{ group.items.length }} خدمة</span>
                                    <span v-if="group.activeCount" class="badge bg-success">{{ group.activeCount }} نشطة</span>
                                </div>
                                <div class="table-responsive">
                                    <table class="table c360-vas-table align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th style="min-width:14rem">الخدمة</th>
                                                <th>الحالة</th>
                                                <th>تاريخ التفعيل</th>
                                                <th>تاريخ الإيقاف</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr v-for="v in group.items" :key="v.id">
                                                <td>
                                                    <div class="c360-vas-service-cell">
                                                        <span class="c360-vas-service-icon"><i class="bi bi-stars"></i></span>
                                                        <div class="min-w-0">
                                                            <div class="c360-vas-service-name">{{ v.serviceNameAr || '—' }}</div>
                                                            <span v-if="v.serviceCode" class="c360-vas-service-code">{{ v.serviceCode }}</span>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="badge rounded-pill" :class="vasBadgeClass(v.status)">{{ vasStatusLabel(v.status) }}</span>
                                                </td>
                                                <td>
                                                    <span class="c360-vas-dt" :class="{ 'c360-vas-dt-empty': !v.activatedAtUtc }">{{ v.activatedAtUtc ? formatDt(v.activatedAtUtc) : '—' }}</span>
                                                </td>
                                                <td>
                                                    <span class="c360-vas-dt" :class="{ 'c360-vas-dt-empty': !v.deactivatedAtUtc }">{{ v.deactivatedAtUtc ? formatDt(v.deactivatedAtUtc) : '—' }}</span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </template>
                    </div>
                </div>
            </div>

            <!-- Tab: Tickets -->
            <div v-show="state.activeTab === 'tickets'" class="mb-4">
                <div class="telecom-bento-card">
                    <div class="card-body p-4">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                            <h2 class="h6 fw-bold text-danger mb-0"><i class="bi bi-ticket-detailed me-2"></i>مركز الشكاوى والدعم الفني</h2>
                            <a href="/Telecom/TechnicalTicketList" class="btn btn-outline-secondary btn-sm">الأرشيف الكامل</a>
                        </div>
                        <div v-if="!(state.profile.supportTickets || []).length" class="text-center text-muted py-5">
                            <i class="bi bi-inbox display-6 d-block mb-2 opacity-50"></i>
                            لا تذاكر مرتبطة بهذا المشترك.
                        </div>
                        <div v-for="t in mappedTickets" :key="t.id" class="c360-ticket-row mb-3">
