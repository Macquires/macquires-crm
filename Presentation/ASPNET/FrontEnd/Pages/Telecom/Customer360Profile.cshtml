                                        <span v-if="state.hlrBusy === sub.id" class="spinner-border spinner-border-sm"></span>
                                        <span v-else><i class="bi bi-broadcast me-1"></i>{{ telecomT('lineActions.checkHlr', 'HLR') }}</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
