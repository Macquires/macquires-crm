                                <span class="c360-vas-summary-pill"><i class="bi bi-check-circle"></i> {{ ui.servicesTab.vasActive }} <strong>{{ vasSummary.active }}</strong></span>
                                <span v-if="vasSummary.suspended" class="c360-vas-summary-pill"><i class="bi bi-pause-circle"></i> {{ ui.servicesTab.vasSuspended }} <strong>{{ vasSummary.suspended }}</strong></span>
                                <span class="c360-vas-summary-pill"><i class="bi bi-phone"></i> {{ ui.servicesTab.vasLines }} <strong>{{ groupedVasByLine.length }}</strong></span>
                            </div>
                            <div v-for="group in groupedVasByLine" :key="group.msisdn" class="c360-vas-line-block">
