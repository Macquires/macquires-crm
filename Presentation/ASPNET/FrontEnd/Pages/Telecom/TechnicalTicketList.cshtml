@page "/Telecom/TechnicalTicketList"
@{ ViewData["Title"] = "Technical support tickets"; }
@{ ViewData["PortalPageVcloak"] = true; }
@await Html.PartialAsync("~/FrontEnd/Pages/Shared/AdminTemplate/_PortalPageShell.cshtml")

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="h4 fw-bold text-danger mb-1"><i class="bi bi-ticket-detailed me-2"></i>{{ ui.pageTitle }}</h1>
            <p class="text-muted small mb-0">{{ ui.subtitle }}</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="/Telecom/BackOfficeDashboard" class="btn btn-outline-telecom btn-sm" data-telecom-i18n="backOffice.title">Back office</a>
            <a href="/Customers/CustomerList" class="btn btn-danger btn-sm"><i class="bi bi-person-plus me-1"></i>{{ ui.openFromSubscriber }}</a>
        </div>
    </div>

    <div class="telecom-bento-card mb-3">
        <div class="card-body">
            <h2 class="h6 fw-bold mb-2"><i class="bi bi-mic me-2 text-primary"></i>{{ ui.aiSimTitle }}</h2>
            <p class="small text-muted mb-3">{{ ui.aiSimHint }}</p>
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small">MSISDN</label>
                    <input type="text" class="form-control font-monospace" v-model="state.aiSim.msisdn" placeholder="0933123456" />
                </div>
                <div class="col-md-7">
                    <label class="form-label small">{{ ui.callTranscript }}</label>
                    <input type="text" class="form-control" v-model="state.aiSim.transcript" placeholder="…" />
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-primary w-100" v-on:click="handler.simulateAiCall" v-bind:disabled="state.aiSim.busy">
                        <span v-if="state.aiSim.busy" class="spinner-border spinner-border-sm"></span>
                        <span v-else>{{ ui.createAiTicket }}</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="telecom-bento-card mb-3">
        <div class="card-body py-3">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small">{{ ui.filterStatus }}</label>
                    <select class="form-select" v-model="state.filters.status" v-on:change="handler.search">
                        <option value="">{{ ui.filterAll }}</option>
                        <option value="0">{{ ticketEnumLabel('status', 0) }}</option>
                        <option value="1">{{ ticketEnumLabel('status', 1) }}</option>
                        <option value="2">{{ ticketEnumLabel('status', 2) }}</option>
                        <option value="3">{{ ticketEnumLabel('status', 3) }}</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small">{{ ui.searchMsisdn }}</label>
                    <input type="search" class="form-control font-monospace" v-model="state.filters.msisdn" v-on:keyup.enter="handler.search" />
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-telecom-primary w-100" v-on:click="handler.search">{{ ui.search }}</button>
                </div>
            </div>
        </div>
    </div>

    <div class="telecom-bento-card telecom-grid-panel tt-grid-panel mb-0">
        <div class="card-body pb-2">
            <p class="small text-muted mb-2">{{ ui.gridHint }}</p>
            <div class="grid-container">
                <div ref="gridRef"></div>
            </div>
        </div>
    </div>

    <div class="offcanvas offcanvas-start" tabindex="-1" id="ticketStatusDrawer" style="width:min(440px,100vw);">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title fw-bold" id="ttDrawerTitle">—</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <p class="mb-1"><strong>{{ ui.drawer.subscriber }}:</strong> <span id="ttDrawerCustomer">—</span></p>
        <p class="mb-2"><strong>{{ ui.drawer.msisdn }}:</strong> <span id="ttDrawerMsisdn">—</span></p>
        <p class="mb-2 small text-muted" id="ttDrawerNotes">—</p>
        <label class="form-label small fw-semibold" for="ttTicketStatus">{{ ui.drawer.status }}</label>
        <select id="ttTicketStatus" class="form-select mb-2">
            <option value="0">{{ ticketEnumLabel('status', 0) }}</option>
            <option value="1">{{ ticketEnumLabel('status', 1) }}</option>
            <option value="2">{{ ticketEnumLabel('status', 2) }}</option>
            <option value="3">{{ ticketEnumLabel('status', 3) }}</option>
        </select>
        <label class="form-label small fw-semibold" for="ttTicketPriority">{{ ttT('grid.priority', 'Priority') }}</label>
        <select id="ttTicketPriority" class="form-select mb-2">
            <option value="0">{{ ticketEnumLabel('priority', 0) }}</option>
            <option value="1">{{ ticketEnumLabel('priority', 1) }}</option>
            <option value="2">{{ ticketEnumLabel('priority', 2) }}</option>
            <option value="3">{{ ticketEnumLabel('priority', 3) }}</option>
        </select>
        <label class="form-label small fw-semibold" for="ttOperatorNotes">{{ ui.drawer.resolutionNotes }}</label>
        <textarea id="ttOperatorNotes" class="form-control mb-3" rows="4"></textarea>
        <button type="button" class="btn btn-primary btn-lg w-100" id="ttSaveStatusBtn" v-on:click="handler.saveStatus">{{ ui.drawer.save }}</button>
    </div>
</div>
@await Html.PartialAsync("~/FrontEnd/Pages/Shared/AdminTemplate/_PortalPageShellEnd.cshtml")

@section Scripts {
    <script src="~/FrontEnd/Pages/Telecom/TechnicalTicketList.cshtml.js" asp-append-version="true"></script>
}
