@page "/Telecom/BackOfficeDashboard"
@{
    ViewData["Title"] = "Back-office operations center";
}
<style>
    #bo-dashboard-page { position: relative; }
    .bo-loading-overlay {
        position: absolute; inset: 0; z-index: 20;
        background: rgba(248, 250, 252, 0.72);
        display: flex; align-items: center; justify-content: center;
    }
    .bo-loading-overlay.d-none {
        display: none !important;
        pointer-events: none !important;
    }
    .bo-ticket-critical { animation: bo-pulse 1.2s ease-in-out infinite; }
    @@keyframes bo-pulse { 50% { opacity: .7; } }
    a.bo-kpi-link { text-decoration: none; color: inherit; display: block; height: 100%; }
    a.bo-kpi-link:hover .telecom-bento-card { border-color: rgba(220, 38, 38, 0.35); }
    .bo-workflow-tip { border-right: 4px solid var(--sys-brand-red); }
    #boCriticalBanner.d-none { display: none !important; }
    
    /* Global Hardening: SLA Flashing Effects */
    @@keyframes bo-flash-red {
        0% { background-color: #dc2626; box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.7); }
        70% { background-color: #ef4444; box-shadow: 0 0 0 6px rgba(220, 38, 38, 0); }
        100% { background-color: #dc2626; box-shadow: 0 0 0 0 rgba(220, 38, 38, 0); }
    }
    .bo-sla-breached {
        animation: bo-flash-red 1.5s infinite;
        color: white !important;
        font-weight: bold;
        border: none !important;
    }
    .bo-sla-healthy {
        background-color: #10b981 !important;
        color: white !important;
        font-weight: 600;
    }
    
    /* BDR Financial Ledger Styling */
    .bo-bdr-ledger-card {
        border-right: 4px solid #dc2626 !important;
        background: #fff;
        box-shadow: 0 2px 12px rgba(0,0,0,0.05);
    }
    .bo-debt-highlight {
        background: #fef2f2;
        border: 1px solid #fee2e2;
        color: #dc2626;
        padding: 0.5rem;
        border-radius: 6px;
    }
    .bo-finance-block {
        background: #f8fafc;
        border: 1px solid #f1f5f9;
        padding: 0.5rem;
        border-radius: 6px;
    }
    
    .nav-pills-custom .nav-link {
        border-radius: 8px;
        margin-right: 5px;
        font-weight: 600;
        color: #64748b;
        border: 1px solid transparent;
        transition: all 0.2s;
    }
    .nav-pills-custom .nav-link.active {
        background-color: #dc2626 !important;
        color: white !important;
        box-shadow: 0 4px 12px rgba(220, 38, 38, 0.2);
    }
    .nav-pills-custom .nav-link:hover:not(.active) {
        background-color: #f1f5f9;
        border-color: #e2e8f0;
    }

    .bo-row-fade-out {
        opacity: 0 !important;
        transform: translateX(30px) !important;
        transition: all 0.6s ease-out !important;
    }

    .bo-drawer-section { background: var(--sys-bg); border-radius: var(--sys-radius); padding: 0.75rem 1rem; margin-bottom: 0.75rem; }
    .bo-complaint-box { background: var(--sys-card-bg); border: 1px dashed var(--sys-border); border-radius: var(--sys-radius); padding: 0.65rem 0.85rem; font-size: 0.9rem; max-height: 140px; overflow-y: auto; }
    .bo-tech-toolbar { border: 1px solid var(--sys-border); border-radius: var(--sys-radius); padding: 0.75rem; background: var(--sys-card-bg); }
    .bo-tech-toolbar .btn { font-size: 0.85rem; text-align: start; }
    .bo-live-status-panel { font-size: 0.85rem; }
    .bo-action-busy .spinner-border-sm { width: 0.85rem; height: 0.85rem; }
    .bo-swal-over-offcanvas { z-index: 2000 !important; }
    .bo-swal-over-offcanvas .swal2-textarea { pointer-events: auto !important; }

    .bo-playbook-panel {
        border: 1px solid #fde68a;
        background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
        border-radius: var(--sys-radius);
        padding: 0.75rem 1rem;
    }
    .bo-playbook-head { font-weight: 700; color: #92400e; margin-bottom: 0.25rem; }
    .bo-playbook-steps { padding-inline-start: 1.25rem; margin: 0; }
    .bo-playbook-steps li { margin-bottom: 0.35rem; color: #78350f; }
    .bo-playbook-steps li.bo-step-done { color: #059669; text-decoration: line-through; opacity: 0.85; }
    .bo-playbook-steps li.bo-step-current { font-weight: 700; color: #dc2626; }
    .bo-playbook-hint {
        background: #fff; border: 1px dashed #fbbf24; border-radius: 6px;
        padding: 0.5rem 0.65rem; color: #78350f;
    }
    .bo-playbook-action-target {
        box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.45) !important;
        animation: bo-playbook-pulse 1.5s ease-in-out infinite;
    }
    @@keyframes bo-playbook-pulse {
        50% { box-shadow: 0 0 0 6px rgba(220, 38, 38, 0.12); }
    }
</style>

@{ ViewData["PortalPageId"] = "bo-dashboard-page"; ViewData["PortalPageClass"] = " position-relative"; }
@await Html.PartialAsync("~/FrontEnd/Pages/Shared/AdminTemplate/_PortalPageShell.cshtml")
    <div id="boLoadingOverlay" class="bo-loading-overlay d-none" aria-live="polite">
        <div class="text-center">
            <div class="spinner-border text-danger" role="status"></div>
            <p class="small text-muted mt-2 mb-0" data-telecom-i18n="backOffice.dashboard.loading">جاري تحميل لوحة العمليات…</p>
        </div>
    </div>

    <div id="bo-boot-error" class="alert alert-danger d-none" role="alert"></div>

    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
        <div>
            <h1 class="h4 mb-1 fw-bold text-danger">
                <i class="bi bi-speedometer2 me-2"></i>
                <span data-telecom-i18n="backOffice.title">مركز العمليات الخلفية</span>
            </h1>
            <p class="text-muted small mb-1" data-telecom-i18n="backOffice.subtitle">تذاكر الدعم، الكتالوج، والشبكة</p>
            <p class="text-muted small mb-0">
                <i class="bi bi-clock me-1"></i>
                <span data-telecom-i18n="backOffice.dashboard.lastRefresh">آخر تحديث</span>:
                <span id="boLastRefresh" dir="ltr">—</span>
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <div id="boScopeFilters" class="d-none d-flex flex-wrap gap-2 align-items-center me-2">
                <select id="boScopeRegion" class="form-select form-select-sm" style="min-width:10rem" aria-label="Region">
                    <option value="" data-telecom-i18n="backOffice.dashboard.allRegions">All regions</option>
                </select>
                <select id="boScopeBranch" class="form-select form-select-sm" style="min-width:10rem" aria-label="Branch">
                    <option value="" data-telecom-i18n="backOffice.dashboard.allBranches">All branches</option>
                </select>
                <button type="button" id="boScopeApply" class="btn btn-outline-danger btn-sm" data-telecom-i18n="backOffice.dashboard.scopeApply">Apply scope</button>
            </div>
            <a href="/Telecom/BackOfficeHistoricalLedger" class="btn btn-outline-telecom btn-sm">
                <i class="bi bi-archive me-1"></i>
                <span data-telecom-i18n="backOffice.dashboard.historicalLedger">دفتر الأستاذ التاريخي</span>
            </a>
            <a href="/Telecom/TechnicalTicketList" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-list-task me-1"></i>
                <span data-telecom-i18n="backOffice.dashboard.allTicketsArchive">أرشيف التذاكر</span>
            </a>
            <a href="/Telecom/BulkImportMonitor" class="btn btn-outline-danger btn-sm">
                <i class="bi bi-cloud-upload me-1"></i>
                <span data-telecom-i18n="backOffice.bulkImport">الاستيراد الضخم</span>
            </a>
            <a href="/Telecom/BackOfficeAuditList" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-journal-text me-1"></i>
                <span data-telecom-i18n="backOffice.audit">سجل عملياتي</span>
            </a>
            <button type="button" class="btn btn-danger btn-sm" id="boReloadBtn" data-telecom-i18n-title="backOffice.dashboard.refresh" title="تحديث">
                <i class="bi bi-arrow-clockwise me-1"></i>
                <span data-telecom-i18n="backOffice.dashboard.refresh">تحديث</span>
            </button>
        </div>
    </div>

    <div class="alert alert-light bo-workflow-tip small mb-3 mb-md-4" role="note">
        <i class="bi bi-info-circle text-danger me-2"></i>
        <span data-telecom-i18n="backOffice.dashboard.workflowTip">طابور التذاكر أعلاه يعرض المفتوحة وقيد المعالجة والمصعّدة Tier-3 (الأحدث أولاً). التذاكر المصعّدة تصل لكل موظفي الباك أوفيس. عند «تم الحل» تنتقل للأرشيف.</span>
    </div>

    <div id="boCriticalBanner" class="alert alert-danger d-none mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <span id="boCriticalBannerText"></span>
    </div>

    <div id="boEscalatedBanner" class="alert alert-dark d-none mb-3" role="alert">
        <i class="bi bi-arrow-up-circle-fill me-2"></i>
        <span id="boEscalatedBannerText"></span>
    </div>

    <div class="telecom-bento-card mb-4" id="boTechnicalTicketsPanel">
        <div class="card-header bg-white border-0 py-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div>
                <h2 class="h6 mb-0 fw-bold">
                    <i class="bi bi-list-task me-2 text-danger"></i>
                    <span data-telecom-i18n="backOffice.dashboard.activeQueueTitle">طابور العمل الحي (Technical Tickets)</span>
                </h2>
                <p class="small text-muted mb-0 mt-1" data-telecom-i18n="backOffice.dashboard.activeQueueHint">تذاكر الدعم المفتوحة، قيد المعالجة، والمصعّدة Tier-3 — الأحدث أولاً.</p>
            </div>
        </div>
        <div class="card-body pt-0">
            <div class="telecom-grid-panel bo-tickets-panel">
                <div class="grid-container" id="boTicketsGrid"></div>
            </div>
            <div id="boEmptyQueue" class="text-center py-5 d-none">
                <i class="bi bi-check-circle text-success display-4"></i>
                <p class="mt-3 mb-2 fw-semibold" data-telecom-i18n="backOffice.dashboard.emptyQueue">لا توجد تذاكر في طابورك — عمل رائع!</p>
                <a href="/Telecom/TechnicalTicketList" class="btn btn-outline-telecom btn-sm" data-telecom-i18n="backOffice.dashboard.emptyQueueCta">عرض الأرشيف الكامل</a>
            </div>
        </div>
    </div>

    <div class="telecom-bento-grid mb-4">
        <div class="telecom-bento-span-3">
            <a href="/Telecom/TechnicalTicketList" class="bo-kpi-link" id="boTicketsKpiCard">
                <div class="telecom-bento-card h-100 border-danger border-opacity-25">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="rounded-3 bg-danger bg-opacity-10 p-3"><i class="bi bi-ticket-detailed text-danger fs-3"></i></div>
                        <div>
                            <div class="telecom-bento-kpi-label" data-telecom-i18n="backOffice.openTickets">طابور العمل الحي</div>
                            <div id="boTicketCount" class="telecom-bento-kpi-value text-danger">0</div>
                            <div class="small text-muted" data-telecom-i18n="backOffice.dashboard.openCountHint">مفتوحة + قيد المعالجة</div>
                        </div>
                    </div>
                </div>
            </a>
        </div>
        <div class="telecom-bento-span-3">
            <div class="telecom-bento-card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-warning bg-opacity-15 p-3"><i class="bi bi-hourglass-split text-warning fs-3"></i></div>
                    <div>
                        <div class="telecom-bento-kpi-label" data-telecom-i18n="backOffice.dashboard.inProgress">قيد المعالجة</div>
                        <div id="boInProgressCount" class="telecom-bento-kpi-value">0</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="telecom-bento-span-3">
            <div class="telecom-bento-card h-100" id="boCriticalKpiCard">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-danger bg-opacity-10 p-3"><i class="bi bi-lightning-charge text-danger fs-3"></i></div>
                    <div>
                        <div class="telecom-bento-kpi-label" data-telecom-i18n="backOffice.dashboard.critical">أولوية حرجة</div>
                        <div id="boCriticalCount" class="telecom-bento-kpi-value text-danger">0</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="telecom-bento-span-3">
            <a href="/Telecom/BulkImportMonitor" class="bo-kpi-link">
                <div class="telecom-bento-card h-100">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="rounded-3 bg-light p-3"><i class="bi bi-cloud-upload text-danger fs-3"></i></div>
                        <div>
                            <div class="telecom-bento-kpi-label" data-telecom-i18n="backOffice.bentoBulk">مراقبة الاستيراد</div>
                            <div class="small text-muted mt-1" data-telecom-i18n="backOffice.dashboard.panels.bulkImportHint">MSISDN · عملاء · باقات</div>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="telecom-bento-card mb-4" id="boTelecomQueuePanel">
        <div class="card-header bg-white border-0 py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h2 class="h6 mb-0 fw-bold text-danger">
                <i class="bi bi-shield-check me-2"></i>
                <span data-telecom-i18n="backOffice.dashboard.panels.telecomQueue">طابور اعتماد العمليات (Approval Console)</span>
            </h2>
            <div class="d-flex align-items-center gap-3">
                <ul class="nav nav-pills nav-pills-custom small" id="boQueueTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="active-queue-tab" data-bs-toggle="pill" data-bs-target="#active-queue-pane" type="button" role="tab" data-view="active">
                            📊 <span data-telecom-i18n="backOffice.tabs.active">طابور العمل النشط</span>
                            <span class="badge bg-white text-danger ms-1" id="boActiveCounter">0</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tech-ops-tab" data-bs-toggle="pill" data-bs-target="#tech-ops-pane" type="button" role="tab" data-view="tech">
                            ⚙️ <span data-telecom-i18n="backOffice.tabs.tech">العمليات الفنية والشبكة</span>
                            <span class="badge bg-white text-danger ms-1" id="boTechCounter">0</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="historical-ledger-tab" data-bs-toggle="pill" data-bs-target="#historical-ledger-pane" type="button" role="tab" data-view="historical">
                            📜 <span data-telecom-i18n="backOffice.tabs.historical">الأرشيف التاريخي (Ledger)</span>
                        </button>
                    </li>
                </ul>
            </div>
        </div>
        <div class="card-body py-3">
            <div class="tab-content" id="boQueueTabContent">
                <div class="tab-pane fade show active" id="active-queue-pane" role="tabpanel" aria-labelledby="active-queue-tab" tabindex="0">
                    <p class="small text-muted mb-3" data-telecom-i18n="backOffice.dashboard.panels.activeHint">
                        الطلبات التي تنتج عن عمليات الفروع وبانتظار المراجعة والبت (Pending_BackOffice_Approval).
                    </p>
                </div>
                <div class="tab-pane fade" id="tech-ops-pane" role="tabpanel" aria-labelledby="tech-ops-tab" tabindex="0">
                    <p class="small text-muted mb-3" data-telecom-i18n="backOffice.dashboard.panels.techHint">
                        تذاكر الدعم الفني، تنبيهات تسرب الإيرادات، وأوامر مزامنة الشبكة (HLR Sync).
                    </p>
                </div>
                <div class="tab-pane fade" id="historical-ledger-pane" role="tabpanel" aria-labelledby="historical-ledger-tab" tabindex="0">
                    <p class="small text-muted mb-3" data-telecom-i18n="backOffice.dashboard.panels.historicalHint">
                        سجل كامل لجميع الطلبات التي تم البت فيها (Approved / Rejected) لأغراض التدقيق.
                    </p>
                </div>
            </div>
            
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0" id="boMainQueueTable">
                    <thead class="table-light">
                        <tr>
                            <th data-telecom-i18n="backOffice.dashboard.telecomQueue.request">الطلب</th>
                            <th data-telecom-i18n="backOffice.dashboard.telecomQueue.kind">النوع</th>
                            <th data-telecom-i18n="backOffice.dashboard.kpi.line">الخط</th>
                            <th data-telecom-i18n="backOffice.dashboard.telecomQueue.clearance">التسوية</th>
                            <th data-telecom-i18n="backOffice.dashboard.telecomQueue.slaStatus">حالة SLA</th>
                            <th data-telecom-i18n="backOffice.dashboard.telecomQueue.payment">الدفع</th>
                            <th data-telecom-i18n="backOffice.dashboard.telecomQueue.state">الحالة</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="boTelecomQueueBody">
                        <tr><td colspan="8" class="text-muted text-center py-3" data-telecom-i18n="backOffice.dashboard.kpi.loadingRow">جاري التحميل…</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="telecom-bento-card mb-4" id="boPaymentServicesPanel">
        <div class="card-header bg-white border-0 py-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h2 class="h6 mb-0 fw-bold text-danger"><i class="bi bi-cash-coin me-2"></i><span data-telecom-i18n="backOffice.dashboard.panels.paymentServices">الأداء المالي (Payment Services)</span></h2>
            <span class="small text-muted" id="boPaymentKpiRefresh">—</span>
        </div>
        <div class="card-body py-3">
            <div class="row g-3 small mb-3" id="boPaymentKpiBody">
                <div class="col-md-2"><span class="text-muted d-block" data-telecom-i18n="backOffice.dashboard.kpi.rechargedToday">مشحون اليوم</span><strong id="payKpiAmount">—</strong></div>
                <div class="col-md-2"><span class="text-muted d-block" data-telecom-i18n="backOffice.dashboard.kpi.completed">مكتمل</span><strong id="payKpiCompleted">—</strong></div>
                <div class="col-md-2"><span class="text-muted d-block" data-telecom-i18n="backOffice.dashboard.kpi.failed">فشل</span><strong id="payKpiFailed">—</strong></div>
                <div class="col-md-2"><span class="text-muted d-block" data-telecom-i18n="backOffice.dashboard.kpi.failRate">نسبة الفشل</span><strong id="payKpiFailRate">—</strong></div>
                <div class="col-md-2"><span class="text-muted d-block" data-telecom-i18n="backOffice.dashboard.kpi.sla2m">SLA ≤2د</span><strong id="payKpiSla">—</strong></div>
                <div class="col-md-2"><span class="text-muted d-block" data-telecom-i18n="backOffice.dashboard.kpi.reversed">معكوس</span><strong id="payKpiReversed">—</strong></div>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th data-telecom-i18n="backOffice.dashboard.telecomQueue.paymentPrefix">PAY-</th>
                            <th data-telecom-i18n="backOffice.dashboard.kpi.line">الخط</th>
                            <th data-telecom-i18n="backOffice.dashboard.kpi.amount">المبلغ</th>
                            <th data-telecom-i18n="backOffice.dashboard.kpi.status">الحالة</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="boPaymentTxBody">
                        <tr><td colspan="5" class="text-muted text-center py-3" data-telecom-i18n="backOffice.dashboard.kpi.loadingRow">جاري التحميل…</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="telecom-bento-card mb-4" id="boChangeGsmKpiPanel">
        <div class="card-header bg-white border-0 py-2">
            <h2 class="h6 mb-0 fw-bold text-danger"><i class="bi bi-shuffle me-2"></i><span data-telecom-i18n="backOffice.dashboard.panels.changeGsm">أداء تحويل تقنيات الخطوط (CGT)</span></h2>
        </div>
        <div class="card-body py-3">
            <div class="row g-3 small" id="boChangeGsmKpiBody">
                <div class="col-md-2"><span class="text-muted d-block" data-telecom-i18n="backOffice.dashboard.kpi.today">اليوم</span><strong id="cgtKpiTotal">—</strong></div>
                <div class="col-md-2"><span class="text-muted d-block" data-telecom-i18n="backOffice.dashboard.kpi.completed">منجز</span><strong id="cgtKpiCompleted">—</strong></div>
                <div class="col-md-2"><span class="text-muted d-block" data-telecom-i18n="backOffice.dashboard.kpi.failed">فاشل</span><strong id="cgtKpiFailed">—</strong></div>
                <div class="col-md-2"><span class="text-muted d-block" data-telecom-i18n="backOffice.dashboard.kpi.failRate">نسبة الفشل</span><strong id="cgtKpiFailRate">—</strong></div>
                <div class="col-md-4"><span class="text-muted d-block" data-telecom-i18n="backOffice.dashboard.kpi.topReasons">أكثر الأسباب</span><strong id="cgtKpiReasons" class="d-block">—</strong></div>
            </div>
        </div>
    </div>

    <div class="telecom-bento-card mb-4" id="boChangeNumberKpiPanel">
        <div class="card-header bg-white border-0 py-2">
            <h2 class="h6 mb-0 fw-bold text-danger"><i class="bi bi-telephone-forward me-2"></i><span data-telecom-i18n="backOffice.dashboard.panels.changeNumber">تغيير رقم الخط (CNR)</span></h2>
        </div>
        <div class="card-body py-3">
