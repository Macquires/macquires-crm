                                            </div>
                                            <div class="col-1 text-end">
                                                <button type="button" class="btn btn-sm text-danger shadow-none p-1" @@click="removeComponentFromForm(index)"><i class="fas fa-trash-alt"></i></button>
                                            </div>
                                        </div>
                                        <div v-if="upsertForm.components.length === 0" class="text-center py-2 text-muted small">
