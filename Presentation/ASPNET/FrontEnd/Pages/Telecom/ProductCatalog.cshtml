@section styles {
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Almarai:wght@400;700;800&family=Cairo:wght@400;600;700;800&family=Tajawal:wght@400;500;700&display=swap');

        .telecom-catalog-root.telecom-premium-page {
            font-family: var(--sys-font-stack);
            background-color: var(--sys-bg);
            min-height: 100vh;
            line-height: var(--sys-line-height);
        }

        /* Premium Typography for Arabic */
        [lang="ar"] .telecom-catalog-root, 
        [dir="rtl"] .telecom-catalog-root {
            font-family: 'Tajawal', 'Cairo', 'Almarai', sans-serif !important;
        }

        [lang="ar"] .offering-title,
        [dir="rtl"] .offering-title {
            font-family: 'Almarai', 'Cairo', sans-serif !important;
            font-weight: 800 !important;
            font-size: 1.35rem !important;
            color: var(--sys-text-main);
            line-height: 1.4;
            letter-spacing: -0.3px;
        }

        [lang="ar"] .offering-desc,
        [dir="rtl"] .offering-desc {
            font-family: 'Tajawal', sans-serif !important;
            font-weight: 500 !important;
            font-size: 0.95rem !important;
            line-height: 1.7 !important;
            color: var(--sys-text-muted) !important;
        }

        [lang="ar"] .syriatel-catalog-title,
        [dir="rtl"] .syriatel-catalog-title {
            font-family: 'Almarai', 'Cairo', sans-serif !important;
            font-weight: 800 !important;
        }

        .syriatel-catalog-hero {
            background: linear-gradient(135deg, var(--sys-card-bg) 0%, var(--sys-bg) 100%);
            border-left: 5px solid var(--sys-brand-red) !important;
        }
        [dir="rtl"] .syriatel-catalog-hero {
            border-left: none !important;
            border-right: 5px solid var(--sys-brand-red) !important;
        }

        .syriatel-catalog-title {
            letter-spacing: -0.02em;
        }

        .offering-card {
            border: 1px solid var(--sys-border) !important;
            border-radius: var(--sys-radius) !important;
            background: var(--sys-card-bg);
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .offering-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--sys-shadow-card-hover) !important;
        }

        .offering-glow-line {
            height: 4px;
            width: 100%;
            position: absolute;
            top: 0;
            left: 0;
        }

        /* Glow line styles based on line types */
        .glow-prepaid { background: linear-gradient(90deg, var(--sys-brand-red), var(--sys-brand-red-hover)); }
        .glow-postpaid { background: linear-gradient(90deg, var(--sys-text-main), color-mix(in srgb, var(--sys-text-main) 80%, var(--sys-text-muted))); }
        .glow-hybrid { background: linear-gradient(90deg, var(--sys-text-muted), var(--sys-text-main)); }
        .glow-other { background: linear-gradient(90deg, var(--sys-border), var(--sys-text-muted)); }

        .btn-lang {
            font-size: 0.8rem;
            font-weight: 600;
        }

        .filter-tab-btn {
            font-size: 0.875rem;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .filter-tab-btn:hover {
            transform: translateY(-1px);
        }

        .scrollbar-hidden::-webkit-scrollbar {
            display: none !important;
        }
        .scrollbar-hidden {
            -ms-overflow-style: none !important;
            scrollbar-width: none !important;
        }

        /* Components Card details styling */
        .component-card {
            border: 1px solid var(--sys-border);
            transition: all 0.2s ease;
        }

        .component-card:hover {
            border-color: var(--sys-text-muted);
            box-shadow: var(--sys-shadow-card);
        }

        .component-icon-box {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            flex-shrink: 0;
        }

        .component-voice { background-color: var(--sys-brand-red-ring); color: var(--sys-brand-red); }
        .component-data { background-color: var(--sys-bg); color: var(--sys-text-main); }
        .component-sms { background-color: var(--sys-bg); color: var(--sys-text-main); }
        .component-vas { background-color: var(--sys-brand-red-ring); color: var(--sys-brand-red); }
        .component-equip { background-color: var(--sys-border); color: var(--sys-text-muted); }
        .component-internat { background-color: var(--sys-bg); color: var(--sys-text-muted); }

        /* Price plan detail card styling */
        .price-plan-card {
            border: 1px solid var(--sys-border);
            position: relative;
        }

        .price-plan-card.default-plan {
            background-color: var(--sys-brand-red-ring);
        }

        .default-badge {
            position: absolute;
            top: 0;
            right: 0;
            background-color: var(--sys-brand-red);
            color: var(--sys-card-bg);
            font-size: 0.65rem;
            font-weight: 700;
            padding: 3px 10px;
            border-bottom-left-radius: 8px;
            text-transform: uppercase;
        }
        [dir="rtl"] .default-badge {
            right: auto;
            left: 0;
            border-bottom-left-radius: 0;
            border-bottom-right-radius: 8px;
        }

        .bg-syriatel-soft-red {
            background-color: var(--sys-brand-red-ring) !important;
        }

        /* Skeleton styling */
        .skeleton-card {
            background-color: var(--sys-card-bg);
            border: 1px solid var(--sys-border);
        }
        .skeleton-title {
            height: 24px;
            width: 60%;
            background-color: var(--sys-border);
            border-radius: 4px;
            animation: pulse 1.5s infinite ease-in-out;
        }
        .skeleton-subtitle {
            height: 16px;
            width: 80%;
            background-color: var(--sys-border);
            border-radius: 4px;
            animation: pulse 1.5s infinite ease-in-out;
        }
        .skeleton-quota {
            height: 20px;
            width: 45%;
            background-color: var(--sys-border);
            border-radius: 4px;
            animation: pulse 1.5s infinite ease-in-out;
        }
        .skeleton-btn {
            height: 38px;
            width: 100%;
            background-color: var(--sys-border);
            border-radius: 8px;
            animation: pulse 1.5s infinite ease-in-out;
            margin-top: 15px;
        }

        @@keyframes pulse {
            0% { opacity: 0.6; }
            50% { opacity: 1; }
            100% { opacity: 0.6; }
        }

        /* Modal Scrim Centering */
        .telecom-modal-scrim {
            position: fixed;
            inset: 0;
            z-index: 1080;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: clamp(0.75rem, 3vw, 1.5rem);
            box-sizing: border-box;
            background: color-mix(in srgb, var(--sys-text-main) 45%, transparent);
        }

        .telecom-modal-dialog {
            width: 100%;
            max-width: min(92vw, 56rem);
            max-height: min(88vh, 760px);
            display: flex;
            flex-direction: column;
            background: var(--sys-card-bg);
            border-radius: var(--sys-radius);
            box-shadow: var(--sys-shadow-card-hover);
            overflow: hidden;
        }

        .telecom-search-modal-toolbar {
            flex-shrink: 0;
        }

        .telecom-search-modal-body {
            min-height: 0;
        }

        .btn-detail-action {
            border-color: var(--sys-border);
            transition: all 0.2s ease;
        }

        .btn-detail-action:hover {
            background-color: var(--sys-text-main);
            color: var(--sys-card-bg);
            border-color: var(--sys-text-main);
        }
    </style>
}

