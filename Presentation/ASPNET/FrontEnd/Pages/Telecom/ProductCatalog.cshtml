@page
@inject IHtmlLocalizer<SharedResources> L
@{
    ViewData["Title"] = "Product catalog";
}

@{ ViewData["PortalPageVcloak"] = true; ViewData["PortalPageInner"] = false; ViewData["PortalPageAttrs"] = ":dir=\"contentDir\" :lang=\"contentLang\""; }
@await Html.PartialAsync("~/FrontEnd/Pages/Shared/AdminTemplate/_PortalPageShell.cshtml")

        <div class="container-fluid py-4 px-3 px-lg-4 telecom-catalog-root position-relative">
            <!-- Loader Skeleton -->
            <div v-if="loading" class="telecom-locale-skeleton" aria-hidden="true"></div>

            <!-- Error Banner -->
            <div v-if="loadError" class="alert alert-warning d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
                <span>{{ loadError }}</span>
                <button type="button" class="btn btn-sm btn-outline-dark ms-auto" @@click="refreshCatalog">{{ t('retry') }}</button>
            </div>

            <!-- Header Hero Panel -->
            <header class="telecom-hero telecom-premium-hero card border-0 shadow-sm mb-4 syriatel-catalog-hero">
                <div class="card-body p-4">
                    <div class="row g-3 align-items-center justify-content-between">
                        <div class="col-12 col-md-8 col-lg-9">
                            <p class="small text-uppercase text-muted mb-1 font-monospace" style="letter-spacing:0.12em;">{{ t('syriatelBss') }}</p>
                            <h1 class="h3 mb-2 fw-semibold syriatel-catalog-title">
                                <span class="text-syriatel-red">{{ t('catalogTitleAr') }}</span> 
                                <span class="text-muted fw-light mx-2">|</span> 
                                <span class="text-dark-gray text-uppercase font-sans-serif">{{ t('catalogTitleEn') }}</span>
                            </h1>
                            <p class="text-muted mb-0 small lh-lg">
                                {{ t('catalogSubtitle') }}
                            </p>
                        </div>
                        <div class="col-12 col-md-4 col-lg-3 text-md-end mt-3 mt-md-0" v-if="isAdmin">
                            <button type="button" class="btn btn-syriatel-red text-white py-2 px-4 rounded-3 shadow-sm border-0 d-inline-flex align-items-center gap-2" @@click="openCreateModal">
                                <i class="fas fa-plus-circle fa-lg"></i>
                                <span class="fw-semibold">{{ t('addOffering') }}</span>
                            </button>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Filters Section -->
            <section class="mb-4 search-and-filter-bar">
                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                    <!-- Search Input -->
                    <div class="flex-grow-1 flex-md-grow-0" style="min-width: 280px; max-width: 400px;">
                        <div class="input-group bg-white shadow-sm rounded-3 overflow-hidden border">
                            <span class="input-group-text bg-white border-0 px-3"><i class="fas fa-search text-muted"></i></span>
                            <input type="search" class="form-control border-0 ps-1 py-2 shadow-none" v-model="searchTerm" :placeholder="t('searchPlaceholder')" autocomplete="off" />
                        </div>
                    </div>

                    <!-- Filter Tabs (Sleek scrollable horizontal slider with NO wrapping) -->
                    <div class="overflow-x-auto scrollbar-hidden pb-1 w-100" style="-webkit-overflow-scrolling: touch;">
                        <div class="d-flex align-items-center gap-2 flex-nowrap justify-content-start justify-content-md-end">
                            <button v-for="tab in filterTabs" :key="tab.value" type="button" 
                                    class="btn rounded-pill px-3 py-1.5 shadow-sm filter-tab-btn flex-shrink-0"
                                    :class="selectedTab === tab.value ? 'btn-syriatel-red text-white' : 'btn-white bg-white border'"
                                    @@click="selectTab(tab.value)">
                                <i :class="tab.icon" class="me-1"></i>
                                {{ t(tab.labelKey) }}
                            </button>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Offerings Grid Layout -->
            <section class="mb-5 offerings-section">
                <!-- Skeletal loader cards -->
                <div v-if="loading" class="row g-4">
                    <div v-for="i in 3" :key="i" class="col-12 col-md-6 col-lg-4">
                        <div class="card h-100 border-0 shadow-sm skeleton-card">
                            <div class="card-body p-4">
                                <div class="skeleton-title mb-3"></div>
                                <div class="skeleton-subtitle mb-4"></div>
                                <div class="skeleton-quota mb-2"></div>
                                <div class="skeleton-quota mb-2"></div>
                                <div class="skeleton-btn"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Actual Offering Cards -->
                <div v-else-if="filteredOfferings.length > 0" class="row g-4">
                    <div v-for="offer in filteredOfferings" :key="offer.id" class="col-12 col-md-6 col-lg-4">
                        <div class="card h-100 border-0 shadow-sm offering-card telecom-bento-card position-relative overflow-hidden transition-all">
                            <!-- Premium glow line based on line type -->
                            <div class="offering-glow-line" :class="'glow-' + getLineTypeClass(offer.compatibleSubscriptionTypeId)"></div>
                            
                            <div class="card-body p-4 d-flex flex-column h-100">
                                <!-- Line Type Badge and Status -->
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="badge rounded-pill px-3 py-1 shadow-sm font-monospace" :class="getLineTypeBadgeClass(offer.compatibleSubscriptionTypeId)">
                                        {{ getLineTypeName(offer.compatibleSubscriptionTypeId) }}
                                    </span>
                                    <span class="small font-monospace text-muted opacity-75">
                                        {{ offer.code }}
                                    </span>
                                </div>

                                <!-- Offering Title -->
                                <h3 class="h5 fw-semibold mb-2 offering-title">
                                    {{ offerDisplayName(offer) }}
                                </h3>

                                <!-- Description -->
                                <p class="text-muted small mb-4 flex-grow-1 lh-base offering-desc">
                                    {{ offer.description || t('noDescription') }}
                                </p>

                                <!-- Summary Features Grid (Mini quotas) -->
                                <div class="features-preview-grid mb-4 border-top pt-3">
                                    <div class="row g-2">
                                        <div class="col-6" v-if="hasFeature(offer, 0)">
                                            <div class="d-flex align-items-center gap-2 small text-muted">
                                                <i class="fas fa-phone-alt text-syriatel-red opacity-85"></i>
                                                <span class="fw-semibold text-dark">{{ getFeatureLabel(offer, 0) }}</span>
                                            </div>
                                        </div>
                                        <div class="col-6" v-if="hasFeature(offer, 1)">
                                            <div class="d-flex align-items-center gap-2 small text-muted">
                                                <i class="fas fa-globe text-primary opacity-85"></i>
                                                <span class="fw-semibold text-dark">{{ getFeatureLabel(offer, 1) }}</span>
                                            </div>
                                        </div>
                                        <div class="col-6" v-if="hasFeature(offer, 2)">
                                            <div class="d-flex align-items-center gap-2 small text-muted">
                                                <i class="fas fa-comment-alt text-success opacity-85"></i>
                                                <span class="fw-semibold text-dark">{{ getFeatureLabel(offer, 2) }}</span>
                                            </div>
                                        </div>
                                        <div class="col-6" v-if="offer.defaultPrice">
                                            <div class="d-flex align-items-center gap-2 small text-muted">
                                                <i class="fas fa-coins text-warning opacity-85"></i>
                                                <span class="fw-bold text-dark">{{ formatPrice(offer.defaultPrice) }}</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Actions Button -->
                                <div class="mt-auto d-grid">
                                    <button type="button" class="btn btn-outline-dark rounded-3 py-2 btn-detail-action" @@click="viewDetails(offer.id)">
                                        <i class="fas fa-eye me-1"></i>
                                        {{ t('viewFullDetails') }}
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Empty State -->
                <div v-else class="text-center py-5 shadow-sm rounded-3 bg-white border">
                    <div class="py-4">
                        <i class="fas fa-search-minus text-muted fa-3x mb-3 opacity-50"></i>
                        <h4 class="h5 fw-semibold text-dark-gray">{{ t('noOfferingsFound') }}</h4>
                        <p class="text-muted small">{{ t('noOfferingsSubtitle') }}</p>
                        <button type="button" class="btn btn-sm btn-syriatel-red text-white px-4 rounded-pill mt-2" @@click="resetFilters">
                            {{ t('resetFilters') }}
                        </button>
                    </div>
                </div>
            </section>

            <!-- Offering Details Premium Modal -->
            <div v-if="detailModalVisible" class="telecom-modal-scrim" role="presentation" @@click.self="closeDetails">
                <div class="telecom-modal-dialog telecom-registry-dialog d-flex flex-column shadow-lg" role="dialog" aria-modal="true" @@click.stop>
                    <!-- Header -->
                    <div class="telecom-search-modal-toolbar d-flex align-items-center justify-content-between px-4 py-3 border-bottom bg-dark text-white flex-shrink-0">
                        <div class="d-flex align-items-center gap-3">
                            <i class="fas fa-box-open fa-lg text-syriatel-red"></i>
                            <div>
                                <h2 class="h5 mb-0 fw-semibold">
                                    {{ offerDisplayName(currentOffer) }}
                                </h2>
                                <span class="small font-monospace opacity-75">{{ currentOffer.code }}</span>
                            </div>
                        </div>
                        <button type="button" class="btn-close btn-close-white shadow-none" @@click="closeDetails" aria-label="Close"></button>
                    </div>

                    <!-- Modal Body -->
                    <div class="telecom-search-modal-body flex-grow-1 overflow-auto p-4 bg-light min-h-0">
                        <div v-if="detailLoading" class="text-center py-5">
                            <span class="spinner-border text-syriatel-red spinner-border-lg" role="status" aria-hidden="true"></span>
                            <p class="text-muted small mt-3">{{ t('loadingDetails') }}</p>
                        </div>
                        <div v-else class="row g-4">
                            <!-- Left Column: Specs & Components -->
                            <div class="col-12 col-lg-7">
                                <div class="card border-0 shadow-sm mb-4 h-100">
                                    <div class="card-header bg-white border-bottom py-3 px-4 fw-semibold d-flex align-items-center gap-2">
                                        <i class="fas fa-sliders-h text-syriatel-red"></i>
                                        <span>{{ t('serviceSpecifications') }}</span>
                                    </div>
                                    <div class="card-body p-4">
                                        <!-- Description -->
                                        <div class="mb-4">
                                            <h4 class="small text-uppercase text-muted fw-bold mb-2">{{ t('offeringDescription') }}</h4>
                                            <p class="text-dark small lh-lg bg-white p-3 border rounded">
                                                {{ currentOffer.description || t('noDescription') }}
                                            </p>
                                        </div>

                                        <!-- Specifications (Components) List -->
                                        <div>
                                            <h4 class="small text-uppercase text-muted fw-bold mb-3">{{ t('bundledComponents') }}</h4>
                                            <div class="row g-3">
                                                <div v-for="comp in currentOffer.components" :key="comp.id" class="col-12 col-md-6">
                                                    <div class="component-card p-3 border rounded bg-white d-flex align-items-start gap-3 transition-all">
                                                        <div class="component-icon-box" :class="getComponentTypeClass(comp.componentType)">
                                                            <i :class="getComponentTypeIcon(comp.componentType)"></i>
                                                        </div>
                                                        <div class="flex-grow-1">
                                                            <h5 class="small fw-semibold mb-1 text-dark">
                                                                {{ comp.label || getComponentTypeName(comp.componentType) }}
                                                            </h5>
                                                            <p class="mb-0 text-syriatel-red font-monospace fw-bold h5">
                                                                <template v-if="comp.isUnlimited">
                                                                    {{ t('unlimited') }}
                                                                </template>
                                                                <template v-else>
                                                                    {{ comp.quota }} <span class="small text-muted">{{ comp.quotaUnit }}</span>
                                                                </template>
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div v-if="!currentOffer.components || currentOffer.components.length === 0" class="col-12">
                                                    <p class="text-muted small text-center py-3 bg-white border rounded">
                                                        {{ t('noComponentsInOffering') }}
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Right Column: Price Plans -->
                            <div class="col-12 col-lg-5">
                                <div class="card border-0 shadow-sm mb-4">
                                    <div class="card-header bg-white border-bottom py-3 px-4 fw-semibold d-flex align-items-center gap-2">
                                        <i class="fas fa-receipt text-syriatel-red"></i>
                                        <span>{{ t('pricingPlans') }}</span>
                                    </div>
                                    <div class="card-body p-4">
                                        <!-- Price Cards Loop -->
                                        <div class="d-flex flex-column gap-3">
                                            <div v-for="plan in currentOffer.pricePlans" :key="plan.id" 
                                                 class="price-plan-card p-3 border rounded bg-white transition-all position-relative overflow-hidden"
                                                 :class="{ 'border-syriatel-red default-plan': plan.isDefault }">
                                                <div v-if="plan.isDefault" class="default-badge">
                                                    {{ t('defaultPlan') }}
                                                </div>
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="badge" :class="plan.isDefault ? 'bg-syriatel-soft-red text-syriatel-red' : 'bg-light text-muted'">
                                                        {{ getPlanTypeName(plan.planType) }}
                                                    </span>
                                                    <span class="small font-monospace text-muted" v-if="plan.validityDays">
                                                        {{ plan.validityDays }} {{ t('daysValidity') }}
                                                    </span>
                                                </div>

                                                <div class="d-flex align-items-baseline gap-1 py-1">
                                                    <span class="h2 mb-0 fw-bold text-dark font-monospace">{{ formatPlanPrice(plan.price) }}</span>
                                                    <span class="text-muted small font-monospace">{{ plan.currencyCode }}</span>
                                                    <span class="text-muted small ms-1">/ {{ getPlanTypePeriod(plan.planType) }}</span>
                                                </div>

                                                <!-- Activation Fee -->
                                                <div v-if="plan.activationFee" class="border-top mt-2 pt-2 d-flex justify-content-between align-items-center small text-muted">
                                                    <span>{{ t('activationFee') }}</span>
                                                    <span class="fw-semibold text-dark font-monospace">{{ formatPrice(plan.activationFee) }}</span>
                                                </div>
                                            </div>

                                            <div v-if="!currentOffer.pricePlans || currentOffer.pricePlans.length === 0" class="text-center py-4 bg-white border rounded">
                                                <p class="text-muted small mb-0">{{ t('noPricePlansInOffering') }}</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Quick Actions Panel -->
                                <div class="card border-0 shadow-sm">
                                    <div class="card-header bg-white border-bottom py-3 px-4 fw-semibold d-flex align-items-center gap-2">
                                        <i class="fas fa-bolt text-syriatel-red"></i>
                                        <span>{{ t('quickActions') }}</span>
                                    </div>
                                    <div class="card-body p-4 d-grid gap-2">
                                        <button type="button" class="btn btn-syriatel-red text-white py-2" @@click="triggerAction('activate')">
                                            <i class="fas fa-mobile-alt me-1"></i>
                                            {{ t('actionActivate') }}
                                        </button>
                                        <button type="button" class="btn btn-outline-dark py-2" @@click="triggerAction('migrate')">
                                            <i class="fas fa-broadcast-tower me-1"></i>
                                            {{ t('actionMigrate') }}
                                        </button>
                                        <button v-if="isAdmin" type="button" class="btn btn-outline-danger py-2 mt-2" @@click="openEditModal(currentOffer)">
                                            <i class="fas fa-edit me-1"></i>
                                            {{ t('editOffering') }}
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="modal-footer bg-light px-4 py-3 border-top justify-content-end">
                        <button type="button" class="btn btn-secondary px-4 py-2" @@click="closeDetails">{{ t('close') }}</button>
                    </div>
                </div>
            </div>

            <!-- Offering Upsert Premium Modal (Create / Edit) -->
            <div v-if="upsertModalVisible" class="telecom-modal-scrim" role="presentation" @@click.self="closeUpsert">
                <div class="telecom-modal-dialog telecom-registry-dialog d-flex flex-column shadow-lg" role="dialog" aria-modal="true" @@click.stop style="max-width: 60rem;">
                    <!-- Header -->
                    <div class="telecom-search-modal-toolbar d-flex align-items-center justify-content-between px-4 py-3 border-bottom bg-dark text-white flex-shrink-0">
                        <div class="d-flex align-items-center gap-3">
                            <i class="fas fa-edit fa-lg text-syriatel-red"></i>
                            <div>
                                <h2 class="h5 mb-0 fw-semibold">
                                    {{ isEditMode ? t('editOffering') : t('addOffering') }}
                                </h2>
                                <span class="small font-monospace opacity-75">{{ t('upsertOfferingTitle') }}</span>
                            </div>
                        </div>
                        <button type="button" class="btn-close btn-close-white shadow-none" @@click="closeUpsert" :aria-label="t('closeAria')"></button>
                    </div>

                                      <div class="telecom-search-modal-body flex-grow-1 overflow-auto p-4 bg-light min-h-0">
                        <div class="row g-3">
                            <!-- Basic specs -->
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-bold text-muted">{{ t('offeringNameAr') }} *</label>
                                <input type="text" class="form-control" v-model="upsertForm.name" :placeholder="t('namePh')" required />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-bold text-muted">{{ t('offeringNameEn') }} *</label>
                                <input type="text" class="form-control" v-model="upsertForm.nameEn" :placeholder="t('nameEnPh')" required />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-bold text-muted">{{ t('offeringCode') }} *</label>
                                <input type="text" class="form-control font-monospace text-uppercase" v-model="upsertForm.code" :placeholder="t('codePh')" :disabled="isEditMode" required />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-bold text-muted">{{ t('compatibleLineType') }}</label>
                                <select class="form-select" v-model="upsertForm.compatibleSubscriptionTypeId">
                                    <option value="a0e0e0e0-0000-4000-8000-000000000001">{{ t('prepaid') }}</option>
                                    <option value="a0e0e0e0-0000-4000-8000-000000000002">{{ t('postpaid') }}</option>
                                    <option value="a0e0e0e0-0000-4000-8000-000000000003">{{ t('hybrid') }}</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-bold text-muted">{{ t('commercialCategory') }}</label>
                                <select class="form-select" v-model="upsertForm.category">
                                    <option value="cellular">{{ t('cellularPlan') }}</option>
                                    <option value="dataOnly">{{ t('internetPlan') }}</option>
                                    <option value="corporate">{{ t('corporatePlan') }}</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-6" v-if="isAdmin">
                                <label class="form-label small fw-bold text-muted">{{ t('technicalProduct') }}</label>
                                <select class="form-select" v-model="upsertForm.productId">
                                    <option value="">{{ t('noneLink') }}</option>
                                    <option v-for="p in technicalProducts" :key="p.id" :value="p.id">{{ p.name }} ({{ p.serviceCode }})</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-bold text-muted">{{ t('offeringDescription') }}</label>
                                <textarea class="form-control" rows="3" v-model="upsertForm.description" :placeholder="t('descriptionPh')"></textarea>
                            </div>

                            <!-- Smart Product Catalog Architect Properties -->
                            <div class="col-12"><hr class="my-2 border-secondary opacity-25"></div>
                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-bold text-muted">{{ t('eligibilityRules') }}</label>
                                <select class="form-select" v-model="upsertForm.eligibilityRules">
                                    <option value="Prepaid">{{ t('eligibilityPrepaid') }}</option>
                                    <option value="Postpaid">{{ t('eligibilityPostpaid') }}</option>
                                    <option value="Hybrid">{{ t('eligibilityHybrid') }}</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-bold text-muted">{{ t('assetCompatibility') }}</label>
                                <select class="form-select" v-model="upsertForm.assetCompatibility">
                                    <option value="Voice">{{ t('assetVoice') }}</option>
                                    <option value="Data">{{ t('assetData') }}</option>
                                    <option value="Fiber">{{ t('assetFiber') }}</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-bold text-muted">{{ t('billingCycle') }}</label>
                                <select class="form-select" v-model="upsertForm.billingCycle">
                                    <option value="Monthly">{{ t('cycleMonthly') }}</option>
                                    <option value="Weekly">{{ t('cycleWeekly') }}</option>
                                    <option value="Daily">{{ t('cycleDaily') }}</option>
                                    <option value="OneTime">{{ t('cycleOneTime') }}</option>
                                </select>
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-bold text-muted">{{ t('taxCategory') }}</label>
                                <select class="form-select" v-model="upsertForm.taxCategory">
                                    <option value="StandardVAT">{{ t('taxStandardVat') }}</option>
                                    <option value="TelecomTax">{{ t('taxTelecom') }}</option>
                                    <option value="Exempt">{{ t('taxExempt') }}</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-bold text-muted">{{ t('socCode') }}</label>
                                <input type="text" class="form-control font-monospace" v-model="upsertForm.serviceIdSocCode" placeholder="HW_MIX_500" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-bold text-muted">{{ t('throttlingPolicy') }}</label>
                                <select class="form-select" v-model="upsertForm.throttlingPolicy">
                                    <option value="Cutoff">{{ t('throttleCutoff') }}</option>
                                    <option value="Throttle128K">{{ t('throttle128') }}</option>
                                    <option value="PayAsYouGo">{{ t('throttlePayg') }}</option>
                                </select>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-bold text-muted">{{ t('speedQuotaGb') }}</label>
                                <input type="number" step="0.1" class="form-control" v-model="upsertForm.speedQuotaLimitGb" placeholder="50.0" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-bold text-muted">{{ t('voiceMinutes') }}</label>
                                <input type="number" class="form-control" v-model="upsertForm.voiceMinutesLimit" placeholder="500" />
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-bold text-muted">{{ t('iconClass') }}</label>
                                <input type="text" class="form-control" v-model="upsertForm.iconClass" placeholder="fas fa-mobile-alt" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-bold text-muted">{{ t('badgeColor') }}</label>
                                <select class="form-select" v-model="upsertForm.badgeColor">
                                    <option value="primary">{{ t('badgePrimary') }}</option>
                                    <option value="success">{{ t('badgeSuccess') }}</option>
                                    <option value="warning">{{ t('badgeWarning') }}</option>
