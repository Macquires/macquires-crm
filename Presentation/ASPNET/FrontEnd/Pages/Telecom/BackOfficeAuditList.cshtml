@page "/Telecom/BackOfficeAuditList"

@{

    ViewData["Title"] = "سجل عملياتي";

}



@{ ViewData["PortalPageVcloak"] = true; ViewData["PortalPageInner"] = false; }
@await Html.PartialAsync("~/FrontEnd/Pages/Shared/AdminTemplate/_PortalPageShell.cshtml")


    <div class="container-fluid py-3">

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">

            <div>

                <h1 class="h4 mb-1 fw-bold text-danger">

                    <i class="bi bi-journal-text me-2"></i>

                    <span data-telecom-i18n="backOffice.auditList.title">سجل عملياتي</span>

                </h1>

                <p class="text-muted small mb-0" data-telecom-i18n="backOffice.auditList.subtitle">

                    الصندوق الأسود — حركاتك على المشتركين والشبكة والاستيراد

                </p>

            </div>

            <a href="/Telecom/BackOfficeDashboard" class="btn btn-outline-telecom btn-sm">

                <i class="bi bi-arrow-right me-1"></i>

                <span data-telecom-i18n="backOffice.auditList.backToDashboard">لوحة العمليات</span>

            </a>

        </div>



        <div class="telecom-bento-grid mb-3">

            <div class="telecom-bento-span-4">

                <div class="telecom-bento-card h-100">

                    <div class="card-body d-flex align-items-center gap-3">

                        <div class="rounded-3 bg-light p-3"><i class="bi bi-clock-history text-danger fs-3"></i></div>

                        <div>

                            <div class="telecom-bento-kpi-label" data-telecom-i18n="backOffice.auditList.kpi.logsToday">عملياتك اليوم</div>

                            <div class="telecom-bento-kpi-value" v-text="state.summary.logsToday">0</div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="telecom-bento-span-4">

                <div class="telecom-bento-card h-100">

                    <div class="card-body d-flex align-items-center gap-3">

                        <div class="rounded-3 bg-danger bg-opacity-10 p-3"><i class="bi bi-lightning-charge text-danger fs-3"></i></div>

                        <div>

                            <div class="telecom-bento-kpi-label" data-telecom-i18n="backOffice.auditList.kpi.hlrToday">أوامر الشبكة (HLR) اليوم</div>

                            <div class="telecom-bento-kpi-value text-danger" v-text="state.summary.networkCommandsToday">0</div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="telecom-bento-span-4">

                <div class="telecom-bento-card h-100">

                    <div class="card-body d-flex align-items-center gap-3">

                        <div class="rounded-3 bg-success bg-opacity-10 p-3"><i class="bi bi-shield-check text-success fs-3"></i></div>

                        <div>

                            <div class="telecom-bento-kpi-label" data-telecom-i18n="backOffice.auditList.kpi.security">حالة الأمن والحوكمة</div>

                            <span class="telecom-duotone-badge duotone-success mt-1">

                                <span class="pulse-dot" aria-hidden="true"></span>

                                <span data-telecom-i18n="backOffice.auditList.kpi.securityStatus">نظام التدقيق: نشط وآمن</span>

                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>



        <div class="telecom-bento-card mb-3">

            <div class="card-body">

                <div class="row g-2 align-items-end">

                    <div class="col-lg-4 col-md-6">

                        <label class="form-label small text-muted" data-telecom-i18n="backOffice.auditList.filters.search">بحث</label>

                        <input type="search" class="form-control" v-model="state.filters.searchTerm" v-on:keyup.enter="handler.search" placeholder="حرفان على الأقل…" />

                    </div>

                    <div class="col-lg-3 col-md-6">

                        <label class="form-label small text-muted" data-telecom-i18n="backOffice.auditList.filters.actionType">نوع العملية</label>

                        <select class="form-select" v-model="state.filters.actionType">

                            <option value="">— الكل —</option>

                            <option v-for="opt in state.actionOptions" v-bind:key="opt.value" v-bind:value="opt.value" v-text="opt.label"></option>

                        </select>

                    </div>

                    <div class="col-md-2">

                        <label class="form-label small text-muted">من</label>

                        <input type="date" class="form-control" v-model="state.filters.fromDate" />

                    </div>

                    <div class="col-md-2">

                        <label class="form-label small text-muted">إلى</label>

                        <input type="date" class="form-control" v-model="state.filters.toDate" />

                    </div>

                    <div class="col-md-1">

                        <button type="button" class="btn btn-telecom-primary w-100" v-on:click="handler.search" v-bind:disabled="state.loading">

                            <i class="fas fa-search" v-bind:class="{ 'fa-spin': state.loading }"></i>

                        </button>

                    </div>

                </div>

            </div>

        </div>



        <div class="telecom-bento-card telecom-grid-panel bo-audit-grid-panel mb-0">

            <div class="card-body pt-2 pb-3">

                <div v-if="state.totalCount === 0 && !state.loading" class="text-center py-4 text-muted mb-2">

                    <i class="bi bi-journal-x display-6 d-block mb-2"></i>

                    <span>لا توجد عمليات مسجّلة لحسابك بعد. نفّذ بحثاً أو أمر شبكة ليظهر السجل هنا.</span>

                </div>

                <div class="grid-container">

                    <div ref="mainGridRef"></div>

                </div>

                <p class="small text-muted mt-2 mb-0" v-if="state.totalCount > 0">

                    إجمالي السجلات: <strong v-text="state.totalCount"></strong>

                    <span class="text-muted ms-2">(انقر مرتين لعرض الـ Payload)</span>

                </p>

            </div>

        </div>

    </div>

</div>



<div class="offcanvas offcanvas-start" tabindex="-1" id="auditDetailDrawer" style="width: min(480px, 100vw);">

    <div class="offcanvas-header border-bottom">

        <div>

            <h5 class="offcanvas-title fw-bold mb-1" id="auditDrawerTitle">—</h5>

            <span class="badge bg-light text-secondary font-monospace" id="auditDrawerTime">—</span>

        </div>

        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="إغلاق"></button>

    </div>

    <div class="offcanvas-body">

        <p class="small text-muted mb-2">الـ Payload الفني</p>

        <pre id="auditDrawerPre" class="bg-dark text-success p-3 rounded font-monospace mb-0" style="max-height:420px;overflow:auto;font-size:0.8rem;white-space:pre-wrap;"></pre>

    </div>

@await Html.PartialAsync("~/FrontEnd/Pages/Shared/AdminTemplate/_PortalPageShellEnd.cshtml")

@section styles {

    <link rel="stylesheet" href="~/css/audit-detail-modal.css" asp-append-version="true" />

}



@section Scripts {

    <script src="~/lib/indotalent/audit-detail-modal.js" asp-append-version="true"></script>

    <script src="~/FrontEnd/Pages/Telecom/BackOfficeAuditList.cshtml.js" asp-append-version="true"></script>

}

