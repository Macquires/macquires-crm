@page "/Telecom/UnifiedSearch"
@{
    ViewData["Title"] = "Unified search — Customer 360";
}
<link rel="stylesheet" href="~/css/telecom-premium-theme.css" asp-append-version="true" />
<style>
    #unified-search-page { min-height: 72vh; background: linear-gradient(180deg, var(--sys-bg) 0%, var(--sys-card-bg) 100%); }
    .us-hero-card { border: none; border-radius: 16px; box-shadow: 0 12px 40px rgba(15, 23, 42, 0.08); }
    .us-search-group:focus-within { box-shadow: 0 0 0 0.25rem rgba(220, 38, 38, 0.15); border-radius: 0.5rem; }
    .us-result-row { cursor: pointer; transition: background 0.12s ease; }
    .us-result-row:hover { background: var(--sys-brand-red-ring); }
    .us-result-row.selected { background: var(--sys-brand-red-ring); border-inline-start: 4px solid var(--sys-brand-red); }
    .us-tickets-card { border: none; border-radius: 14px; box-shadow: 0 8px 28px rgba(15, 23, 42, 0.06); }
    .us-ticket-row { cursor: pointer; transition: background 0.12s ease; }
    .us-ticket-row:hover { background: color-mix(in srgb, var(--sys-brand-red) 6%, var(--sys-card-bg)); }
    #searchResultModal .modal-content { border: none; border-radius: 14px; overflow: hidden; }
    #searchResultModal .modal-header { background: linear-gradient(90deg, var(--sys-text-main), color-mix(in srgb, var(--sys-text-main) 75%, var(--sys-text-muted))); color: var(--sys-card-bg); }
</style>

@{ ViewData["PortalPageVcloak"] = true; ViewData["PortalPageInner"] = false; }
@await Html.PartialAsync("~/FrontEnd/Pages/Shared/AdminTemplate/_PortalPageShell.cshtml")

    <div class="container-fluid py-4 py-lg-5" id="unified-search-page">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-10 col-xl-9">
                <div class="card us-hero-card mb-4">
                    <div class="card-body p-4 p-lg-5 text-center">
                        <p class="text-uppercase small text-muted mb-2">{{ ui.kicker }}</p>
                        <h1 class="h3 fw-bold text-danger mb-2">
                            <i class="fas fa-headset me-2"></i>{{ ui.title }}
                        </h1>
                        <p class="text-muted small mb-4">{{ ui.subtitle }}</p>
                        <div class="input-group input-group-lg us-search-group mx-auto" style="max-width: 640px;">
                            <span class="input-group-text bg-white border-end-0"><i class="fas fa-fingerprint text-danger"></i></span>
                            <input id="unifiedSearchInput" type="search" class="form-control border-start-0"
                                   v-model="state.searchTerm" :placeholder="ui.placeholder"
                                   autocomplete="off" dir="ltr" @@keyup.enter="runSearch" />
                            <button type="button" class="btn btn-danger px-4" :disabled="state.searchBusy" @@click="runSearch">
                                <span v-if="state.searchBusy" class="spinner-border spinner-border-sm"></span>
                                <span v-else><i class="fas fa-bolt me-1"></i> {{ ui.search }}</span>
                            </button>
                        </div>
                        <p v-if="state.inlineAlert" class="alert alert-warning small mt-3 mb-0 py-2" role="alert">{{ state.inlineAlert }}</p>
                        <p class="form-text small text-muted mt-3 mb-0">{{ ui.hintEnter }}</p>
                    </div>
                </div>

                <div v-if="ui.showMyTickets" class="card us-tickets-card mb-4">
                    <div class="card-header bg-white border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
                        <h2 class="h6 fw-bold mb-0 text-danger">
                            <i class="fas fa-ticket-alt me-2"></i>{{ ui.myTicketsTitle }}
                            <span v-if="state.myTickets.length" class="badge bg-danger ms-1">{{ state.myTickets.length }}</span>
                        </h2>
                        <button type="button" class="btn btn-outline-secondary btn-sm" :disabled="state.ticketsBusy" @@click="loadMyTickets">
                            <span v-if="state.ticketsBusy" class="spinner-border spinner-border-sm"></span>
                            <span v-else><i class="fas fa-sync-alt me-1"></i>{{ ui.refreshTickets }}</span>
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <div v-if="state.ticketsBusy && !state.myTickets.length" class="text-center py-4 text-muted">
                            <span class="spinner-border spinner-border-sm text-danger"></span>
                            <p class="small mb-0 mt-2">{{ ui.ticketsLoading }}</p>
                        </div>
                        <div v-else-if="!state.myTickets.length" class="text-center py-4 text-muted">
                            <i class="fas fa-inbox fa-2x mb-2 opacity-50"></i>
                            <p class="small mb-0">{{ ui.myTicketsEmpty }}</p>
                        </div>
                        <div v-else class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>{{ ui.colTicket }}</th>
                                        <th dir="ltr">{{ ui.colMsisdn }}</th>
                                        <th>{{ ui.colSubscriber }}</th>
                                        <th>{{ ui.colIssue }}</th>
                                        <th>{{ ui.colStatus }}</th>
                                        <th>{{ ui.colOpened }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr v-for="t in state.myTickets" :key="t.id" class="us-ticket-row" @@click="openTicketCustomer(t)">
                                        <td class="font-monospace small fw-semibold" dir="ltr">{{ t.ticketNumber }}</td>
                                        <td class="font-monospace small" dir="ltr">{{ t.msisdn }}</td>
                                        <td>{{ displaySubscriber(t) }}</td>
                                        <td class="small">{{ ticketIssueLabel(t.issueType) }}</td>
                                        <td><span class="badge" :class="ticketStatusBadge(t.status)">{{ ticketStatusLabel(t.status) }}</span></td>
                                        <td class="small text-muted">{{ formatTicketDate(t.createdAtUtc) }}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div v-if="ui.showHubLink" class="text-center">
                    <a href="/Telecom/TelecomHub" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-right me-1"></i> {{ ui.hubLink }}</a>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="searchResultModal" tabindex="-1" aria-labelledby="searchResultModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow-lg">
                <div class="modal-header border-0">
                    <h2 class="modal-title h5 mb-0" id="searchResultModalLabel">
                        <i class="fas fa-list-ul me-2"></i>{{ ui.modalTitle }}
                    </h2>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" :aria-label="ui.close"></button>
                </div>
                <div class="modal-body p-0">
                    <div v-if="state.searchBusy" class="text-center py-5">
                        <span class="spinner-border text-danger"></span>
                        <p class="small text-muted mt-2 mb-0">{{ ui.loading }}</p>
                    </div>
                    <div v-else-if="state.modalError" class="text-center py-5 text-danger">
                        <i class="fas fa-exclamation-circle fa-2x mb-2 opacity-75"></i>
                        <p class="mb-0 small">{{ state.modalError }}</p>
                    </div>
                    <div v-else-if="!state.results.length" class="text-center py-5 text-muted">
                        <i class="fas fa-inbox fa-2x mb-2 opacity-50"></i>
                        <p class="mb-0 small">{{ ui.noResults }}</p>
                    </div>
                    <div v-else class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:2.5rem;"></th>
                                    <th>{{ ui.colSubscriber }}</th>
                                    <th>{{ ui.colId }}</th>
                                    <th dir="ltr">{{ ui.colMsisdn }}</th>
                                    <th>{{ ui.colStatus }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-for="row in state.results" :key="rowKey(row)"
                                    class="us-result-row"
                                    :class="{ selected: state.selectedCustomerId === pickCustomerId(row) }"
                                    @@click="selectRow(row)"
                                    @@dblclick="openProfileRow(row)">
                                    <td class="text-center">
                                        <input class="form-check-input" type="radio" name="usPick"
                                               :checked="state.selectedCustomerId === pickCustomerId(row)"
                                               @@click.stop="selectRow(row)" />
                                    </td>
                                    <td class="fw-semibold">{{ displayName(row) }}</td>
                                    <td class="small font-monospace" dir="ltr">{{ row.nationalId || row.NationalId || '—' }}</td>
                                    <td class="small font-monospace">{{ row.msisdn || row.Msisdn || '—' }}</td>
                                    <td><span class="badge bg-light text-dark border">{{ row.status || row.Status || '—' }}</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer border-top bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ ui.close }}</button>
                    <button type="button" class="btn btn-primary btn-load-360-profile"
                            :disabled="!state.selectedCustomerId"
                            @@click="redirectToFullProfile">
                        <i class="fas fa-user-shield me-1"></i> {{ ui.openProfile }}
                    </button>
                </div>
            </div>
        </div>
    </div>
@await Html.PartialAsync("~/FrontEnd/Pages/Shared/AdminTemplate/_PortalPageShellEnd.cshtml")

@section Scripts {
    <script src="~/FrontEnd/Pages/Telecom/UnifiedSearch.cshtml.js" asp-append-version="true"></script>
}
