                        <label class="form-label small fw-semibold">{{ telecomT('simSwap.replacementReason', 'Reason') }} <span class="text-danger">*</span></label>
                        <select class="form-select form-select-sm" v-model="lineActionModal.simReplacementReason" :disabled="lineActionModal.busy">
                            <option value="">{{ telecomT('common.selectPlaceholder', '— Select —') }}</option>
                            <option value="Damaged">{{ telecomT('simSwap.reasonDamaged', 'Damaged') }}</option>
                            <option value="Upgrade5G">{{ telecomT('simSwap.reasonUpgrade', '5G') }}</option>
                            <option value="Other">{{ telecomT('simSwap.reasonOther', 'Other') }}</option>
                        </select>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="simLostStolenList" v-model="lineActionModal.simLostOrStolen" :disabled="lineActionModal.busy" />
                        <label class="form-check-label small" for="simLostStolenList">{{ telecomT('simSwap.lostOrStolen', 'Lost/stolen') }}</label>
                    </div>
                    <p v-if="lineActionModal.simLostOrStolen" class="small text-warning mb-2">{{ telecomT('simSwap.lostOrStolenHint', '') }}</p>
                    <div v-if="lineActionModal.simLostOrStolen" class="mb-2">
                        <label class="form-label small fw-semibold">{{ telecomT('simSwap.identityRequired', 'ID') }} <span class="text-danger">*</span></label>
                        <input type="file" class="form-control form-control-sm" accept=".pdf,.jpg,.jpeg,.png,.webp" v-on:change="onSimSwapIdentityFileChange" :disabled="lineActionModal.busy" />
                    </div>
                    <label class="form-label small">{{ telecomT('c360.simIccid', 'ICCID') }}</label>
                    <input type="text" class="form-control font-monospace" dir="ltr" maxlength="19" v-model="lineActionModal.simIccid" :disabled="lineActionModal.busy" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" :disabled="lineActionModal.busy">{{ telecomT('common.cancel', 'Cancel') }}</button>
                    <button type="button" class="btn btn-danger" :disabled="lineActionModal.busy" v-on:click="submitSimSwap">
                        <span v-if="lineActionModal.busy" class="spinner-border spinner-border-sm me-1"></span>
                        {{ lineActionModal.simLostOrStolen ? telecomT('common.sendBackOffice', 'Back office') : telecomT('c360.confirmSimSwap', 'Confirm') }}
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="C360TakeOverModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ telecomT('wizard.titles.takeover', 'Transfer') }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-2" dir="ltr">{{ telecomT('c360.lineLabel', 'Line') }}: {{ lineActionModal.sub?.msisdn }}</p>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <input type="text" class="form-control form-control-sm" v-model="lineActionModal.takeoverSearchNationalId" :placeholder="telecomT('onboarding.nationalId', 'National ID')" />
                        </div>
                        <div class="col-md-6">
                            <input type="text" class="form-control form-control-sm" v-model="lineActionModal.takeoverSearchPhone" :placeholder="telecomT('onboarding.msisdnPh', 'MSISDN')" />
                        </div>
                        <div class="col-12">
                            <button type="button" class="btn btn-outline-danger btn-sm" :disabled="lineActionModal.busy" v-on:click="searchTakeoverTarget">{{ telecomT('c360.searchNewOwner', 'Search') }}</button>
                        </div>
                    </div>
                    <ul class="list-group list-group-flush border rounded mb-2" v-if="lineActionModal.takeoverResults.length">
                        <li v-for="c in lineActionModal.takeoverResults" :key="c.id" class="list-group-item list-group-item-action small" :class="{ active: lineActionModal.takeoverTargetCustomerId === c.id }" v-on:click="selectTakeoverTarget(c)" style="cursor:pointer">
                            {{ c.name }} · {{ c.phoneNumber || '—' }}
                        </li>
                    </ul>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">{{ telecomT('takeOver.transferReason', 'Reason') }} <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" v-model="lineActionModal.takeoverTransferReason" maxlength="256" :placeholder="telecomT('takeOver.transferReasonPh', '')" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">{{ telecomT('takeOver.depositPolicy', 'Deposit') }}</label>
                            <select class="form-select form-select-sm" v-model.number="lineActionModal.takeoverDepositPolicy">
                                <option :value="1">{{ telecomT('takeOver.depositTransfer', 'Transfer') }}</option>
                                <option :value="0">{{ telecomT('takeOver.depositRetain', 'Retain') }}</option>
                                <option :value="2">{{ telecomT('takeOver.depositForfeit', 'Forfeit') }}</option>
                                <option :value="3">{{ telecomT('takeOver.depositRefund', 'Refund') }}</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">{{ telecomT('takeOver.identityRequired', 'ID') }} <span class="text-danger">*</span></label>
                        <input type="file" class="form-control form-control-sm" accept=".pdf,.jpg,.jpeg,.png,.webp"
                               v-on:change="onTakeoverIdentityFileChange" />
                    </div>
                    <p v-if="lineActionModal.takeoverTargetProfileId" class="small text-success mb-0">{{ telecomT('c360.takeoverAfterSubmit', '') }}</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" :disabled="lineActionModal.busy">{{ telecomT('common.cancel', 'Cancel') }}</button>
                    <button type="button" class="btn btn-danger" :disabled="lineActionModal.busy || !lineActionModal.takeoverTargetProfileId || !lineActionModal.takeoverIdentityFile" v-on:click="submitTakeOver">
                        <span v-if="lineActionModal.busy" class="spinner-border spinner-border-sm me-1"></span>{{ telecomT('c360.uploadIdSubmit', 'Submit') }}
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="C360SuspensionModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title text-danger">{{ telecomT('wizard.titles.suspension', 'Suspension') }}</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <p class="small text-muted mb-2" dir="ltr">{{ telecomT('c360.lineLabel', 'Line') }}: {{ lineActionModal.sub?.msisdn }}</p>
                    <select class="form-select form-select-sm mb-2" v-model="lineActionModal.susSuspensionType" v-on:change="onSusTypeChangeList" :disabled="lineActionModal.busy">
                        <option value="CustomerRequest">{{ telecomT('suspension.typeCustomer', 'Customer') }}</option><option value="Billing">{{ telecomT('suspension.typeBilling', 'Billing') }}</option><option value="Fraud">{{ telecomT('suspension.typeFraud', 'Fraud') }}</option><option value="Regulatory">{{ telecomT('suspension.typeRegulatory', 'Regulatory') }}</option><option value="Operational">{{ telecomT('suspension.typeOperational', 'Operational') }}</option>
                    </select>
                    <select class="form-select form-select-sm mb-2" v-model="lineActionModal.susBarringLevel" :disabled="lineActionModal.busy">
                        <option value="Full">{{ telecomT('suspension.barringFull', 'Full') }}</option><option value="InboundOnly">{{ telecomT('suspension.barringInbound', 'Inbound') }}</option><option value="OutboundOnly">{{ telecomT('suspension.barringOutbound', 'Outbound') }}</option>
                    </select>
                    <input type="text" class="form-control form-control-sm mb-2" v-model="lineActionModal.susSuspensionReason" :placeholder="telecomT('suspension.suspensionReason', 'Reason') + ' *'" :disabled="lineActionModal.busy" />
                    <div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="susAutoList" v-model="lineActionModal.susAutoReconnectEnabled" /><label class="form-check-label small" for="susAutoList">{{ telecomT('suspension.autoReconnect', 'Auto-reconnect') }}</label></div>
                    <input v-if="lineActionModal.susAutoReconnectEnabled" type="datetime-local" class="form-control form-control-sm mb-2" v-model="lineActionModal.susEndDateLocal" />
                    <div v-if="lineActionModal.susRequiresBackOffice" class="alert alert-warning py-2 small mb-0">{{ telecomT('suspension.boHint', '') }}</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" :disabled="lineActionModal.busy">{{ telecomT('common.cancel', 'Cancel') }}</button>
                    <button type="button" class="btn btn-danger" :disabled="lineActionModal.busy" v-on:click="submitSuspension"><span v-if="lineActionModal.busy" class="spinner-border spinner-border-sm me-1"></span>{{ lineActionModal.susRequiresBackOffice ? telecomT('common.sendBackOffice', 'Back office') : telecomT('c360.confirmSuspend', 'Confirm') }}</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="C360ReconnectModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title text-danger">{{ telecomT('wizard.titles.reconnect', 'Reconnect') }}</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <p class="small text-muted mb-2" dir="ltr">{{ telecomT('c360.lineLabel', 'Line') }}: {{ lineActionModal.sub?.msisdn }}</p>
                    <select class="form-select form-select-sm mb-2" v-model="lineActionModal.rcnClearanceType" v-on:change="loadListReconnectEligibility" :disabled="lineActionModal.busy">
                        <option value="Customer">{{ telecomT('reconnect.clearanceCustomer', 'Customer') }}</option><option value="Payment">{{ telecomT('reconnect.clearancePayment', 'Payment') }}</option><option value="Fraud">{{ telecomT('reconnect.clearanceFraud', 'Fraud') }}</option><option value="Regulatory">{{ telecomT('reconnect.clearanceRegulatory', 'Regulatory') }}</option>
                    </select>
                    <input type="text" class="form-control form-control-sm mb-2" v-model="lineActionModal.rcnReconnectReason" :placeholder="telecomT('reconnect.reconnectReason', 'Reason') + ' *'" v-on:blur="loadListReconnectEligibility" />
                    <input v-if="lineActionModal.rcnClearanceType === 'Payment'" type="text" class="form-control form-control-sm mb-2" v-model="lineActionModal.rcnPaymentReference" :placeholder="telecomT('reconnect.paymentReference', 'Payment ref') + ' *'" v-on:blur="loadListReconnectEligibility" />
                    <div v-if="lineActionModal.rcnEligibilityBusy" class="small text-muted">{{ telecomT('reconnect.matrixLoading', 'Checking…') }}</div>
                    <div v-else-if="lineActionModal.rcnEligibility" class="alert py-2 small mb-2" :class="(lineActionModal.rcnEligibility.allowed || lineActionModal.rcnEligibility.Allowed) ? 'alert-success' : 'alert-danger'">{{ lineActionModal.rcnEligibility.messageAr || lineActionModal.rcnEligibility.MessageAr }}</div>
                    <div v-if="lineActionModal.rcnRequiresBackOffice" class="form-check mb-0"><input class="form-check-input" type="checkbox" id="rcnFraudList" v-model="lineActionModal.rcnFraudClearanceConfirmed" v-on:change="loadListReconnectEligibility" /><label class="form-check-label small" for="rcnFraudList">{{ telecomT('reconnect.fraudClearance', 'Fraud clearance') }}</label></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" :disabled="lineActionModal.busy">{{ telecomT('common.cancel', 'Cancel') }}</button>
                    <button type="button" class="btn btn-danger" :disabled="lineActionModal.busy" v-on:click="submitReconnect"><span v-if="lineActionModal.busy" class="spinner-border spinner-border-sm me-1"></span>{{ lineActionModal.rcnRequiresBackOffice ? telecomT('common.sendBackOffice', 'Back office') : telecomT('c360.confirmReconnect', 'Confirm') }}</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="C360RefundModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">{{ telecomT('wizard.titles.refund', 'Refund') }}</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <select class="form-select form-select-sm mb-2" v-model="lineActionModal.rfdRefundType" v-on:change="onRefundTypeChangeList">
                        <option value="Deposit">{{ telecomT('refund.typeDeposit', 'Deposit') }}</option><option value="WalletBalance">{{ telecomT('refund.typeWallet', 'Wallet') }}</option><option value="Overpayment">{{ telecomT('refund.typeOverpayment', 'Overpayment') }}</option><option value="SyriatelCash">{{ telecomT('refund.typeSyriatelCash', 'Syriatel Cash') }}</option>
                    </select>
                    <select class="form-select form-select-sm mb-2" v-model="lineActionModal.rfdRefundMethod">
                        <option value="CreditNote">{{ telecomT('refund.methodCreditNote', 'Credit note') }}</option><option value="WalletCredit">{{ telecomT('refund.methodWallet', 'Wallet') }}</option><option value="BankTransfer">{{ telecomT('refund.methodBank', 'Bank') }}</option><option value="Cash">{{ telecomT('refund.methodCash', 'Cash') }}</option>
                    </select>
                    <input type="number" min="1" class="form-control form-control-sm mb-2" v-model="lineActionModal.rfdRefundAmount" :placeholder="telecomT('refund.refundAmount', 'Amount') + ' *'" />
                    <input type="text" class="form-control form-control-sm mb-2" v-model="lineActionModal.rfdRefundReason" :placeholder="telecomT('refund.refundReason', 'Reason') + ' *'" />
                    <div v-if="lineActionModal.rfdRequiresBackOffice"><input type="file" class="form-control form-control-sm" accept=".pdf,.jpg,.jpeg,.png,.webp" v-on:change="onRefundIdentityFileChange" :disabled="lineActionModal.busy" /></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" :disabled="lineActionModal.busy">{{ telecomT('common.cancel', 'Cancel') }}</button>
                    <button type="button" class="btn btn-danger" :disabled="lineActionModal.busy" v-on:click="submitRefund"><span v-if="lineActionModal.busy" class="spinner-border spinner-border-sm me-1"></span>{{ lineActionModal.rfdRequiresBackOffice ? telecomT('common.sendBackOffice', 'Back office') : telecomT('c360.confirmRefund', 'Confirm') }}</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="C360BadDebtModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">{{ telecomT('wizard.titles.badDebt', 'Collections') }}</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <select class="form-select form-select-sm mb-2" v-model="lineActionModal.bdrCollectionAction" v-on:change="loadListBadDebtEligibility">
                        <option value="PaymentRecorded">{{ telecomT('badDebt.actionPayment', 'Payment') }}</option><option value="DunningEscalation">{{ telecomT('badDebt.actionDunning', 'Dunning') }}</option><option value="WriteOffPartial">{{ telecomT('badDebt.actionWriteOffPartial', 'Partial write-off') }}</option><option value="WriteOffFull">{{ telecomT('badDebt.actionWriteOffFull', 'Full write-off') }}</option>
                    </select>
                    <div v-if="lineActionModal.bdrCollectionAction === 'PaymentRecorded'">
                        <input type="text" class="form-control form-control-sm mb-2" v-model="lineActionModal.bdrPaymentReference" :placeholder="telecomT('badDebt.paymentReference', 'Payment ref')" v-on:blur="loadListBadDebtEligibility" />
                        <input type="number" min="1" class="form-control form-control-sm mb-2" v-model="lineActionModal.bdrCollectedAmount" :placeholder="telecomT('badDebt.collectedAmount', 'Amount')" v-on:blur="loadListBadDebtEligibility" />
                    </div>
                    <div v-if="lineActionModal.bdrEligibilityBusy" class="small text-muted">{{ telecomT('reconnect.matrixLoading', 'Checking…') }}</div>
                    <div v-else-if="lineActionModal.bdrEligibility" class="alert py-2 small mb-0" :class="(lineActionModal.bdrEligibility.allowed || lineActionModal.bdrEligibility.Allowed) ? 'alert-success' : 'alert-danger'">{{ lineActionModal.bdrEligibility.messageAr || lineActionModal.bdrEligibility.MessageAr }}</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" :disabled="lineActionModal.busy">{{ telecomT('common.cancel', 'Cancel') }}</button>
                    <button type="button" class="btn btn-danger" :disabled="lineActionModal.busy" v-on:click="submitBadDebt"><span v-if="lineActionModal.busy" class="spinner-border spinner-border-sm me-1"></span>{{ lineActionModal.bdrRequiresBackOffice ? telecomT('common.sendBackOffice', 'Back office') : telecomT('c360.confirmCollection', 'Confirm') }}</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
