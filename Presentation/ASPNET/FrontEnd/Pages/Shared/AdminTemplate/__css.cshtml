<style>
    /* CUSTOM */

    body {
        font-family: 'Tajawal', 'Almarai', 'Segoe UI', system-ui, sans-serif;
    }

    /*Form Group*/
    .form-group{
        margin-top: 10px;
    }

    /* For Syncfusion Grid */
    .grid-container .e-gridcontent {
        cursor: pointer;
    }

    .e-grid .e-row.e-altrow {
        background-color: var(--sys-bg);
    }

    .e-headertext {
        padding-left: 5px;
    }
    html[dir="rtl"] .e-headertext {
        padding-left: 0;
        padding-right: 5px;
    }
    .e-grid .e-gridpager .e-currentitem {
        background-color: var(--primary);
        color: var(--sys-card-bg) !important;
    }

    .e-grid .e-gridpager .e-numericitem {
        color: var(--primary);
    }

    /* Modal header: keep title at inline-start, close (X) at inline-end (LTR + RTL) */
    .modal .modal-header {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 0.5rem;
    }
    .modal .modal-header .modal-title {
        margin-bottom: 0;
        min-width: 0;
    }
    .modal .modal-header .btn-close {
        flex-shrink: 0;
        padding: 0.5rem;
        margin-block: -0.5rem;
        margin-inline-end: -0.5rem;
        margin-inline-start: auto;
    }

    /* Offcanvas header: title at inline-start, close (X) at inline-end (LTR + RTL) */
    .offcanvas-header {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 0.5rem;
    }
    .offcanvas-header .offcanvas-title {
        margin-bottom: 0;
        min-width: 0;
    }
    .offcanvas-header .btn-close {
        flex-shrink: 0;
        padding: 0.5rem;
        margin-block: -0.5rem;
        margin-inline-end: -0.5rem;
        margin-inline-start: auto;
    }

    /* RTL: all Bootstrap modals — direction, header, form rows, Ej2 */
    html[dir="rtl"] .modal .modal-content {
        direction: rtl;
        text-align: right;
    }
    html[dir="rtl"] .modal-header {
        text-align: right;
    }
    html[dir="rtl"] .modal-footer {
        flex-direction: row-reverse;
        justify-content: flex-start;
    }
    html[dir="rtl"] .modal form#MainForm .row,
    html[dir="rtl"] .modal #ComplexDiv > .row {
        flex-direction: row-reverse;
        flex-wrap: wrap;
    }
    html[dir="rtl"] .modal .card-header h5,
    html[dir="rtl"] .modal .card-header,
    html[dir="rtl"] .modal label:not(.form-check-label) {
        text-align: right;
    }
    html[dir="rtl"] .modal .form-control,
    html[dir="rtl"] .modal textarea {
        text-align: right;
    }
    html[dir="rtl"] .modal .d-flex.justify-content-between {
        flex-direction: row-reverse;
    }
    html[dir="rtl"] .modal .text-danger {
        display: block;
        text-align: right;
    }
    html[dir="rtl"] .modal .e-control-wrapper,
    html[dir="rtl"] .modal .e-input-group,
    html[dir="rtl"] .modal .e-ddl,
    html[dir="rtl"] .modal .e-datepicker {
        direction: rtl;
    }
    html[dir="rtl"] .modal .e-input-group input.e-input,
    html[dir="rtl"] .modal .e-input-group textarea.e-input {
        text-align: right;
    }

    .e-contextmenu-wrapper ul .e-menu-item.e-selected, .e-contextmenu-container ul .e-menu-item.e-selected {
        background-color: var(--primary);
        color: var(--sys-card-bg);
        outline: 0 solid var(--primary);
        outline-offset: 0;
    }

    .e-checkbox-wrapper .e-frame.e-stop, .e-css.e-checkbox-wrapper .e-frame.e-stop {
        background-color: var(--primary);
        border-color: var(--primary);
        color: var(--sys-card-bg);
    }

    .e-checkbox-wrapper .e-frame.e-check, .e-css.e-checkbox-wrapper .e-frame.e-check {
        background-color: var(--primary);
        border-color: var(--primary);
        color: var(--sys-card-bg);
    }

    .e-treeview .e-list-item.e-hover > .e-text-content .e-icon-collapsible {
        color: var(--sys-card-bg);
    }

    .e-treeview .e-list-item.e-hover > .e-text-content .e-icon-expandable {
        color: var(--sys-card-bg);
    }

    .e-treeview .e-list-item.e-hover > .e-text-content .e-list-text {
        color: var(--sys-card-bg);
    }

    .e-treeview .e-list-item.e-active.e-animation-active > .e-text-content .e-list-text {
        color: var(--sys-card-bg);
    }

    .e-treeview .e-list-item.e-active > .e-text-content {
        background-color: var(--sys-brand-red);
        color: var(--sys-card-bg);
    }

    .e-treeview .e-list-item.e-active > .e-fullrow {
        background-color: var(--sys-brand-red);
        border-color: var(--sys-brand-red);
    }

    .e-treeview .e-list-item.e-active.e-animation-active > .e-fullrow {
        background-color: var(--sys-brand-red);
        border-color: var(--sys-brand-red);
    }

    .e-treeview .e-list-item.e-hover > .e-fullrow {
        background-color: var(--sys-brand-red);
        border-color: var(--sys-brand-red);
    }

    .e-treeview .e-list-item.e-active.e-hover > .e-fullrow {
        background-color: var(--sys-brand-red);
        border-color: var(--sys-brand-red);
        color: var(--sys-card-bg);
    }

    .e-treeview .e-list-text {
        color: var(--dark);
        font-size: 14px;
    }

    .e-filemanager .e-treeview .e-list-item.e-active > .e-text-content {
        background-color: var(--primary);
        color: var(--sys-card-bg);
    }

    .e-filemanager .e-treeview .e-list-item.e-active > .e-fullrow {
        background-color: var(--primary);
        border-color: var(--primary);
    }

    .e-filemanager .e-treeview .e-list-item.e-hover > .e-fullrow {
        background-color: var(--primary);
        border-color: var(--primary);
    }

    .e-filemanager .e-treeview .e-list-item.e-active.e-hover > .e-fullrow {
        background-color: var(--primary);
        border-color: var(--primary);
        color: var(--sys-card-bg);
    }

    .e-filemanager .e-grid td.e-active {
        background-color: var(--primary);
    }

    .e-filemanager .e-gridcontent {
        cursor: pointer;
    }

    .e-dropdownbase .e-list-item.e-item-focus, .e-dropdownbase .e-list-item.e-active, .e-dropdownbase .e-list-item.e-active.e-hover, .e-dropdownbase .e-list-item.e-hover {
        background-color: var(--primary);
        color: var(--sys-card-bg);
    }

    .e-schedule .e-timeline-view .e-appointment, .e-schedule .e-timeline-month-view .e-appointment {
        cursor: pointer;
    }

    .e-schedule .e-agenda-view .e-appointment {
        border-left: 0px solid var(--primary);
        cursor: pointer;
    }

    .e-quick-popup-wrapper .e-event-popup .e-popup-header .e-subject-wrap .e-subject {
        border-left: 6px solid var(--primary);
    }

    .e-btn.e-primary, .e-css.e-btn.e-primary {
        background-color: var(--primary);
        border-color: var(--primary);
        color: var(--sys-card-bg);
    }

    .e-footer-content .e-btn.e-primary.e-flat:not([DISABLED]) {
        background-color: var(--primary);
        border-color: var(--primary);
        color: var(--sys-card-bg);
    }

    /*BS Navbar*/


    .nav-tabs .nav-item .nav-link {
        font-size: 0.9rem; 
        padding: 0.3rem 0.5rem; 
    }

    .e-input-group, .e-input-group.e-control-wrapper {
        border-radius: 0px;
    }

        .e-input-group.e-control-wrapper.e-disabled input.e-input {
            background: var(--light);
        }

    /* Fieldset */
    fieldset {
        background-color: var(--sys-card-bg);
        width: 100%;
        padding: 15px;
        margin-left: 0px;
        margin-right: 0px;
        margin-top: 10px;
        margin-bottom: 10px;
        border: 1px solid var(--sys-border);
    }


    /* For FormCard */
    .form-card {
        border: 1px solid var(--sys-border);
        width: 100%;
        overflow-y: auto;
    }

    .form-card-header {
        background-color: var(--sys-card-bg); 
        color: var(--sys-text-main); 
        padding: 10px;
        border-top-left-radius: 5px;
        border-top-right-radius: 5px;
        text-align: left; 
    }

    .form-card-body {
        background-color: var(--sys-card-bg); 
        padding-top: 5px;
        padding-right: 0;
        padding-bottom: 5px;
        padding-left: 0px;
    }

    .form-card-footer {
        background-color: var(--sys-card-bg); 
        color: var(--sys-text-main);
        padding-top: 5px;
        padding-right: 0;
        padding-bottom: 5px;
        padding-left: 0px;
        border-bottom-left-radius: 5px;
        border-bottom-right-radius: 5px;
        text-align: left; 
    }

    .form-label {
        margin-bottom: 0px;
        font-size: 0.875em;
    }

    .form-group {
        margin-top: 0px;
    }

    html, body {
        overflow-x: hidden;
        overflow-y: auto;
    }

    .sticky-top {
        z-index: 900 !important;
    }

    .content .navbar .navbar-nav .dropdown-item {
        background-color: transparent !important;
    }

    .small-italic-left {
        font-size: small; 
        font-style: italic; 
        text-align: left; 
        margin-bottom: -10px;
        margin-left: 0px;
        padding-top: 10px;
    }

    .small-italic {
        font-size: small;
        font-style: italic;
        position: relative;
        margin: 10px;
    }

        .small-italic::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            border-bottom: 1px solid var(--sys-border);
        }


    .adminheader {

    }

    .adminbody{
        padding: 0px;
    }

    .adminfooter {
        position: fixed;
        bottom: 0;
        width: 100%;
    }
</style>
<style>
    /* Sidebar scroll — blends with menu (see syr-tel-portal.css) */

</style>
<style>
    /* CSS scrollbar other */
    ::-webkit-scrollbar {
        width: 12px;
        height: 12px;
    }

    ::-webkit-scrollbar-track {
        background-color: var(--sys-bg);
    }

    ::-webkit-scrollbar-thumb {
        background-color: var(--sys-border);
        border-radius: 6px;
        border: 3px solid var(--sys-bg);
        transition: filter 0.3s;
    }

        ::-webkit-scrollbar-thumb:hover {
            cursor: pointer;
            background-color: var(--primary);
        }

</style>
<style>
    #navbarnav {
        width: 100%;
        overflow: visible;
    }

    a {
        color: var(--primary);
    }

    .nav-link {
        color: var(--primary);
    }

    .text-primary {
        color: var(--primary) !important;
    }

    body.syr-tel-portal .adminbody {
        background: var(--sys-bg) !important;
    }

    .syriatel-brand-accent {
        color: var(--sys-brand-red) !important;
    }

    .topbar-currency-pill {
        display: inline-flex;
        align-items: center;
        font-size: 0.7rem;
        padding: 0.25rem 0.65rem;
        border-radius: 999px;
        background: var(--sys-bg);
        border: 1px solid var(--sys-border);
        color: var(--sys-text-muted);
        font-weight: 500;
        letter-spacing: 0.04em;
        max-width: 10rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .topbar-currency-pill .sy-currency-code {
        color: var(--sys-text-muted);
        font-weight: 600;
    }

    .syriatel-unified-header {
        min-height: 52px;
        border-color: var(--sys-border) !important;
        box-shadow: var(--sys-shadow-card) !important;
    }

    .syriatel-header-brand:hover .syriatel-header-title {
        color: var(--sys-brand-red);
    }

    .syriatel-header-logo {
        height: auto;
        width: auto;
        max-height: 44px;
        max-width: 200px;
        object-fit: contain;
    }

    .syriatel-header-title {
        font-family: 'Almarai', 'Tajawal', sans-serif;
        font-weight: 800;
        font-size: clamp(0.85rem, 2vw, 1.15rem);
        color: var(--sys-text-main);
        letter-spacing: 0.02em;
        line-height: 1.2;
    }

    .syriatel-sidebar-logo {
        max-height: 52px;
        width: auto;
        max-width: 100%;
        object-fit: contain;
    }

    .syriatel-lang-toggle .btn {
        font-size: 0.72rem;
        padding: 0.2rem 0.45rem;
        border-color: var(--sys-border);
        color: var(--sys-text-muted);
    }

    .syriatel-lang-toggle .btn.active {
        background: var(--sys-bg) !important;
        border-color: var(--sys-border) !important;
        color: var(--sys-text-main) !important;
    }

    /* Clean vector map + pulsing status nodes */
    .syriatel-map-vector {
        position: relative;
        height: 220px;
        border-radius: 0.5rem;
        overflow: hidden;
        border: 1px solid var(--sys-border);
        background-color: var(--sys-bg);
        background-image: url('/brand/syriatel-map-grid.svg');
        background-size: cover;
        background-position: center;
    }

    .syriatel-map-dot {
        position: absolute;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: var(--sys-brand-red);
        border: 2px solid var(--sys-card-bg);
        box-shadow: 0 0 0 0 var(--sys-brand-red-ring);
        animation: syriatel-map-pulse 1.85s ease-in-out infinite;
    }

    .syriatel-map-dot--delay {
        animation-delay: 0.6s;
    }

    .syriatel-map-dot--delay2 {
        animation-delay: 1.1s;
    }

    .syriatel-map-dot--muted {
        background: var(--sys-text-muted);
        box-shadow: 0 0 0 0 var(--sys-brand-red-ring);
        animation: syriatel-map-pulse-muted 2.2s ease-in-out infinite;
    }

    @@keyframes syriatel-map-pulse {
        0%, 100% { transform: scale(1); opacity: 1; box-shadow: 0 0 0 0 var(--sys-brand-red-ring); }
        50% { transform: scale(1.2); opacity: 0.92; box-shadow: 0 0 0 12px transparent; }
    }

    @@keyframes syriatel-map-pulse-muted {
        0%, 100% { opacity: 0.85; }
        50% { opacity: 0.45; }
    }

    /* RTL / LTR: sidebar mirror + unified header + hub (admin template uses physical left/margins) */
    #sidebar,
    .content {
        transition: transform 0.28s ease, margin 0.28s ease, margin-inline 0.28s ease, padding-inline 0.28s ease;
    }

    /* Sidebar position + content margins: syr-tel-portal.css (margin-inline-*) */

    /* Sidebar nav: logical alignment + mirrored “pill” borders */
    html[dir="rtl"] .sidebar .navbar,
    html[dir="rtl"] .sidebar .navbar-nav,
    html[dir="rtl"] .sidebar #mainMenuContainer,
    html[dir="rtl"] .sidebar #mainMenu {
        text-align: start;
    }

    html[dir="rtl"] .sidebar .navbar .navbar-nav .nav-link {
        border-left: none !important;
        border-right: 3px solid var(--light);
        border-radius: 30px 0 0 30px;
    }

    html[dir="rtl"] .sidebar .navbar .navbar-nav .nav-link:hover,
    html[dir="rtl"] .sidebar .navbar .navbar-nav .nav-link.active {
        border-color: var(--primary);
    }

    html[dir="rtl"] .sidebar .navbar .dropdown-item {
        padding-left: 10px;
        padding-right: 25px;
        border-radius: 30px 0 0 30px;
    }

    html[dir="rtl"] .sidebar .navbar .dropdown-toggle::after {
        right: auto;
        left: 15px;
    }

    html[dir="rtl"] .content .navbar .navbar-nav .nav-link {
        margin-left: 0 !important;
        margin-right: 25px;
    }

    html[dir="rtl"] .content .navbar .dropdown-toggle::after {
        margin-left: 0;
        margin-right: 6px;
    }

    @@media (max-width: 575.98px) {
        html[dir="rtl"] .content .navbar .navbar-nav .nav-link {
            margin-left: 0 !important;
            margin-right: 15px;
        }
    }

    /* Top navbar: rely on dir=rtl flex + logical margins (avoid row-reverse fighting native RTL order) */
    html[dir="rtl"] .syriatel-unified-header {
        direction: rtl;
        text-align: start;
    }

    html[dir="rtl"] .syriatel-unified-header .syriatel-header-main,
    html[dir="rtl"] .syriatel-unified-header .syriatel-header-actions {
        flex-direction: row;
    }

    html[dir="rtl"] .syriatel-unified-header .syriatel-header-brand {
        margin-inline-start: 0.5rem;
        margin-inline-end: 0;
    }

    html[dir="ltr"] .syriatel-unified-header .syriatel-header-brand {
        margin-inline-start: 0.5rem;
    }

    html[dir="rtl"] .syriatel-unified-header .dropdown-menu {
        text-align: start;
    }

    html[dir="rtl"] .syriatel-unified-header .nav-link.dropdown-toggle {
        flex-direction: row;
    }
    html[dir="rtl"] .telecom-hub-root .telecom-search-group .input-group-text {
        border-radius: 0 0.5rem 0.5rem 0;
    }
    html[dir="ltr"] .telecom-hub-root .telecom-search-group .input-group-text {
        border-radius: 0.5rem 0 0 0.5rem;
    }

</style>


@* smaller form *@
<style>
    .select2-container--bootstrap-5 .select2-results__option {
        font-size: 0.9rem !important;
        line-height: 1.5 !important;
    }

    form input.form-control,
    form textarea.form-control,
    form select.form-control,
    .select2-container--bootstrap-5 .select2-selection {
        height: calc(1.5em + 0.75rem + 2px);
        padding: 0.375rem 0.75rem;
        font-size: 0.9rem;
        line-height: 1.5;
        border-radius: 0.25rem;
        box-shadow: none; 
        border: 1px solid var(--sys-border); 
    }

    form textarea.form-control {
        height: auto;
    }

    form .row.mb-3 {
        margin-bottom: 0.5rem;
    }

    .card-header h5 {
        font-size: 1rem;
        margin-bottom: 0;
    }

    .card-body {
        padding: 0.75rem;
    }

</style>



