@using System.Globalization
@{
    var userEmail = "Loading...";
    var avatarUrl = "/noimage.png";
    var uiLang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var uiRtl = string.Equals(uiLang, "ar", StringComparison.OrdinalIgnoreCase);
}

<div id="sidebar" class="sidebar syr-sidebar" dir="@(uiRtl ? "rtl" : "ltr")" lang="@uiLang">
    <div class="syr-sidebar-top">
        <div class="syr-sidebar-brand-block pt-3 pb-2 px-3">
            <a id="syrBrandHome" href="/Dashboards/DefaultDashboard" class="syr-sidebar-brand-link text-decoration-none">
                <img src="@Url.Content("~/brand/logo.png")"
                     alt="Syriatel"
                     class="syr-sidebar-logo"
                     width="120"
                     height="38"
                     loading="eager" />
            </a>
            <div class="syr-sidebar-divider" aria-hidden="true"></div>
            <span id="syrPersonaChip" class="syr-persona-chip">—</span>
        </div>

        <button type="button" class="syr-omni-trigger" data-syr-omni-open="1" aria-label="Omni-Search">
            <i class="bi bi-search"></i>
            <span data-syr-omni-open-label>@(uiRtl ? "بحث سريع…" : "Quick search…")</span>
            <kbd class="syr-omni-kbd">Ctrl+K</kbd>
        </button>

        <div id="syrQuickActions" class="syr-quick-actions"></div>
    </div>

    <div id="syrSidebarScroll" class="syr-sidebar-scroll">
        <nav class="navbar pt-0 flex-column align-items-stretch w-100">
            <div id="navbarnav" class="navbar-nav w-100 px-0">
                <div id="syrPortalNav" class="w-100"></div>
            </div>
        </nav>
    </div>

    <div class="syr-sidebar-footer d-flex align-items-center px-3 py-3 syr-sidebar-user">
        <div class="position-relative flex-shrink-0">
            <img id="AvatarImageSide" class="rounded-circle" src="@avatarUrl" alt="" style="width: 40px; height: 40px;">
            <div class="bg-success rounded-circle border border-2 position-absolute syr-sidebar-online-dot end-0 bottom-0 p-1"></div>
        </div>
        <div class="syr-sidebar-user-meta min-w-0">
            <h6 class="mb-0 small text-truncate syr-sidebar-user-email" id="userEmail">@userEmail</h6>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        try {
            const email = StorageManager.getEmail();
            document.getElementById('userEmail').textContent = email || '';
            const chip = document.getElementById('syrPersonaChip');
            if (chip && typeof StorageManager.getSyriatelOperatorConsoleDisplayName === 'function') {
                const personaLabel = StorageManager.getSyriatelOperatorConsoleDisplayName();
                if (personaLabel) {
                    chip.textContent = personaLabel;
                }
            }
            const brand = document.getElementById('syrBrandHome');
            if (brand && typeof StorageManager.getLandingPath === 'function') {
                const landing = StorageManager.getLandingPath();
                if (landing) brand.setAttribute('href', landing);
            }

            if (typeof PortalNavigation !== 'undefined') {
                PortalNavigation.init();
            }
            if (typeof OmniSearch !== 'undefined') {
                OmniSearch.init();
            }
            if (typeof PortalAdminTools !== 'undefined') {
                PortalAdminTools.init();
            }
        } catch (error) {
            console.error('Sidebar init:', error);
        }
    });
</script>
