<script>

    // Sidebar Toggler
    document.addEventListener('DOMContentLoaded', function() {
        const sidebarToggler = document.querySelector('.sidebar-toggler');
        if (sidebarToggler) {
            sidebarToggler.addEventListener('click', function(event) {
                document.querySelector('.sidebar').classList.toggle("open");
                document.querySelector('.content').classList.toggle("open");
                event.preventDefault();
            });
        }
    });

    var hideSpinnerAndShowContent = () => {
        const spinner = document.getElementById('spinner');
        if (spinner) {
            spinner.classList.remove('show');
        }
    }

    var getDashminFileManagerHeight = () => {
        var headerHeight = document.querySelector('.adminheader').offsetHeight;
        var footerHeight = document.querySelector('.adminfooter').offsetHeight;
        var screenHeight = window.innerHeight;
        var bodyHeight = screenHeight - headerHeight - footerHeight;
        return bodyHeight * 1;
    }

    var getDashminSchedulerHeight = () => {
        var headerHeight = document.querySelector('.adminheader').offsetHeight;
        var footerHeight = document.querySelector('.adminfooter').offsetHeight;
        var screenHeight = window.innerHeight;
        var bodyHeight = screenHeight - headerHeight - footerHeight;
        return bodyHeight * 1;
    }

    var getDashminGridHeight = () => {
        var screenHeight = window.innerHeight;
        var headerHeight = document.querySelector('.adminheader').offsetHeight;
        var footerHeight = document.querySelector('.adminfooter').offsetHeight;
        var gridpager = 60;
        var margin = 10;
        var bodyHeight = screenHeight - headerHeight - footerHeight - (gridpager * 3) - margin;
        return bodyHeight * 1;
    }

    /** Height for telecom grid panels (.telecom-grid-panel .grid-container). */
    var computeTelecomGridHeight = (panelSelector) => {
        var sel = panelSelector || '.telecom-grid-panel';
        var box = document.querySelector(sel + ' .grid-container') || document.querySelector(sel);
        var h = box && box.clientHeight ? box.clientHeight : 0;
        if (h > 120) return h;
        var vh = window.innerHeight || 800;
        return Math.max(300, Math.min(520, vh - 260));
    };

    var getDashminPivotHeight = () => {
        var screenHeight = window.innerHeight;
        var headerHeight = document.querySelector('.adminheader').offsetHeight;
        var footerHeight = document.querySelector('.adminfooter').offsetHeight;
        var gridpager = 5;
        var margin = 5;
        var bodyHeight = screenHeight - headerHeight - footerHeight - (gridpager * 3) - margin;
        return bodyHeight * 1;
    }

    var getDashminBodyHeight = () => {
        var headerHeight = document.querySelector('.adminheader').offsetHeight;
        var footerHeight = document.querySelector('.adminfooter').offsetHeight;
        var screenHeight = window.innerHeight;
        var bodyHeight = screenHeight - headerHeight - footerHeight;
        return bodyHeight * 1;
    }

    var setFormCardHeight = () => {
        var formCard = document.querySelector('.form-card');
        if (!formCard) {
            return;
        }
        if (document.body.classList.contains('syr-tel-portal')) {
            formCard.style.height = '';
            formCard.style.minHeight = '';
            formCard.style.maxHeight = '';
            return;
        }
        if (document.body.classList.contains('syriatel-operator-console')) {
            formCard.style.height = '';
            formCard.style.minHeight = '';
            return;
        }
        var header = document.querySelector('.adminheader');
        var footer = document.querySelector('.adminfooter');
        if (!header || !footer) {
            formCard.style.height = '';
            return;
        }
        var maxHeight = getDashminBodyHeight();
        formCard.style.height = maxHeight + 'px';
    }

    window.addEventListener('load', function () {
        if (typeof hideSpinnerAndShowContent === 'function') {
            hideSpinnerAndShowContent();
        }
        var formcard = document.getElementById('formcard');
        if (formcard) {
            var formcardPosition = sessionStorage.getItem('formcardPosition');
            if (formcardPosition !== null) {
                setTimeout(function () {
                    formcard.scrollTop = parseInt(formcardPosition);
                    sessionStorage.removeItem('formcardPosition');
                }, 1000);
            }
        } else {
            sessionStorage.setItem('formcardPosition', 0);
        }
    });

    window.addEventListener('beforeunload', () => {
        var formcard = document.getElementById('formcard');
        if (formcard) {
            sessionStorage.setItem('formcardPosition', formcard.scrollTop);
        }
    });

</script>

