@page "/Companies/MyCompany"
@{
    ViewData["Title"] = "Operator company";
}

<div id="app" v-cloak>
    <div class="row mb-3">
        <div class="col-12">
            <h1 class="h4 mb-1">Operator company data</h1>
            <p class="text-muted small mb-0">Legal and contact details for the telecom operator tenant.</p>
        </div>
    </div>

    <form class="card shadow-sm" v-on:submit.prevent="handler.save">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-6">
                    <label class="form-label" for="Name">Name</label>
                    <input id="Name" class="form-control" v-model="state.name" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="Currency">Currency</label>
                    <input id="Currency" class="form-control" v-model="state.currency" required />
                </div>
                <div class="col-12">
                    <label class="form-label" for="Description">Description</label>
                    <textarea id="Description" class="form-control" rows="2" v-model="state.description"></textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="Street">Street</label>
                    <input id="Street" class="form-control" v-model="state.street" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="City">City</label>
                    <input id="City" class="form-control" v-model="state.city" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="State">State</label>
                    <input id="State" class="form-control" v-model="state.state" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="ZipCode">Zip</label>
                    <input id="ZipCode" class="form-control" v-model="state.zipCode" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="Country">Country</label>
                    <input id="Country" class="form-control" v-model="state.country" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="PhoneNumber">Phone</label>
                    <input id="PhoneNumber" class="form-control" v-model="state.phoneNumber" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="FaxNumber">Fax</label>
                    <input id="FaxNumber" class="form-control" v-model="state.faxNumber" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="EmailAddress">Email</label>
                    <input id="EmailAddress" type="email" class="form-control" v-model="state.emailAddress" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="Website">Website</label>
                    <input id="Website" class="form-control" v-model="state.website" />
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary" v-bind:disabled="state.isSaving">
                <span v-if="state.isSaving" class="spinner-border spinner-border-sm me-1"></span>
                Save
            </button>
        </div>
    </form>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/Companies/MyCompany.cshtml.js"></script>
}
