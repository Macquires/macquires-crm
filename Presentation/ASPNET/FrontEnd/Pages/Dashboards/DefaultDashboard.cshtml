@page
@{
    ViewData["Title"] = "لوحة التحكم — سوريا تيليكوم";
}

<div class="form-card syr-operator-page telecom-premium-page" id="formcard">
    <div id="telecomOperatorDashSlim" dir="rtl" lang="ar">
        <div class="container-fluid py-3 px-3 px-lg-4 syriatel-dash-slim dash-unified-layout">
            <header class="mb-3">
                <h1 class="h4 fw-semibold text-syriatel-red mb-1">سيريتل — لوحة القيادة</h1>
                <p class="text-muted small mb-0" id="syrBentoSubtitle">جاري التحميل…</p>
            </header>
            <section class="dash-unified-cards" aria-label="مؤشرات التشغيل">
                <div id="syrBentoCockpit" class="syr-bento-grid syr-bento-single-row" data-persona=""></div>
            </section>
            <section id="mis-reports" class="dash-unified-mis d-none mt-4" aria-label="تقارير MIS">
                <div id="misReportsApp" v-cloak class="strategic-exec-root">
                    @await Html.PartialAsync("~/FrontEnd/Pages/Dashboards/_MisReportsEmbed.cshtml")
                </div>
            </section>
            <section id="strategic-analytics" class="dash-unified-strategic d-none mt-4" aria-label="التحليلات الاستراتيجية">
                <div id="strategicAnalyticsApp" v-cloak class="strategic-exec-root">
                    @await Html.PartialAsync("~/FrontEnd/Pages/Dashboards/_StrategicAnalyticsEmbed.cshtml")
                </div>
            </section>
        </div>
    </div>
</div>

@section styles {
    <style>
        .dash-unified-layout { display: flex; flex-direction: column; }
        .dash-unified-cards { width: 100%; margin-bottom: 1.25rem; }
        .syriatel-dash-slim .syr-bento-single-row {
            display: flex;
            flex-direction: row;
            flex-wrap: nowrap;
            align-items: stretch;
            gap: 0.75rem;
            grid-template-columns: unset;
            overflow-x: auto;
            padding-bottom: 0.35rem;
        }
        .syriatel-dash-slim .syr-bento-single-row .syr-bento-card {
            flex: 1 1 0;
            min-width: 11rem;
            grid-column: unset !important;
            min-height: 7.5rem;
        }
        .syriatel-dash-slim .syr-bento-single-row .syr-bento-card .syr-bento-value { font-size: 1.35rem; }
        .dash-unified-strategic,
        .dash-unified-mis { width: 100%; }
        .mis-workload-badge {
            background: var(--sys-bg) !important;
            color: var(--sys-text-main) !important;
            border: 1px solid var(--sys-border);
            font-weight: 500;
        }
        .strategic-exec-root {
            max-width: 100%;
            margin-inline: auto;
            padding: 1.25rem 1rem 2.5rem;
            color: var(--sys-text-main);
            background: var(--sys-bg);
            min-height: 40vh;
            border-radius: var(--sys-radius);
            border: 1px solid var(--sys-border);
        }
        .strategic-exec-hero { border-bottom: 1px solid var(--sys-border); padding-bottom: 1rem; }
        .strategic-exec-kicker {
            font-size: 0.75rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--sys-brand-red);
            font-weight: 600;
        }
        .strategic-exec-sub { color: var(--sys-text-muted); font-size: 0.9rem; }
        .text-gold { color: var(--sys-brand-red) !important; }
        .strategic-filter-bar {
            background: var(--sys-card-bg);
            border: 1px solid var(--sys-border);
            box-shadow: var(--sys-shadow-card);
        }
        .strategic-label { color: var(--sys-text-main); font-size: 0.85rem; font-weight: 500; }
        .strategic-select {
            background: var(--sys-card-bg);
            border-color: var(--sys-border);
            color: var(--sys-text-main);
        }
        .strategic-select:focus {
            border-color: var(--sys-brand-red);
            box-shadow: 0 0 0 0.2rem var(--sys-brand-red-ring);
        }
        .strategic-bento-card {
            background: var(--sys-card-bg);
            border: 1px solid var(--sys-border);
            border-radius: var(--sys-radius);
            padding: 1.25rem 1.5rem;
            box-shadow: var(--sys-shadow-card);
            transition: box-shadow 0.2s ease, border-color 0.2s ease;
        }
        .strategic-bento-card:hover {
            box-shadow: var(--sys-shadow-card-hover);
            border-color: color-mix(in srgb, var(--sys-brand-red) 25%, var(--sys-border));
        }
        .strategic-card-title {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--sys-text-muted);
            margin-bottom: 0.75rem;
            font-weight: 600;
        }
        .strategic-metric-xl { font-size: 2rem; font-weight: 700; color: var(--sys-text-main); }
        .strategic-metric-lg { font-size: 1.5rem; font-weight: 600; color: var(--sys-text-main); }
        .strategic-metric-unit { font-size: 0.9rem; color: var(--sys-text-muted); font-weight: 400; }
        .strategic-metric-sub { font-size: 0.85rem; color: var(--sys-text-muted); }
        .strategic-delta { font-size: 0.85rem; font-weight: 600; }
        .strategic-delta-up { color: #15803d; }
        .strategic-delta-down { color: #dc2626; }
        .strategic-panel {
            background: var(--sys-card-bg);
            border: 1px solid var(--sys-border);
            border-radius: var(--sys-radius);
            box-shadow: var(--sys-shadow-card);
        }
        .strategic-panel-title { font-size: 0.95rem; font-weight: 600; color: var(--sys-text-main); }
        .strategic-badge-level {
            background: color-mix(in srgb, var(--sys-brand-red) 10%, var(--sys-card-bg));
            color: var(--sys-brand-red);
            border: 1px solid color-mix(in srgb, var(--sys-brand-red) 35%, var(--sys-border));
            font-weight: 500;
        }
        .btn-strategic-gold {
            background: var(--sys-brand-red);
            border: none;
            color: #fff;
            font-weight: 600;
        }
        .btn-strategic-gold:hover {
            background: var(--sys-brand-red-hover);
            color: #fff;
        }
        .btn-strategic-gold:disabled {
            opacity: 0.65;
        }
        #ExecutiveLeaderboardGrid .e-grid { background: transparent; border-color: var(--sys-border); }
        #ExecutiveLeaderboardGrid .e-headercell {
            background: var(--sys-bg) !important;
            color: var(--sys-brand-red) !important;
            font-weight: 600;
        }
        #ExecutiveLeaderboardGrid .e-rowcell {
            color: var(--sys-text-main);
            background: var(--sys-card-bg);
        }
        #ExecutiveLeaderboardGrid .e-altrow .e-rowcell { background: var(--sys-bg); }
        .syriatel-dash-slim .syr-bento-cta {
            background: var(--sys-brand-red);
            color: #fff;
        }
        .syriatel-dash-slim .syr-bento-cta:hover {
            background: var(--sys-brand-red-hover);
            color: #fff;
        }
    </style>
}

@section scripts {
    <script src="~/lib/indotalent/syr-bento-cockpit.js" asp-append-version="true"></script>
    <script src="~/lib/indotalent/mis-reports-panel.js" asp-append-version="true"></script>
    <script src="~/lib/indotalent/strategic-analytics-panel.js" asp-append-version="true"></script>
    <script src="~/FrontEnd/Pages/Dashboards/DefaultDashboard.cshtml.js" asp-append-version="true"></script>
}
