@page
@{
    ViewData["Title"] = "Product List";
}

@{ ViewData["PortalPageVcloak"] = true; }
@await Html.PartialAsync("~/FrontEnd/Pages/Shared/AdminTemplate/_PortalPageShell.cshtml")

    <div class="row">
        <div class="col-12">
            <div class="grid-container">
                <div ref="mainGridRef"></div>
            </div>
        </div>
    </div>

    <div class="modal fade" ref="mainModalRef" id="MainModal" aria-hidden="true" tabindex="-1" data-bs-focus="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ state.mainTitle }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" v-model="state.id" id="Id" name="Id" />
                    <form id="MainForm">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5><span data-mcq-i18n="mainInfo"></span></h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="Name"><span data-mcq-i18n="fld_name">Name</span></label>
                                                <input ref="nameRef" v-model="state.name">
                                                <label class="text-danger">{{ state.errors.name }}</label>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="Number"><span data-mcq-i18n="field_number">Number</span></label>
                                                <input ref="numberRef" v-model="state.number" readonly>
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="UnitPrice"><span data-mcq-i18n="fld_unit_price">Unit Price</span></label>
                                                <input ref="unitPriceRef" v-model="state.unitPrice">
                                                <label class="text-danger">{{ state.errors.unitPrice }}</label>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="UnitMeasureId"><span data-mcq-i18n="fld_unit_measure_id">Unit Measure</span></label>
                                                <div ref="unitMeasureIdRef"></div>
                                                <label class="text-danger">{{ state.errors.unitMeasureId }}</label>
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="ProductGroupId"><span data-mcq-i18n="fld_product_group_id">Product Group</span></label>
                                                <div ref="productGroupIdRef"></div>
                                                <label class="text-danger">{{ state.errors.productGroupId }}</label>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="CompatibleSubscriptionTypeId"><span>نوع الخط المتوافق</span></label>
                                                <div ref="compatibleSubscriptionTypeIdRef"></div>
                                                <small class="text-muted d-block">اتركه «أي نوع» إذا المنتج ينطبق على كل أنواع الخطوط.</small>
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <div class="form-check mt-4">
                                                    <input v-model="state.physical" id="Physical" name="Physical" type="checkbox" class="form-check-input">
                                                    <label for="Physical" class="form-check-label">Is Physical Product?</label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-12">
                                                <label for="Description"><span data-mcq-i18n="field_description">Description</span></label>
                                                <textarea v-model="state.description" id="Description" name="Description" class="form-control" rows="3"></textarea>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><span v-text="$mcqFooter.close"></span></button>
                    <button type="button"
                            id="MainSaveButton"
                            class="btn"
                            v-bind:class="state.deleteMode ? 'btn-danger' : 'btn-primary'"
                            v-on:click="handler.handleSubmit"
                            v-bind:disabled="state.isSubmitting">
                        <span class="spinner-border spinner-border-sm me-2" v-if="state.isSubmitting" role="status" aria-hidden="true"></span>
                        <span v-show="!state.isSubmitting && !state.deleteMode" v-text="$mcqFooter.save"></span>
                        <span v-show="!state.isSubmitting && state.deleteMode" v-text="$mcqFooter.del"></span>
                        <span v-show="state.isSubmitting && !state.deleteMode" v-text="$mcqFooter.saving"></span>
                        <span v-show="state.isSubmitting && state.deleteMode" v-text="$mcqFooter.deleting"></span>
                    </button>
                </div>
            </div>
        </div>
    </div>
@await Html.PartialAsync("~/FrontEnd/Pages/Shared/AdminTemplate/_PortalPageShellEnd.cshtml")

@section scripts {
    <script src="~/FrontEnd/Pages/Products/ProductList.cshtml.js"></script>
}