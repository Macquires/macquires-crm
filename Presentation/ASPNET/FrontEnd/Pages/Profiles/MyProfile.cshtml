@page "/Profiles/MyProfile"
@{
    ViewData["Title"] = "My Profile";
}

<div id="app" v-cloak>
    <div class="row mb-3">
        <div class="col-12">
            <h1 class="h4 mb-1">My Profile</h1>
            <p class="text-muted small mb-0">Account details, password, and avatar.</p>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header">Avatar</div>
                <div class="card-body text-center">
                    <img :src="state.avatarPreview" alt="" class="rounded-circle mb-3" style="width: 96px; height: 96px; object-fit: cover;" />
                    <input type="file" class="form-control form-control-sm" accept="image/*" v-on:change="handler.onAvatarSelected" />
                    <button type="button" class="btn btn-outline-primary btn-sm mt-2 w-100" v-bind:disabled="state.isUploadingAvatar" v-on:click="handler.uploadAvatar">
                        <span v-if="state.isUploadingAvatar" class="spinner-border spinner-border-sm me-1"></span>
                        Upload
                    </button>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <form class="card shadow-sm mb-3" v-on:submit.prevent="handler.saveProfile">
                <div class="card-header">Basic info</div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label" for="FirstName">First name</label>
                            <input id="FirstName" class="form-control" v-model="state.firstName" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="LastName">Last name</label>
                            <input id="LastName" class="form-control" v-model="state.lastName" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="CompanyName">Company name</label>
                            <input id="CompanyName" class="form-control" v-model="state.companyName" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Email</label>
                            <input class="form-control" v-model="state.email" readonly />
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary" v-bind:disabled="state.isSavingProfile">
                        <span v-if="state.isSavingProfile" class="spinner-border spinner-border-sm me-1"></span>
                        Save
                    </button>
                </div>
            </form>

            <form class="card shadow-sm" v-on:submit.prevent="handler.changePassword">
                <div class="card-header">Change password</div>
                <div class="card-body">
                    <div class="mb-2">
                        <label class="form-label" for="OldPassword">Current password</label>
                        <input id="OldPassword" type="password" class="form-control" v-model="state.oldPassword" autocomplete="current-password" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="NewPassword">New password</label>
                        <input id="NewPassword" type="password" class="form-control" v-model="state.newPassword" autocomplete="new-password" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="ConfirmPassword">Confirm password</label>
                        <input id="ConfirmPassword" type="password" class="form-control" v-model="state.confirmPassword" autocomplete="new-password" />
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-outline-danger" v-bind:disabled="state.isSavingPassword">
                        <span v-if="state.isSavingPassword" class="spinner-border spinner-border-sm me-1"></span>
                        Update password
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/Profiles/MyProfile.cshtml.js"></script>
}
