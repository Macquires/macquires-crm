@page "/Administration/BranchList"
@{
    ViewData["Title"] = "إدارة الفروع";
}

<div id="app" v-cloak>
    <div class="row mb-2">
        <div class="col-12">
            <p class="text-muted small mb-0">
                هيكل الفروع والوحدات التنظيمية — تعيين مدير كل فرع وربط الموظفين من
                <a href="/Administration/UserList">إدارة المستخدمين</a>.
                <a href="/Administration">← الإدارة والنظام</a>
            </p>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="grid-container">
                <div ref="mainGridRef"></div>
            </div>
        </div>
    </div>

    <div class="modal fade" ref="mainModalRef" id="BranchModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" v-text="state.mainTitle"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="BranchForm">
                        <div class="row mb-2">
                            <div class="col-md-6">
                                <label class="form-label" for="NameAr">اسم الفرع (عربي)</label>
                                <input id="NameAr" class="form-control" v-model="state.nameAr" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="NameEn">الاسم (إنجليزي)</label>
                                <input id="NameEn" class="form-control" v-model="state.nameEn" />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-md-6">
                                <label class="form-label" for="ParentId">الوحدة الأب</label>
                                <select id="ParentId" class="form-select" v-model="state.parentId">
                                    <option value="">— بدون (مستوى أعلى) —</option>
                                    <option v-for="o in parentOptions" :key="o.id" :value="o.id">{{ o.nameAr }}</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="ManagerUserId">مدير الفرع</label>
                                <select id="ManagerUserId" class="form-select" v-model="state.managerUserId">
                                    <option value="">— بدون —</option>
                                    <option v-for="m in state.managerOptions" :key="m.id" :value="m.id">{{ m.label }}</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="IsActive" v-model="state.isActive" />
                            <label class="form-check-label" for="IsActive">فرع نشط</label>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
                    <button type="button" class="btn btn-primary" v-on:click="handler.handleSubmit" v-bind:disabled="state.isSubmitting">
                        <span class="spinner-border spinner-border-sm me-2" v-if="state.isSubmitting"></span>
                        حفظ
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/Administration/BranchList.cshtml.js"></script>
}
