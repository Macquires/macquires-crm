@page "/Administration/AuditLogList"
@{
    ViewData["Title"] = "سجل الرقابة";
}

@{ ViewData["PortalPageVcloak"] = true; }
@await Html.PartialAsync("~/FrontEnd/Pages/Shared/AdminTemplate/_PortalPageShell.cshtml")

    <div class="row mb-2">
        <div class="col-12">
            <p class="text-muted small mb-0">
                <span data-telecom-i18n="administration.auditLog.subtitle">الصندوق الأسود — من فعل ماذا؟ ومتى؟ ومن أي جهاز؟</span>
                <a href="/Administration" class="ms-1" data-telecom-i18n="administration.auditLog.backLink">← الإدارة والنظام</a>
            </p>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label" for="ActionType" data-telecom-i18n="administration.auditLog.filters.actionType">نوع العملية</label>
                    <select id="ActionType" class="form-select" v-model="state.filters.actionType">
                        <option value="" data-telecom-i18n="administration.auditLog.filters.allActions">— الكل —</option>
                        <option v-for="opt in state.actionOptions" v-bind:key="opt.value" v-bind:value="opt.value" v-text="opt.label"></option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="UserId" data-telecom-i18n="administration.auditLog.filters.userId">معرّف المستخدم (هدف)</label>
                    <input id="UserId" class="form-control font-monospace" v-model="state.filters.userId" data-telecom-i18n-placeholder="administration.auditLog.filters.userIdPlaceholder" placeholder="اختياري" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="FromDate" data-telecom-i18n="administration.auditLog.filters.fromDate">من تاريخ</label>
                    <input id="FromDate" type="date" class="form-control" v-model="state.filters.fromDate" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="ToDate" data-telecom-i18n="administration.auditLog.filters.toDate">إلى تاريخ</label>
                    <input id="ToDate" type="date" class="form-control" v-model="state.filters.toDate" />
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-primary w-100" v-on:click="handler.search">
                        <i class="bi bi-search me-1"></i>
                        <span data-telecom-i18n="administration.auditLog.filters.search">بحث</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="grid-container">
                <div ref="mainGridRef"></div>
            </div>
            <p class="small text-muted mt-2" v-if="state.totalCount > 0">
                <span data-telecom-i18n="administration.auditLog.totalRecords">إجمالي السجلات</span>:
                <strong v-text="state.totalCount"></strong>
                <span class="ms-2" data-telecom-i18n="administration.auditLog.doubleClickHint">(انقر مرتين لعرض التفاصيل)</span>
            </p>
        </div>
    </div>
@await Html.PartialAsync("~/FrontEnd/Pages/Shared/AdminTemplate/_PortalPageShellEnd.cshtml")

@section styles {
    <link rel="stylesheet" href="~/css/audit-detail-modal.css" asp-append-version="true" />
}

@section scripts {
    <script src="~/lib/indotalent/audit-detail-modal.js" asp-append-version="true"></script>
    <script src="~/FrontEnd/Pages/Administration/AuditLogList.cshtml.js" asp-append-version="true"></script>
}
