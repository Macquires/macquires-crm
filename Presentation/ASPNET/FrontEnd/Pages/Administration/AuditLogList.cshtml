@page "/Administration/AuditLogList"
@{
    ViewData["Title"] = "سجل الرقابة";
}

<div id="app" v-cloak>
    <div class="row mb-2">
        <div class="col-12">
            <p class="text-muted small mb-0">
                الصندوق الأسود — من فعل ماذا؟ ومتى؟ ومن أي جهاز؟
                <a href="/Administration">← الإدارة والنظام</a>
            </p>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label" for="ActionType">نوع العملية</label>
                    <select id="ActionType" class="form-select" v-model="state.filters.actionType">
                        <option value="">— الكل —</option>
                        <option v-for="opt in state.actionOptions" v-bind:key="opt.value" v-bind:value="opt.value" v-text="opt.label"></option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="UserId">معرّف المستخدم (هدف)</label>
                    <input id="UserId" class="form-control font-monospace" v-model="state.filters.userId" placeholder="اختياري" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="FromDate">من تاريخ</label>
                    <input id="FromDate" type="date" class="form-control" v-model="state.filters.fromDate" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="ToDate">إلى تاريخ</label>
                    <input id="ToDate" type="date" class="form-control" v-model="state.filters.toDate" />
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-primary w-100" v-on:click="handler.search">
                        <i class="bi bi-search me-1"></i> بحث
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="grid-container">
                <div ref="mainGridRef"></div>
            </div>
            <p class="small text-muted mt-2" v-if="state.totalCount > 0">
                إجمالي السجلات: <strong v-text="state.totalCount"></strong>
            </p>
        </div>
    </div>
</div>

@section styles {
    <link rel="stylesheet" href="~/css/audit-detail-modal.css" asp-append-version="true" />
}

@section scripts {
    <script src="~/lib/indotalent/audit-detail-modal.js" asp-append-version="true"></script>
    <script src="~/FrontEnd/Pages/Administration/AuditLogList.cshtml.js" asp-append-version="true"></script>
}
