@page "/Administration"
@{
    ViewData["Title"] = "الإدارة والنظام";
}

@{ ViewData["PortalPageVcloak"] = true; }
@await Html.PartialAsync("~/FrontEnd/Pages/Shared/AdminTemplate/_PortalPageShell.cshtml")

    <div class="telecom-bento-card mb-3">
        <div class="card-body py-3">
            <h1 class="h4 mb-1">{{ t('pageTitle') }}</h1>
            <p class="text-muted mb-0">{{ t('subtitle') }}</p>
        </div>
    </div>
    <div class="list-group list-group-flush shadow-sm rounded-3 administration-hub-list">
        <a
            v-for="item in hubLinks"
            :key="item.href"
            class="list-group-item list-group-item-action d-flex align-items-center gap-2"
            :href="item.href">
            <i class="bi text-primary" :class="item.icon"></i>
            <span>{{ item.label }}</span>
        </a>
    </div>
@await Html.PartialAsync("~/FrontEnd/Pages/Shared/AdminTemplate/_PortalPageShellEnd.cshtml")

@section scripts {
    <script src="~/FrontEnd/Pages/Administration/Index.cshtml.js" asp-append-version="true"></script>
}
