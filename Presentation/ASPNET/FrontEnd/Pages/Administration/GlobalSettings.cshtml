                    </div>
                </div>
            </div>
            <h3 class="h6 fw-bold mb-2">{{ t('telecom.operations.deviceSalesSection') }}</h3>
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">{{ t('telecom.operations.creditLow') }}</label>
                    <input type="number" class="form-control" min="300" max="900" v-model.number="state.settings.telecom.deviceSales.creditScoreLowThreshold" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">{{ t('telecom.operations.creditGood') }}</label>
                    <input type="number" class="form-control" min="300" max="900" v-model.number="state.settings.telecom.deviceSales.creditScoreGoodThreshold" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">{{ t('telecom.operations.dpReject') }}</label>
                    <input type="number" class="form-control" min="0" max="100" v-model.number="state.settings.telecom.deviceSales.downPaymentPercentReject" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">{{ t('telecom.operations.dpVip') }}</label>
                    <input type="number" class="form-control" min="0" max="100" v-model.number="state.settings.telecom.deviceSales.downPaymentPercentVip" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">{{ t('telecom.operations.dpLow') }}</label>
                    <input type="number" class="form-control" min="0" max="100" v-model.number="state.settings.telecom.deviceSales.downPaymentPercentLow" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">{{ t('telecom.operations.dpGood') }}</label>
                    <input type="number" class="form-control" min="0" max="100" v-model.number="state.settings.telecom.deviceSales.downPaymentPercentGood" />
