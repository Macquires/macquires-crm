                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="SimLostStolenBo" v-model="state.settings.telecom.simSwap.lostStolenRequiresBackOffice" />
                        <label class="form-check-label" for="SimLostStolenBo">{{ t('telecom.operations.simLostStolenBo') }}</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="CnrBlockQuarantine" v-model="state.settings.telecom.changeNumber.blockQuarantinedTarget" />
                        <label class="form-check-label" for="CnrBlockQuarantine">{{ t('telecom.operations.cnrBlockQuarantine') }}</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="TkoAlwaysBo" v-model="state.settings.telecom.takeOver.alwaysRequiresBackOffice" />
