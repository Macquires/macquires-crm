        <div class="card-footer global-settings-tab-save d-flex justify-content-end">
            <button type="button" class="btn btn-telecom-primary" v-on:click="handler.saveTab('telecom-operations')" v-bind:disabled="state.savingTab === 'telecom-operations'">
                <span class="spinner-border spinner-border-sm me-2" v-if="state.savingTab === 'telecom-operations'"></span>
                {{ t('saveTab') }}
            </button>
        </div>
    </div>

    <!-- City modal -->
    <div class="modal fade" ref="cityModalRef" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" v-text="cityState.mainTitle"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-2">
                        <div class="col-md-6">
                            <label>{{ t('cities.fieldName') }} <span class="text-danger">*</span></label>
                            <input class="form-control" v-model="cityState.name" maxlength="255" />
                            <label class="text-danger small" v-text="cityState.errors.name"></label>
                        </div>
                        <div class="col-md-6">
                            <label>{{ t('cities.fieldGovernorate') }} <span class="text-danger">*</span></label>
                            <input class="form-control" v-model="cityState.governorate" maxlength="255" />
                            <label class="text-danger small" v-text="cityState.errors.governorate"></label>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-4">
                            <label>{{ t('cities.fieldSort') }}</label>
                            <input type="number" class="form-control" v-model.number="cityState.sortOrder" min="0" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="CityIsActive" v-model="cityState.isActive" />
                                <label class="form-check-label" for="CityIsActive">{{ t('cities.fieldActive') }}</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ t('close') }}</button>
                    <button type="button" class="btn" v-bind:class="cityState.deleteMode ? 'btn-danger' : 'btn-primary'" v-on:click="cityHandler.handleSubmit" v-bind:disabled="cityState.isSubmitting">
                        <span class="spinner-border spinner-border-sm me-2" v-if="cityState.isSubmitting"></span>
                        <span v-if="cityState.deleteMode">{{ t('cities.confirmDelete') }}</span>
                        <span v-else>{{ t('saveTab') }}</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
@await Html.PartialAsync("~/FrontEnd/Pages/Shared/AdminTemplate/_PortalPageShellEnd.cshtml")

