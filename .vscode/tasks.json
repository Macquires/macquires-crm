{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "network-simulator",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/tools/NetworkSimulator/NetworkSimulator.csproj"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "network-simulator",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Now listening on:"
        }
      }
    }
  ]
}
